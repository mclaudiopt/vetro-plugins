,8,\"flag: Cayman Islands\",\"bandeira: Ilhas Cayman\",\"KY\"],[\"🇰🇿\",8,\"flag: Kazakhstan\",\"bandeira: Cazaquistão\",\"KZ\"],[\"🇱🇦\",8,\"flag: Laos\",\"bandeira: Laos\",\"\"],[\"🇱🇧\",8,\"flag: Lebanon\",\"bandeira: Líbano\",\"LB\"],[\"🇱🇨\",8,\"flag: St. Lucia\",\"bandeira: Santa Lúcia\",\"LC\"],[\"🇱🇮\",8,\"flag: Liechtenstein\",\"bandeira: Liechtenstein\",\"\"],[\"🇱🇰\",8,\"flag: Sri Lanka\",\"bandeira: Sri Lanka\",\"LK\"],[\"🇱🇷\",8,\"flag: Liberia\",\"bandeira: Libéria\",\"LR\"],[\"🇱🇸\",8,\"flag: Lesotho\",\"bandeira: Lesoto\",\"LS\"],[\"🇱🇹\",8,\"flag: Lithuania\",\"bandeira: Lituânia\",\"LT\"],[\"🇱🇺\",8,\"flag: Luxembourg\",\"bandeira: Luxemburgo\",\"\"],[\"🇱🇻\",8,\"flag: Latvia\",\"bandeira: Letônia\",\"LV\"],[\"🇱🇾\",8,\"flag: Libya\",\"bandeira: Líbia\",\"LY\"],[\"🇲🇦\",8,\"flag: Morocco\",\"bandeira: Marrocos\",\"MA\"],[\"🇲🇨\",8,\"flag: Monaco\",\"bandeira: Mônaco\",\"MC\"],[\"🇲🇩\",8,\"flag: Moldova\",\"bandeira: Moldávia\",\"MD\"],[\"🇲🇪\",8,\"flag: Montenegro\",\"bandeira: Montenegro\",\"ME\"],[\"🇲🇫\",8,\"flag: St. Martin\",\"bandeira: São Martinho\",\"MF\"],[\"🇲🇬\",8,\"flag: Madagascar\",\"bandeira: Madagascar\",\"MG\"],[\"🇲🇭\",8,\"flag: Marshall Islands\",\"bandeira: Ilhas Marshall\",\"MH\"],[\"🇲🇰\",8,\"flag: North Macedonia\",\"bandeira: Macedônia do Norte\",\"MK\"],[\"🇲🇱\",8,\"flag: Mali\",\"bandeira: Mali\",\"ML\"],[\"🇲🇲\",8,\"flag: Myanmar (Burma)\",\"bandeira: Mianmar (Birmânia)\",\"MM\"],[\"🇲🇳\",8,\"flag: Mongolia\",\"bandeira: Mongólia\",\"MN\"],[\"🇲🇴\",8,\"flag: Macao SAR China\",\"bandeira: Macau, RAE da China\",\"MO\"],[\"🇲🇵\",8,\"flag: Northern Mariana Islands\",\"bandeira: Ilhas Marianas do Norte\",\"MP\"],[\"🇲🇶\",8,\"flag: Martinique\",\"bandeira: Martinica\",\"MQ\"],[\"🇲🇷\",8,\"flag: Mauritania\",\"bandeira: Mauritânia\",\"MR\"],[\"🇲🇸\",8,\"flag: Montserrat\",\"bandeira: Montserrat\",\"MS\"],[\"🇲🇹\",8,\"flag: Malta\",\"bandeira: Malta\",\"MT\"],[\"🇲🇺\",8,\"flag: Mauritius\",\"bandeira: Maurício\",\"MU\"],[\"🇲🇻\",8,\"flag: Maldives\",\"bandeira: Maldivas\",\"MV\"],[\"🇲🇼\",8,\"flag: Malawi\",\"bandeira: Malaui\",\"MW\"],[\"🇲🇽\",8,\"flag: Mexico\",\"bandeira: México\",\"MX\"],[\"🇲🇾\",8,\"flag: Malaysia\",\"bandeira: Malásia\",\"MY\"],[\"🇲🇿\",8,\"flag: Mozambique\",\"bandeira: Moçambique\",\"MZ\"],[\"🇳🇦\",8,\"flag: Namibia\",\"bandeira: Namíbia\",\"\"],[\"🇳🇨\",8,\"flag: New Caledonia\",\"bandeira: Nova Caledônia\",\"NC\"],[\"🇳🇪\",8,\"flag: Niger\",\"bandeira: Níger\",\"NE\"],[\"🇳🇫\",8,\"flag: Norfolk Island\",\"bandeira: Ilha Norfolk\",\"NF\"],[\"🇳🇬\",8,\"flag: Nigeria\",\"bandeira: Nigéria\",\"NG\"],[\"🇳🇮\",8,\"flag: Nicaragua\",\"bandeira: Nicarágua\",\"\"],[\"🇳🇱\",8,\"flag: Netherlands\",\"bandeira: Países Baixos\",\"NL\"],[\"🇳🇴\",8,\"flag: Norway\",\"bandeira: Noruega\",\"\"],[\"🇳🇵\",8,\"flag: Nepal\",\"bandeira: Nepal\",\"NP\"],[\"🇳🇷\",8,\"flag: Nauru\",\"bandeira: Nauru\",\"NR\"],[\"🇳🇺\",8,\"flag: Niue\",\"bandeira: Niue\",\"NU\"],[\"🇳🇿\",8,\"flag: New Zealand\",\"bandeira: Nova Zelândia\",\"NZ\"],[\"🇴🇲\",8,\"flag: Oman\",\"bandeira: Omã\",\"\"],[\"🇵🇦\",8,\"flag: Panama\",\"bandeira: Panamá\",\"\"],[\"🇵🇪\",8,\"flag: Peru\",\"bandeira: Peru\",\"\"],[\"🇵🇫\",8,\"flag: French Polynesia\",\"bandeira: Polinésia Francesa\",\"PF\"],[\"🇵🇬\",8,\"flag: Papua New Guinea\",\"bandeira: Papua-Nova Guiné\",\"PG\"],[\"🇵🇭\",8,\"flag: Philippines\",\"bandeira: Filipinas\",\"\"],[\"🇵🇰\",8,\"flag: Pakistan\",\"bandeira: Paquistão\",\"PK\"],[\"🇵🇱\",8,\"flag: Poland\",\"bandeira: Polônia\",\"PL\"],[\"🇵🇲\",8,\"flag: St. Pierre & Miquelon\",\"bandeira: São Pedro e Miquelão\",\"PM\"],[\"🇵🇳\",8,\"flag: Pitcairn Islands\",\"bandeira: Ilhas Pitcairn\",\"PN\"],[\"🇵🇷\",8,\"flag: Puerto Rico\",\"bandeira: Porto Rico\",\"PR\"],[\"🇵🇸\",8,\"flag: Palestinian Territories\",\"bandeira: Territórios palestinos\",\"PS\"],[\"🇵🇹\",8,\"flag: Portugal\",\"bandeira: Portugal\",\"PT\"],[\"🇵🇼\",8,\"flag: Palau\",\"bandeira: Palau\",\"PW\"],[\"🇵🇾\",8,\"flag: Paraguay\",\"bandeira: Paraguai\",\"PY\"],[\"🇶🇦\",8,\"flag: Qatar\",\"bandeira: Catar\",\"\"],[\"🇷🇪\",8,\"flag: Réunion\",\"bandeira: Reunião\",\"RE\"],[\"🇷🇴\",8,\"flag: Romania\",\"bandeira: Romênia\",\"\"],[\"🇷🇸\",8,\"flag: Serbia\",\"bandeira: Sérvia\",\"RS\"],[\"🇷🇺\",8,\"flag: Russia\",\"bandeira: Rússia\",\"\"],[\"🇷🇼\",8,\"flag: Rwanda\",\"bandeira: Ruanda\",\"\"],[\"🇸🇦\",8,\"flag: Saudi Arabia\",\"bandeira: Arábia Saudita\",\"\"],[\"🇸🇧\",8,\"flag: Solomon Islands\",\"bandeira: Ilhas Salomão\",\"SB\"],[\"🇸🇨\",8,\"flag: Seychelles\",\"bandeira: Seicheles\",\"SC\"],[\"🇸🇩\",8,\"flag: Sudan\",\"bandeira: Sudão\",\"SD\"],[\"🇸🇪\",8,\"flag: Sweden\",\"bandeira: Suécia\",\"SE\"],[\"🇸🇬\",8,\"flag: Singapore\",\"bandeira: Singapura\",\"SG\"],[\"🇸🇭\",8,\"flag: St. Helena, Ascension & Tristan da Cunha\",\"bandeira: Santa Helena\",\"SH\"],[\"🇸🇮\",8,\"flag: Slovenia\",\"bandeira: Eslovênia\",\"SI\"],[\"🇸🇯\",8,\"flag: Svalbard & Jan Mayen\",\"bandeira: Svalbard e Jan Mayen\",\"SJ\"],[\"🇸🇰\",8,\"flag: Slovakia\",\"bandeira: Eslováquia\",\"SK\"],[\"🇸🇱\",8,\"flag: Sierra Leone\",\"bandeira: Serra Leoa\",\"SL\"],[\"🇸🇲\",8,\"flag: San Marino\",\"bandeira: San Marino\",\"SM\"],[\"🇸🇳\",8,\"flag: Senegal\",\"bandeira: Senegal\",\"SN\"],[\"🇸🇴\",8,\"flag: Somalia\",\"bandeira: Somália\",\"\"],[\"🇸🇷\",8,\"flag: Suriname\",\"bandeira: Suriname\",\"SR\"],[\"🇸🇸\",8,\"flag: South Sudan\",\"bandeira: Sudão do Sul\",\"SS\"],[\"🇸🇹\",8,\"flag: São Tomé & Príncipe\",\"bandeira: São Tomé e Príncipe\",\"ST\"],[\"🇸🇻\",8,\"flag: El Salvador\",\"bandeira: El Salvador\",\"SV\"],[\"🇸🇽\",8,\"flag: Sint Maarten\",\"bandeira: Sint Maarten\",\"SX\"],[\"🇸🇾\",8,\"flag: Syria\",\"bandeira: Síria\",\"\"],[\"🇸🇿\",8,\"flag: Eswatini\",\"bandeira: Essuatíni\",\"SZ\"],[\"🇹🇦\",8,\"flag: Tristan da Cunha\",\"bandeira: Tristão da Cunha\",\"\"],[\"🇹🇨\",8,\"flag: Turks & Caicos Islands\",\"bandeira: Ilhas Turcas e Caicos\",\"TC\"],[\"🇹🇩\",8,\"flag: Chad\",\"bandeira: Chade\",\"TD\"],[\"🇹🇫\",8,\"flag: French Southern and Antarctic Lands\",\"bandeira: Territórios Franceses do Sul\",\"TF\"],[\"🇹🇬\",8,\"flag: Togo\",\"bandeira: Togo\",\"TG\"],[\"🇹🇭\",8,\"flag: Thailand\",\"bandeira: Tailândia\",\"\"],[\"🇹🇯\",8,\"flag: Tajikistan\",\"bandeira: Tadjiquistão\",\"TJ\"],[\"🇹🇰\",8,\"flag: Tokelau\",\"bandeira: Tokelau\",\"TK\"],[\"🇹🇱\",8,\"flag: Timor-Leste\",\"bandeira: Timor-Leste\",\"TL\"],[\"🇹🇲\",8,\"flag: Turkmenistan\",\"bandeira: Turcomenistão\",\"TM\"],[\"🇹🇳\",8,\"flag: Tunisia\",\"bandeira: Tunísia\",\"TN\"],[\"🇹🇴\",8,\"flag: Tonga\",\"bandeira: Tonga\",\"\"],[\"🇹🇷\",8,\"flag: Türkiye\",\"bandeira: Turquia\",\"TR\"],[\"🇹🇹\",8,\"flag: Trinidad & Tobago\",\"bandeira: Trinidad e Tobago\",\"TT\"],[\"🇹🇻\",8,\"flag: Tuvalu\",\"bandeira: Tuvalu\",\"TV\"],[\"🇹🇼\",8,\"flag: Taiwan\",\"bandeira: Taiwan\",\"TW\"],[\"🇹🇿\",8,\"flag: Tanzania\",\"bandeira: Tanzânia\",\"TZ\"],[\"🇺🇦\",8,\"flag: Ukraine\",\"bandeira: Ucrânia\",\"UA\"],[\"🇺🇬\",8,\"flag: Uganda\",\"bandeira: Uganda\",\"\"],[\"🇺🇲\",8,\"flag: U.S. Outlying Islands\",\"bandeira: Ilhas Menores Distantes dos EUA\",\"UM\"],[\"🇺🇳\",8,\"flag: United Nations\",\"bandeira: Nações Unidas\",\"\"],[\"🇺🇸\",8,\"flag: United States\",\"bandeira: Estados Unidos\",\"US\"],[\"🇺🇾\",8,\"flag: Uruguay\",\"bandeira: Uruguai\",\"UY\"],[\"🇺🇿\",8,\"flag: Uzbekistan\",\"bandeira: Uzbequistão\",\"\"],[\"🇻🇦\",8,\"flag: Vatican City\",\"bandeira: Cidade do Vaticano\",\"\"],[\"🇻🇨\",8,\"flag: St. Vincent & Grenadines\",\"bandeira: São Vicente e Granadinas\",\"VC\"],[\"🇻🇪\",8,\"flag: Venezuela\",\"bandeira: Venezuela\",\"\"],[\"🇻🇬\",8,\"flag: British Virgin Islands\",\"bandeira: Ilhas Virgens Britânicas\",\"VG\"],[\"🇻🇮\",8,\"flag: U.S. Virgin Islands\",\"bandeira: Ilhas Virgens Americanas\",\"\"],[\"🇻🇳\",8,\"flag: Vietnam\",\"bandeira: Vietnã\",\"VN\"],[\"🇻🇺\",8,\"flag: Vanuatu\",\"bandeira: Vanuatu\",\"VU\"],[\"🇼🇫\",8,\"flag: Wallis & Futuna\",\"bandeira: Wallis e Futuna\",\"WF\"],[\"🇼🇸\",8,\"flag: Samoa\",\"bandeira: Samoa\",\"WS\"],[\"🇽🇰\",8,\"flag: Kosovo\",\"bandeira: Kosovo\",\"XK\"],[\"🇾🇪\",8,\"flag: Yemen\",\"bandeira: Iêmen\",\"\"],[\"🇾🇹\",8,\"flag: Mayotte\",\"bandeira: Mayotte\",\"YT\"],[\"🇿🇦\",8,\"flag: South Africa\",\"bandeira: África do Sul\",\"ZA\"],[\"🇿🇲\",8,\"flag: Zambia\",\"bandeira: Zâmbia\",\"ZM\"],[\"🇿🇼\",8,\"flag: Zimbabwe\",\"bandeira: Zimbábue\",\"ZW\"]]}","index.js":"'use strict';\n// Notification Center: queue notifications from any device on the LAN and show them as native TV banners\n// through a small companion web app (see README). It talks to Vetro on 127.0.0.1:8099 (to launch that app); the one other thing it does on the\n// network is to fetch an http(s) image URL when a sender gives an `image`, `image2` or `wallpaper` (at most 2 at a time, 10 s each, 3 MB).\n// Everything that arrives from the LAN is untrusted JSON: values are type-checked (str/num/has from rules.js) before they are used.\n// Plain ES5: older TVs run Node 4.4.\nvar fs = require('fs');\nvar path = require('path');\nvar http = require('http');\nvar https = require('https');\nvar urlmod = require('url');\nvar os = require('os');\nvar rules = require('./rules.js');\n\nvar MAX_HOOK_BODY = 65536;\n// The tunes: [milliseconds from the start, sound]. We Will Rock You: stomp, stomp, clap (81 beats per minute). Beethoven's 5th: short, short, short, LONG (twice, then again).\nvar SONGS = { rock: { title: 'We Will Rock You', steps: [] }, fate: { title: \"Beethoven's 5th\", steps: [] } };\n(function () {\n    var i, bar;\n    for (bar = 0; bar < 4; bar++) { for (i = 0; i < 3; i++) { SONGS.rock.steps.push([bar * 2960 + i * 740, i < 2 ? 'soft' : 'success']); } }\n    [0, 3400, 6800].forEach(function (base, n) {\n        [0, 280, 560].forEach(function (d) { SONGS.fate.steps.push([base + d, n === 1 ? 'chime' : 'success']); });\n        SONGS.fate.steps.push([base + 840, n === 1 ? 'alert' : 'rotation']);\n    });\n}());\nvar SOUND_DIR = '/usr/share/feedback/sound/operation/', SOUND_GAP_MS = 800;\n// The TV's system sounds are quiet: the volume the user sets (10-100 %) is multiplied by this to get the paplay volume (100 % = 3.0, about +9.5 dB).\nvar SOUND_BOOST = 3;\n// The sound waits for the banner: Vetro needs a few seconds to start the banner service, which then records the id in this file (see app/service.js).\n// If the id never shows up there, the sound plays after SOUND_WAIT_MS anyway.\nvar SEEN_FILE = '/tmp/notification-center-seen.json', SOUND_WAIT_MS = 10000, SOUND_POLL_MS = 50, MAX_WAITING_SOUNDS = 8;   // at most 8 sounds wait for their banner at once; more are skipped\n// The TV's system sounds a request can choose (the names are the closed list in rules.js).\nvar SOUND_FILES = { chime: 'normal_noti.wav', soft: 'select.wav', reward: 'vi_reward.wav', success: 'vi_success.wav', alert: 'vi_fail.wav', rotation: 'p_rotation_fail.wav', open: 'home_open.wav', poweron: 'power_on.wav' };\n// Your own sounds: WAV files uploaded through the panel or POST sound-upload, kept in CUSTOM_DIR on the TV. Only names matching CUSTOM_NAME_RE that are files in that folder can be played.\nvar CUSTOM_DIR = '/home/owner/share/tmp/nc-sounds', CUSTOM_NAME_RE = /^[a-z0-9][a-z0-9-]{0,23}$/, MAX_CUSTOM = 12, MAX_WAV_BYTES = 1048576, MAX_WAV_SECONDS = 10;\nvar MAX_TITLE = 40, MAX_MESSAGE = 200, MAX_QUEUE = 5, MAX_RECENT = 20, MAX_BODY = 8192, MAX_ICON = 16;\nvar DEFAULT_SECONDS = 30, MIN_SECONDS = 5, MAX_SECONDS = 300, MIN_RELAUNCH_MS = 2000, APP_ACTIVE_MS = 3500;\n// The banner service reads the queue from this file, so it needs no network and no Vetro key (it still works with pairing on).\nvar QUEUE_FILE = '/tmp/notification-center-queue.json';\nvar REPORT_FILE = '/tmp/notification-center-report.json', MAX_REPORTS = 8;   // diagnosis of the banner service\nvar REPORT_TEXT = ['stage', 'node', 'fetch', 'webapis', 'postFunction', 'source', 'fileError', 'netError', 'error', 'returned', 'id'];\nvar DEFAULT_APP = 'NotifCtr01.NotifCenter';   // the companion app (screen: full-screen card, native banner)\nvar SERVICE_APP = 'NotifCtr01.Svc';           // its background service (native banner over the running app, no app switch)\nvar LEVELS = { info: 1, ok: 1, warn: 1, alert: 1 };\nvar MIN_DURATION = 1, MAX_DURATION = 60, DEFAULT_DURATION = 8;\nvar MODES = rules.MODES;   // banner (default) = native banner over the running app, from the background service; full = full-screen card; both = card + banner\nvar BARS = { overlay: 1, glass: 1, panel: 1 };   // drawn over the picture by the Shard's own native helper: flat bar, glass bar, large panel\n// The overlay bar is drawn by a small .NET program (overlay/Overlay.cs, shipped compiled as overlay/ncoverlay.dll.b64) that the TV's own dotnet runs.\n// The Shard unpacks it into OVERLAY_DIR, writes the text into a job file there (never on a command line) and runs one fixed command.\nvar OVERLAY_DIR = '/home/owner/share/tmp/ncoverlay';\nvar OVERLAY_COLORS = { info: '00beff', ok: '34c78f', warn: 'ffb020', alert: 'ee5a74' };\nvar OVERLAY_RUNTIMECONFIG = '{\"runtimeOptions\":{\"tfm\":\"netcoreapp3.1\",\"framework\":{\"name\":\"Microsoft.NETCore.App\",\"version\":\"3.1.0\"},\"configProperties\":{\"System.Globalization.Invariant\":true}}}';\n\nmodule.exports = function (ctx) {\n    // Where Vetro listens. Only a test passes ctx.vetro; on the TV it is always 127.0.0.1:8099.\n    var vetro = ctx.vetro && typeof ctx.vetro === 'object' ? ctx.vetro : {};\n    var VHOST = typeof vetro.host === 'string' ? vetro.host : '127.0.0.1', VPORT = typeof vetro.port === 'number' ? vetro.port : 8099;\n    var soundLast = null, soundAt = 0, soundTrace = null;   // soundTrace: when the last banner sound started and when its banner was seen (for the panel)\n    var queueFile = QUEUE_FILE, seenFile = SEEN_FILE, soundWaitMs = SOUND_WAIT_MS, waitingSounds = {}, songScale = 1;   // waitingSounds: notification id -> {fire, timer}\n    if (typeof ctx.queueFile === 'string') { queueFile = ctx.queueFile; }   // only a test changes this (each test Shard gets its own file)\n    if (typeof ctx.sound === 'object' && ctx.sound) {   // only a test changes these\n        if (typeof ctx.sound.gapMs === 'number') { SOUND_GAP_MS = ctx.sound.gapMs; }\n        if (typeof ctx.sound.waitMs === 'number') { soundWaitMs = ctx.sound.waitMs; }\n        if (typeof ctx.sound.seenFile === 'string') { seenFile = ctx.sound.seenFile; }\n        if (typeof ctx.sound.songScale === 'number') { songScale = ctx.sound.songScale; }\n    }\n    var reportFile = typeof ctx.reportFile === 'string' ? ctx.reportFile : REPORT_FILE;   // only a test changes this\n    var serviceReports = [], serviceLaunch = null;   // what the banner service said, and what Vetro answered when asked to start it\n    var queue = [];      // active notifications (memory only)\n    var recent = [];     // last ones sent, for the page; kept in ctx.config so they survive a restart or an update\n    try { var saved = (ctx.config.get() || {}).recent; if (Array.isArray(saved)) { recent = saved.slice(0, MAX_RECENT); } } catch (e) { recent = []; }\n    function saveRecent() { try { var c = ctx.config.get() || {}; c.recent = recent; ctx.config.set(c); } catch (e) { /* storage unavailable */ } }\n    var seq = 0;\n    var lastOpen = 0, appPoll = 0;\n    // When the full-screen app last reached this Shard (for the status route): the script nt.js, the queue poll and a picture, and from which address.\n    var appSeen = { ntjs: 0, poll: 0, img: 0, from: '' };\n    function mark(kind, req) {\n        appSeen[kind] = Date.now();\n        try { appSeen.from = str(req && req.socket && req.socket.remoteAddress).replace(/^::ffff:/, '').slice(0, 45); } catch (e) { appSeen.from = ''; }\n    }\n    function ageS(t) { return t ? Math.round((Date.now() - t) / 1000) : null; }   // appPoll: when the app screen last asked for the queue (0 = it is closed)\n\n    // Display language of the app screen and the panel: 'en' (default) or 'pt'. The only thing kept in ctx.config.\n    function getLang() { var c = ctx.config.get() || {}; return c.lang === 'pt' ? 'pt' : 'en'; }\n    function appId() { return DEFAULT_APP; }   // fixed: nothing can point the Shard at another app\n    function send(res, code, type, body) {\n        res.writeHead(code, { 'Content-Type': type, 'Cache-Control': 'no-store' });\n        res.end(body);\n    }\n    function sendJson(res, code, obj) { send(res, code, 'application/json; charset=utf-8', JSON.stringify(obj)); }\n    // The companion app can read the queue as a <script> when the TV's web runtime blocks cross-origin XHR.\n    function sendScript(res, obj) {\n        var json = JSON.stringify(obj).replace(/</g, '\\\\u003c');\n        json = json.split(String.fromCharCode(0x2028)).join('\\\\u2028').split(String.fromCharCode(0x2029)).join('\\\\u2029');\n        send(res, 200, 'application/javascript; charset=utf-8', 'window.__ncNotes&&window.__ncNotes(' + json + ');');\n    }\n    function wantsScript(req) { return /[?&]js=1(&|$)/.test(String(req.url || '')); }\n    // The body is collected as bytes and decoded once at the end, so a multi-byte character split between two chunks stays intact.\n    function toBuf(d) { return Buffer.isBuffer(d) ? d : (Buffer.from && Buffer.from !== Uint8Array.from ? Buffer.from(String(d), 'utf8') : new Buffer(String(d), 'utf8')); }\n    function readBody(req, cb, max) {\n        var chunks = [], n = 0, limit = max || MAX_BODY, over = false;\n        req.on('data', function (d) {\n            if (over) { return; }\n            var b = toBuf(d);\n            n += b.length;\n            if (n > limit) {\n                // Too large: answer 413 and drop the rest of the body without buffering it.\n                over = true; chunks = [];\n                if (cb.res) { try { sendJson(cb.res, 413, { error: 'request body too large' }); } catch (e) { /* already answered */ } }\n                return;\n            }\n            chunks.push(b);\n        });\n        req.on('end', function () { if (!over) { cb(Buffer.concat(chunks).toString('utf8')); } });\n    }\n    // A body handler that throws must never take the Shard down: answer 500 instead of letting the exception reach Vetro.\n    function guard(res, fn) {\n        var f = function (raw) {\n            try { fn(raw); } catch (e) { try { sendJson(res, 500, { error: 'internal error' }); } catch (e2) { /* the answer was already sent */ } }\n        };\n        f.res = res;   // readBody answers 413 on this response when the body is too large\n        return f;\n    }\n    function readBodyG(req, res, cb, max) { readBody(req, guard(res, cb), max); }\n    var limiter = rules.makeLimiter(), groups = {};   // per-source rate windows and recently seen repeats (memory only)\n    var str = rules.str, num = rules.num, has = rules.has;\n    function cfgGet() { return ctx.config.get() || {}; }\n    // Drops the grouping entries older than the window, and keeps at most MAX_GROUPS (the oldest go first). It walks the map only once it has grown past\n    // 50 entries, so a flood of distinct notifications cannot make every request slower.\n    var MAX_GROUPS = 200;\n    function pruneGroups(now, windowMs) {\n        var keys = Object.keys(groups);\n        if (keys.length <= 50) { return; }\n        keys.forEach(function (k) { if (now - groups[k].at >= windowMs) { delete groups[k]; } });\n        keys = Object.keys(groups);\n        if (keys.length > MAX_GROUPS) {\n            keys.sort(function (x, y) { return groups[x].at - groups[y].at; }).slice(0, keys.length - MAX_GROUPS).forEach(function (k) { delete groups[k]; });\n        }\n    }\n    // `app`: the id of an app installed on the TV (for example 9Ur5IzDKqV.TizenYouTube). Its icon is the picture of the notification when the request has no\n    // `image` of its own: Vetro serves it at /apps/icon (the same bounded download as any picture, PNG only for the overlay bar). Only a plain id is accepted.\n    function appIconUrl(v) { var id = str(v); return /^[A-Za-z0-9._-]{1,64}$/.test(id) ? 'http://' + VHOST + ':' + VPORT + '/apps/icon?appId=' + id : ''; }\n    function soundVolume(v) { return rules.clampVolume(v); }\n    function settingsNow() { return rules.sanitizeSettings(cfgGet().settings, {}); }\n    function clean(text, max) {\n        return str(text).replace(/[\\x00-\\x1f]/g, ' ').slice(0, max).trim();\n    }\n    function prune() {\n        var now = Date.now();\n        queue = queue.filter(function (n) { return n.expires > now; });\n        var keep = {};\n        queue.forEach(function (n) { keep[n.id] = 1; });\n        Object.keys(imgCache).forEach(function (k) { if (!keep[k.split(':')[0]]) { delete imgCache[k]; } });\n    }\n\n    // Asks Vetro to launch the companion app (at most once every 10 s), or its background service (every time: it is\n    // headless, so launching it only makes it read the queue and post the banner).\n    function openApp(service, id) {\n        var now = Date.now();\n        if (!service) {\n            // The app screen announces itself while it is open (it polls every 2 s and says goodbye when it leaves), so a notification\n            // queued while it is open is simply picked up, and one queued while it is closed launches it again right away.\n            if (now - appPoll < APP_ACTIVE_MS) { return 'app is open: it will pick it up'; }\n            if (now - lastOpen < MIN_RELAUNCH_MS) { return 'skipped (launched less than 2 s ago)'; }\n            lastOpen = now;\n        }\n        var body = JSON.stringify({ appId: service ? SERVICE_APP : appId() });\n        try {\n            var rq = http.request({\n                host: VHOST, port: VPORT, path: '/apps/launch', method: 'POST', timeout: 5000,\n                headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body) }\n            }, function (r) {\n                var answer = '';\n                r.on('data', function (d) { if (answer.length < 300) { answer += d; } });\n                r.on('end', function () {\n                    if (service) { serviceLaunch = { at: now, status: r.statusCode, body: clean(answer, 200) }; }\n                    if (r.statusCode >= 400) { setStatus(id, 'failed', 'could not open the app (http ' + r.statusCode + ')'); }\n                });\n            });\n            rq.on('error', function (e) { if (service) { serviceLaunch = { at: now, error: clean(e && e.message, 200) }; } setStatus(id, 'failed', 'could not reach Vetro'); });\n            rq.setTimeout(5000);   // the timeout option alone is ignored before Node 6.8\n            rq.on('timeout', function () { rq.destroy(); });\n            rq.write(body);\n            rq.end();\n            return 'requested';\n        } catch (e) { return 'error'; }\n    }\n\n    // The app may only load resources from the addresses its config.xml declares, so the Shard fetches the picture and serves it itself.\n    // Only a notification's own `image` / `image2` / `wallpaper` URL is ever fetched (there is no route that fetches an arbitrary URL). Limits: 2 fetches at once\n    // (the others wait, at most 8 waiting, then \"busy\"), 10 s in total per fetch however slowly the server sends, 3 MB, 3 redirects; stop() aborts them all.\n    var imgCache = {}, MAX_IMG = 3000000, MAX_FETCHES = 2, MAX_WAITING = 8, FETCH_DEADLINE_MS = 10000;\n    var running = [], waiting = [];\n    function pump() {\n        while (running.length < MAX_FETCHES && waiting.length) { var w = waiting.shift(); startFetch(w.url, w.cb); }\n    }\n    function fetchImage(url, cb) {\n        if (running.length >= MAX_FETCHES) {\n            if (waiting.length >= MAX_WAITING) { return cb('busy: too many picture downloads'); }\n            waiting.push({ url: url, cb: cb });\n            return;\n        }\n        startFetch(url, cb);\n    }\n    function startFetch(url, cb) {\n        var job = { reqs: [], done: false, timer: null };\n        function end(e, r) {\n            if (job.done) { return; }\n            job.done = true;\n            clearTimeout(job.timer);\n            job.reqs.forEach(function (q) { try { q.destroy(); } catch (x) { /* already closed */ } });\n            running = running.filter(function (j) { return j !== job; });\n            try { cb(e, r); } catch (x) { /* the caller's answer failed: nothing to do */ }\n            pump();\n        }\n        job.end = end;\n        running.push(job);\n        job.timer = setTimeout(function () { end('timeout (10 s)'); }, FETCH_DEADLINE_MS);\n        get(url, 0);\n        function get(u0, hops) {\n            var u = urlmod.parse(u0), lib = u.protocol === 'https:' ? https : http;\n            try {\n                var rq = lib.get({ host: u.hostname, port: u.port, path: u.path, headers: { 'User-Agent': 'vetro-notification-center', 'Accept': 'image/*' }, timeout: 8000 }, function (r) {\n                    if (job.done) { r.resume(); return; }\n                    if (r.statusCode >= 300 && r.statusCode < 400 && r.headers.location && hops < 3) {\n                        r.resume();\n                        return get(urlmod.resolve(u0, r.headers.location), hops + 1);\n                    }\n                    var type = str(r.headers['content-type']).split(';')[0];\n                    if (r.statusCode !== 200 || !/^image\\/(png|jpe?g|gif|webp|bmp)$/i.test(type)) { r.resume(); return end('not an image (http ' + r.statusCode + ' ' + type + ')'); }\n                    var chunks = [], n = 0;\n                    r.on('data', function (d) { n += d.length; if (n > MAX_IMG) { r.destroy(); end('image is larger than 3 MB'); } else { chunks.push(d); } });\n                    r.on('end', function () { end(null, { type: type, buf: Buffer.concat(chunks) }); });\n                    r.on('error', function () { end('download failed'); });\n                });\n                job.reqs.push(rq);\n                rq.on('error', function (e) { end(str(e && e.code || e && e.message)); });\n                rq.setTimeout(8000);\n                rq.on('timeout', function () { end('timeout'); });\n            } catch (e) { end('request failed'); }\n        }\n    }\n    function abortFetches() {\n        var w = waiting; waiting = [];\n        running.slice().forEach(function (j) { j.end('stopped'); });\n        w.forEach(function (x) { try { x.cb('stopped'); } catch (e) { /* ignore */ } });\n    }\n\n    // Sound: plays one of the TV's own system sounds. This Shard has the `exec` permission for exactly ONE command shape:\n    //     paplay --volume=<integer> /usr/share/feedback/sound/operation/<one of the fixed files above>\n    // The sound comes from a closed list and the volume is a clamped integer, so no text from a request ever reaches the command.\n    // At most one sound every 0.8 s (a flood of requests cannot make the TV play a flood of sounds).\n    function playSound(name, volume) {\n        if (typeof name !== 'string' || !rules.hasSound(name)) { return 'none'; }\n        var now = Date.now();\n        if (now - soundAt < SOUND_GAP_MS) { return 'skipped'; }\n        soundAt = now;\n        return execSound(name, volume, now);\n    }\n    // The only place that runs a command.\n    function execSound(name, volume, now) {\n        var v = Math.round(65536 * (volume >= 10 && volume <= 100 ? volume : 100) / 100 * settingsNow().soundVolume / 100 * SOUND_BOOST), job;\n        try { job = ctx.execute('paplay --volume=' + v + ' ' + (has(SOUND_FILES, name) ? SOUND_DIR + SOUND_FILES[name] : customDir() + '/' + name + '.wav'), 8000); } catch (e) { soundLast = { at: now, ok: false, error: 'exec failed' }; return 'requested'; }\n        if (!job || typeof job.then !== 'function') { soundLast = { at: now, ok: false, error: 'exec unavailable' }; return 'requested'; }\n        job.then(function (r) {\n            soundLast = r && r.exit_code ? { at: now, ok: false, error: 'paplay exit ' + r.exit_code + (r.stderr ? ': ' + str(r.stderr).slice(0, 120) : '') } : { at: now, ok: true };\n        }, function (e) { soundLast = { at: now, ok: false, error: str(e && e.message).slice(0, 160) || 'exec failed' }; });\n        return 'requested';\n    }\n\n    // Goodie: about 10 seconds of a well-known tune made only of the notification sounds. The sounds have fixed pitches, so the tunes are recognised by their\n    // rhythm. The songs are fixed lists in the code (a request only picks a name), every step runs the same paplay command, one song at a time, at most 12 s.\n    var songTimers = [], songEnd = null;\n    function playSong(name) {\n        if (!has(SONGS, name)) { return 'unknown'; }\n        if (songEnd) { return 'busy'; }\n        var steps = SONGS[name].steps, last = 0;\n        steps.forEach(function (s) {\n            last = s[0] > last ? s[0] : last;\n            songTimers.push(setTimeout(function () { execSound(s[1], 100, Date.now()); }, Math.round(s[0] * songScale)));\n        });\n        songEnd = setTimeout(function () { songTimers = []; songEnd = null; }, Math.round((last + 2500) * songScale));\n        return 'playing';\n    }\n    function stopSong() {\n        songTimers.forEach(function (x) { clearTimeout(x); });\n        songTimers = []; clearTimeout(songEnd); songEnd = null;\n    }\n\n    // The sound goes with the banner. The banner appears some seconds after the request (Vetro has to start the banner service) and the Shard cannot see\n    // when: the service has no permission to write back. So the sound starts `soundDelayMs` after the request (a setting you tune by ear, with the test in the\n    // Testing tab); if the banner service did record the id in the file the Shard can read (other TVs), the sound starts as soon as it is seen.\n    // Full and both: the sound plays when the app screen asks for the queue. open:false notifications (never shown) play at once.\n    function scheduleSound(note) {\n        if (Object.keys(waitingSounds).length >= MAX_WAITING_SOUNDS) { return false; }\n        var entry = { timer: null, done: false, fired: false }, started = Date.now();\n        var fireAt = started + Math.min(settingsNow().soundDelayMs, soundWaitMs);\n        var trace = { id: note.id, mode: note.mode, plannedMs: fireAt - started, startedMs: null, seenMs: null };\n        soundTrace = trace;\n        function fire() { if (!entry.fired) { entry.fired = true; trace.startedMs = Date.now() - started; playSound(note.sound, note.volume); } }\n        function finish() { entry.done = true; clearTimeout(entry.timer); delete waitingSounds[note.id]; }\n        entry.fire = function () { fire(); finish(); };\n        waitingSounds[note.id] = entry;\n        function shown() { try { return has(JSON.parse(fs.readFileSync(seenFile, 'utf8')), note.id); } catch (e) { return false; } }\n        function tick() {\n            if (entry.done) { return; }\n            var now = Date.now();\n            if (note.mode === 'banner') {\n                if (shown()) { trace.seenMs = now - started; fire(); return finish(); }\n                if (!entry.fired && now >= fireAt) { fire(); }\n                if (now - started > soundWaitMs + 3000) { return finish(); }\n            } else if (now - started >= soundWaitMs) { fire(); return finish(); }\n            entry.timer = setTimeout(tick, SOUND_POLL_MS);\n        }\n        entry.timer = setTimeout(tick, SOUND_POLL_MS);\n        return true;\n    }\n    function cancelSounds() { Object.keys(waitingSounds).forEach(function (id) { var e = waitingSounds[id]; e.done = true; clearTimeout(e.timer); }); waitingSounds = {}; }\n    function soundAvailable() { return typeof ctx.execute === 'function'; }\n\n    // ---- your own sounds ----\n    function customDir() { var d = ctx.sound && ctx.sound.dir; return typeof d === 'string' && /^[A-Za-z0-9_:\\\\\\/.-]+$/.test(d) && d.charAt(0) !== '-' ? d : CUSTOM_DIR; }\n    function soundNames() { return Object.keys(rules.SOUNDS).concat(Object.keys(rules.CUSTOM)); }\n    // Keeps rules.CUSTOM in step with the folder: only well-named .wav files, never a name of a built-in sound.\n    function loadCustom() {\n        var list = [];\n        try { list = fs.readdirSync(customDir()); } catch (e) { list = []; }\n        Object.keys(rules.CUSTOM).forEach(function (k) { delete rules.CUSTOM[k]; });\n        list.sort().forEach(function (f) {\n            var m = /^([a-z0-9][a-z0-9-]{0,23})\\.wav$/.exec(f);\n            if (m && !has(SOUND_FILES, m[1]) && Object.keys(rules.CUSTOM).length < MAX_CUSTOM) { rules.CUSTOM[m[1]] = 1; }\n        });\n    }\n    // A WAV the TV's paplay can surely play: PCM, 16 bit, mono or stereo, 8-48 kHz, short. Returns {seconds} or null.\n    function wavInfo(b) {\n        if (!b || b.length < 44 || b.length > MAX_WAV_BYTES || b.toString('ascii', 0, 4) !== 'RIFF' || b.toString('ascii', 8, 12) !== 'WAVE') { return null; }\n        var pos = 12, fmt = null, dataLen = -1, id, len;\n        while (pos + 8 <= b.length) {\n            id = b.toString('ascii', pos, pos + 4); len = b.readUInt32LE(pos + 4);\n            if (id === 'fmt ' && len >= 16 && pos + 24 <= b.length) { fmt = { f: b.readUInt16LE(pos + 8), ch: b.readUInt16LE(pos + 10), rate: b.readUInt32LE(pos + 12), bits: b.readUInt16LE(pos + 22) }; }\n            else if (id === 'data') { dataLen = Math.min(len, b.length - pos - 8); break; }\n            pos += 8 + len + (len & 1);\n        }\n        if (!fmt || dataLen <= 0 || fmt.f !== 1 || fmt.ch < 1 || fmt.ch > 2 || fmt.bits !== 16 || fmt.rate < 8000 || fmt.rate > 48000) { return null; }\n        var secs = dataLen / (fmt.rate * fmt.ch * 2);\n        return secs <= MAX_WAV_SECONDS ? { seconds: Math.round(secs * 10) / 10 } : null;\n    }\n    function readBinary(req, res, cb, limit) {\n        var chunks = [], n = 0, over = false, max = limit || MAX_WAV_BYTES;\n        req.on('data', function (d) {\n            if (over) { return; }\n            var b = toBuf(d);\n            n += b.length;\n            if (n > max) { over = true; chunks = []; try { sendJson(res, 413, { error: 'request body too large' }); } catch (e) { /* already answered */ } return; }\n            chunks.push(b);\n        });\n        req.on('end', function () {\n            if (over) { return; }\n            try { cb(Buffer.concat(chunks)); } catch (e) { try { sendJson(res, 500, { error: 'internal error' }); } catch (e2) { /* answered */ } }\n        });\n    }\n    function handleSoundUpload(req, res) {\n        var m = /[?&]name=([^&]*)/.exec(String(req.url || '')), name = '';\n        try { name = m ? decodeURIComponent(m[1]) : ''; } catch (e) { name = ''; }\n        if (!CUSTOM_NAME_RE.test(name) || has(SOUND_FILES, name)) { return sendJson(res, 400, { error: 'name: 1-24 characters, a-z, 0-9 and -, and not the name of a built-in sound' }); }\n        if (!has(rules.CUSTOM, name) && Object.keys(rules.CUSTOM).length >= MAX_CUSTOM) { return sendJson(res, 400, { error: 'at most ' + MAX_CUSTOM + ' own sounds: delete one first' }); }\n        readBinary(req, res, function (buf) {\n            var info = wavInfo(buf);\n            if (!info) { return sendJson(res, 400, { error: 'not a WAV the TV can play: PCM 16 bit, mono or stereo, 8-48 kHz, at most ' + MAX_WAV_SECONDS + ' s and 1 MB' }); }\n            var dir = customDir();\n            try { fs.mkdirSync(dir); } catch (e) { /* exists */ }\n            if (!putFile(dir + '/' + name + '.wav', buf)) { return sendJson(res, 500, { error: 'could not save the file' }); }\n            loadCustom();\n            sendJson(res, 200, { ok: true, name: name, seconds: info.seconds });\n        });\n    }\n    function handleSoundDelete(req, res) {\n        readBodyG(req, res, function (raw) {\n            var b;\n            try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\n            var name = rules.isObj(b) ? str(b.name) : '';\n            if (!has(rules.CUSTOM, name)) { return sendJson(res, 404, { error: 'no own sound with that name' }); }\n            try { fs.unlinkSync(customDir() + '/' + name + '.wav'); } catch (e) { /* already gone */ }\n            loadCustom();\n            sendJson(res, 200, { ok: true, deleted: name });\n        });\n    }\n\n    // ---- overlay bar ----\n    // The helper is unpacked once into OVERLAY_DIR (again only if the file is missing or its size differs). The text goes into job.txt, one value per line,\n    // so no text from a request ever reaches a shell. The command is fixed; the directory is a constant (a test can point ctx.overlay.dir elsewhere).\n    function overlayDir() { var d = ctx.overlay && ctx.overlay.dir; return typeof d === 'string' && /^[A-Za-z0-9_:\\\\\\/.-]+$/.test(d) && d.charAt(0) !== '-' ? d : OVERLAY_DIR; }\n    function overlayAvailable() { return typeof ctx.execute === 'function'; }\n    // Same pattern as the queue file: a new name with 'wx', then renamed over the target (never written through a planted symlink).\n    function putFile(file, data) {\n        var tmp = file + '.' + process.pid + '.' + Date.now().toString(36) + '.tmp';\n        try { fs.writeFileSync(tmp, data, { mode: 420, flag: 'wx' }); fs.renameSync(tmp, file); return true; } catch (e) { try { fs.unlinkSync(tmp); } catch (e2) { /* nothing to remove */ } return false; }\n    }\n    function overlayInstall() {\n        var dir = overlayDir(), dll = dir + '/ncoverlay.dll', rc = dir + '/ncoverlay.runtimeconfig.json', buf, size = -1, same = false;\n        try {\n            try { fs.mkdirSync(dir); } catch (e) { /* exists */ }\n            buf = require('zlib').gunzipSync(new Buffer(fs.readFileSync(path.join(__dirname, 'overlay', 'ncoverlay.dll.b64'), 'ascii'), 'base64'));\n            // The whole content is compared: .NET files grow in steps of 512 bytes, so a new helper can have the size of the old one.\n            try { same = fs.readFileSync(dll).toString('base64') === buf.toString('base64'); } catch (e) { same = false; }\n            if (!same && !putFile(dll, buf)) { return ''; }\n            try { size = fs.statSync(rc).size; } catch (e) { size = -1; }\n            if (size !== OVERLAY_RUNTIMECONFIG.length && !putFile(rc, OVERLAY_RUNTIMECONFIG)) { return ''; }\n            return dir;\n        } catch (e) { return ''; }\n    }\n    function isPng(b) { return b && b.length > 33 && b[0] === 0x89 && b[1] === 0x50 && b[2] === 0x4e && b[3] === 0x47; }\n    function overlayRun(note, icons, dir) {\n        function line(v) { return str(v).replace(/[\\r\\n]+/g, ' '); }\n        var s = settingsNow(), job = [line(note.title), line(note.message), OVERLAY_COLORS[has(OVERLAY_COLORS, note.level) ? note.level : 'info'], note.duration, s.overlayOpacity, icons[0], icons[1], s.overlayMotion ? 1 : 0, s.overlayPosition, note.mode === 'overlay' ? '' : note.mode].join('\\n') + '\\n';\n        if (!putFile(dir + '/job.txt', job)) { return setStatus(note.id, 'failed', 'could not write the bar'); }\n        // A bar that is still up is closed first (its pid is only used while it really is our helper), then the new one starts in the background.\n        var cmd = 'P=' + dir + '/pid; if [ -f $P ] && grep -q ncoverlay /proc/$(cat $P)/cmdline 2>/dev/null; then kill $(cat $P) 2>/dev/null; fi; ' +\n            '( dotnet ' + dir + '/ncoverlay.dll --file ' + dir + '/job.txt >/dev/null 2>&1 & echo $! > $P ); echo started';\n        try { ctx.execute(cmd, 8000).then(function () { setStatus(note.id, 'shown'); }, function () { setStatus(note.id, 'failed', 'the bar did not start'); }); } catch (e) { setStatus(note.id, 'failed', 'exec failed'); }\n    }\n    // One bar at a time, each for its duration; urgent ones first. A new note with the same replace key takes the place of the one that waits,\n    // or of the one on screen. Nothing waits behind the bar after stop().\n    var MAX_BARS = 5, barQueue = [], barNow = null, barTimer = null;\n    var barSecondMs = ctx.overlay && typeof ctx.overlay.secondMs === 'number' ? ctx.overlay.secondMs : 1000;\n    function sameSlot(a, b) { return !!b.replace && a.replace === b.replace && a.source === b.source; }\n    function barFull(note) { return barQueue.length >= MAX_BARS && note.priority !== 'high' && !barQueue.some(function (n) { return sameSlot(n, note); }); }\n    function barShow(note, dir) {\n        barNow = note;\n        clearTimeout(barTimer);\n        if (barSecondMs > 0) { barTimer = setTimeout(function () { barNow = null; barNext(dir); }, note.duration * barSecondMs + 300); }\n        var urls = [note.image, note.image2], icons = ['', ''], left = urls.filter(Boolean).length;\n        if (!left) { return overlayRun(note, icons, dir); }\n        urls.forEach(function (url, i) {\n            if (!url) { return; }\n            fetchImage(url, function (err, hit) {\n                if (barSecondMs > 0 && barNow !== note) { return; }   // a newer bar took its place while the picture was loading\n                var file = dir + (i ? '/icon2.png' : '/icon.png');\n                if (!err && hit && isPng(hit.buf) && putFile(file, hit.buf)) { icons[i] = file; }\n                left -= 1;\n                if (!left) { overlayRun(note, icons, dir); }\n            });\n        });\n    }\n    function barNext(dir) {\n        var n;\n        while ((n = barQueue.shift())) {\n            if (n.expires > Date.now()) { return barShow(n, dir); }\n            setStatus(n.id, 'expired', 'waited too long');\n        }\n    }\n    function barStop() { clearTimeout(barTimer); barQueue = []; barNow = null; }\n    // Shows the bar. A PNG `image` becomes the icon on its left and a PNG `image2` the one on its right (fetched with the same bounded download as the card's pictures).\n    function overlayShow(note) {\n        if (!overlayAvailable()) { return 'unavailable'; }\n        var dir = overlayInstall();\n        if (!dir) { return 'error'; }\n        barQueue = barQueue.filter(function (n) { if (sameSlot(n, note)) { setStatus(n.id, 'replaced'); return false; } return true; });\n        if (!barNow || barSecondMs <= 0 || sameSlot(barNow, note)) { barShow(note, dir); return 'requested'; }\n        if (note.priority === 'high') { barQueue.unshift(note); } else { barQueue.push(note); }\n        while (barQueue.length > MAX_BARS) { setStatus(barQueue.pop().id, 'dropped', 'queue full'); }\n        return 'queued';\n    }\n\n    // The apps of the TV, for the suggestions of the action button: the panel may only call routes of this Shard.\n    function handleApps(res) {\n        var done = false;\n        function reply(list) { if (!done) { done = true; sendJson(res, 200, { apps: list }); } }\n        try {\n            var rq = http.get({ host: VHOST, port: VPORT, path: '/apps', timeout: 5000 }, function (r) {\n                var s = '';\n                r.setEncoding('utf8');\n                r.on('data', function (d) { s += d; if (s.length > 3000000) { r.destroy(); reply([]); } });\n                r.on('end', function () {\n                    var out = [], i;\n                    try {\n                        var j = JSON.parse(s), list = Array.isArray(j) ? j : (j.apps || []);\n                        for (i = 0; i < list.length && out.length < 250; i++) {\n                            if (list[i] && list[i].show === true && /^[A-Za-z0-9._-]{1,64}$/.test(str(list[i].appId))) { out.push({ appId: str(list[i].appId), name: clean(list[i].name, 60) }); }\n                        }\n                    } catch (e) { out = []; }\n                    reply(out);\n                });\n            });\n            rq.on('error', function () { reply([]); });\n            rq.setTimeout(5000);\n            rq.on('timeout', function () { rq.destroy(); reply([]); });\n        } catch (e) { reply([]); }\n    }\n\n    // Installation status for the panel: is the companion app (and its service) installed, is Vetro pairing on, which Shard version.\n    // Only known fields are kept, as short plain text or small numbers.\n    // The banner service reports what it does: while it is alive, the app screen must not post the banners again.\n    // A service that says it failed does not count: after a banner it could not post (until it posts one again), or a queue it could not read\n    // (until it reads it). What it posted, or failed to post, is also kept per notification.\n    var serviceSeenAt = 0, postBroken = false, readBroken = false, servicePosts = [];\n    function serviceHeard(r) {\n        if (r.stage === 'queue-failed') { readBroken = true; }\n        if (r.stage === 'queue') { readBroken = false; }\n        if (r.stage !== 'posted' && r.stage !== 'post-failed') { return; }\n        postBroken = r.stage === 'post-failed';\n        if (!postBroken) { readBroken = false; }\n        servicePosts.push({ id: r.id, ok: !postBroken });\n        if (servicePosts.length > 20) { servicePosts.shift(); }\n    }\n    // Does the banner service post this banner? Then the app screen must not.\n    function serviceHas(id) {\n        var i;\n        for (i = servicePosts.length - 1; i >= 0; i--) { if (servicePosts[i].id === id) { return servicePosts[i].ok; } }\n        return !postBroken && !readBroken && Date.now() - serviceSeenAt < 600000;\n    }\n    function cleanReport(v) {\n        if (!rules.isObj(v) || !str(v.stage)) { return null; }\n        var out = {};\n        REPORT_TEXT.forEach(function (k) { if (has(v, k)) { out[k] = clean(v[k], 200); } });\n        ['count', 'fresh'].forEach(function (k) { if (has(v, k) && num(v[k]) >= 0) { out[k] = num(v[k]); } });\n        return out;\n    }\n    function handleServiceReport(req, res) {\n        readBodyG(req, res, function (raw) {\n            var r;\n            try { r = cleanReport(JSON.parse(raw)); } catch (e) { r = null; }\n            if (!r) { return sendJson(res, 400, { error: 'a JSON object with a stage' }); }\n            r.at = serviceSeenAt = Date.now();\n            serviceHeard(r);\n            serviceReports.push(r);\n            if (serviceReports.length > MAX_REPORTS) { serviceReports.shift(); }\n            sendJson(res, 200, { ok: true });\n        });\n    }\n    // The copy the service leaves in a file, for a TV where it cannot reach the Shard over the network.\n    function fileReport() {\n        try {\n            if (fs.statSync(reportFile).size > 20000) { return null; }\n            var d = JSON.parse(fs.readFileSync(reportFile, 'utf8'));\n            return { at: num(d.at) || 0, reports: (Array.isArray(d.reports) ? d.reports.slice(-MAX_REPORTS) : []).map(cleanReport).filter(Boolean) };\n        } catch (e) { return null; }\n    }\n    function statusInfo(cb) {\n        var out = { version: '', app: false, appVersion: '', service: false, pairing: 'unknown', handoff: false, sound: soundAvailable(), overlay: overlayAvailable(), screen: { ntjsAgoS: ageS(appSeen.ntjs), pollAgoS: ageS(appSeen.poll), imgAgoS: ageS(appSeen.img), from: appSeen.from, open: appPoll > 0 && Date.now() - appPoll < APP_ACTIVE_MS } }, left = 2;\n        try { out.handoff = fs.existsSync(queueFile); } catch (e) { /* unknown */ }\n        out.serviceDiag = { launch: serviceLaunch, reports: serviceReports, file: fileReport() };\n        try { out.version = require('./manifest.json').version; } catch (e) { /* manifest not readable */ }\n        function once() { var d = false; return function () { if (!d) { d = true; left -= 1; if (!left) { cb(out); } } }; }\n        var d1 = once(), d2 = once();\n        try {\n            var rq = http.get({ host: VHOST, port: VPORT, path: '/apps', timeout: 5000 }, function (r) {\n                var s = '';\n                r.setEncoding('utf8');\n                r.on('data', function (d) { s += d; if (s.length > 3000000) { r.destroy(); } });\n                r.on('end', function () {\n                    try {\n                        var j = JSON.parse(s), list = Array.isArray(j) ? j : (j.apps || []), i;\n                        for (i = 0; i < list.length; i++) {\n                            if (list[i].appId === DEFAULT_APP) { out.app = true; out.appVersion = str(list[i].version); }\n                            if (list[i].appId === SERVICE_APP) { out.service = true; }\n                        }\n                    } catch (e) { /* leave unknown */ }\n                    d1();\n                });\n            });\n            rq.on('error', d1);\n            rq.setTimeout(5000);\n            rq.on('timeout', function () { rq.destroy(); });\n        } catch (e) { d1(); }\n        // Pairing: ask this TV on its own LAN address without a key; 401 means pairing is on.\n        var ip = null, ifs = os.networkInterfaces(), k, j2;\n        for (k in ifs) { if (ifs.hasOwnProperty(k)) { for (j2 = 0; j2 < ifs[k].length; j2++) { if (ifs[k][j2].family === 'IPv4' && !ifs[k][j2].internal && !ip) { ip = ifs[k][j2].address; } } } }\n        if (!ip) { return d2(); }\n        try {\n            var rq2 = http.get({ host: ip, port: 8099, path: '/plugins/notification-center/api/lang', timeout: 4000 }, function (r) {\n                r.resume();\n                out.pairing = r.statusCode === 401 ? 'on' : r.statusCode === 200 ? 'off' : 'unknown';\n                d2();\n            });\n            rq2.on('error', d2);\n            rq2.setTimeout(4000);\n            rq2.on('timeout', function () { rq2.destroy(); });\n        } catch (e) { d2(); }\n    }\n\n    function serveImage(req, res) {\n        var m = /[?&]id=([^&]+)/.exec(String(req.url || '')), id = '', info = /[?&]info=1(&|$)/.test(String(req.url || '')), note = null, i;\n        try { id = m ? decodeURIComponent(m[1]) : ''; } catch (e) { id = ''; }\n        for (i = 0; i < queue.length; i++) { if (queue[i].id === id) { note = queue[i]; } }\n        var asked = /[?&]kind=(wallpaper|image2)(&|$)/.exec(String(req.url || '')), kind = asked ? asked[1] : 'image', src = note && note[kind], key = id + ':' + kind;\n        if (!src) { return sendJson(res, 404, { error: 'no ' + kind + ' for that notification' }); }\n        // A theme wallpaper (\"theme:sport\", \"theme:news\") is a small SVG shipped with the Shard: served from the plugin folder, nothing is fetched.\n        var tm = /^theme:(sport|news)$/.exec(String(src));\n        if (tm) {\n            return fs.readFile(path.join(__dirname, 'wallpapers', tm[1] + '.svg'), function (e, buf) {\n                if (e) { return sendJson(res, 404, { ok: false, error: 'theme wallpaper missing' }); }\n                if (info) { return sendJson(res, 200, { ok: true, type: 'image/svg+xml', bytes: buf.length }); }\n                res.writeHead(200, { 'Content-Type': 'image/svg+xml', 'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff', 'Content-Length': buf.length });\n                res.end(buf);\n            });\n        }\n        function out(hit) {\n            if (info) { return sendJson(res, 200, { ok: true, type: hit.type, bytes: hit.buf.length }); }\n            res.writeHead(200, { 'Content-Type': hit.type, 'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff', 'Content-Length': hit.buf.length });\n            res.end(hit.buf);\n        }\n        if (imgCache[key]) { return out(imgCache[key]); }\n        fetchImage(src, function (err, hit) {\n            if (err) { return sendJson(res, 502, { ok: false, error: err }); }\n            imgCache[key] = hit;\n            out(hit);\n        });\n    }\n\n    // Self-description of the API, built from the same constants that validate the requests, so it cannot drift from the code.\n    // Keep it in step with API.md: every new field, mode or route is added in code, here, and in API.md together.\n    function describe() {\n        var ver = '';\n        try { ver = require('./manifest.json').version; } catch (e) { /* manifest not readable */ }\n        return {\n            name: 'notification-center', version: ver, apiVersion: 1,\n            features: ['category', 'status', 'ttl', 'replace', 'policy', 'image2'],\n            base: '/plugins/notification-center/api/',\n            auth: 'Same as the rest of Vetro: no key with pairing off; with pairing on, other devices send \"Authorization: Bearer <key>\". Shards on the same TV call http://127.0.0.1:8099 and need no key.',\n            enums: { level: Object.keys(LEVELS), mode: Object.keys(MODES), sound: soundNames() },\n            limits: { title: MAX_TITLE, message: MAX_MESSAGE, queue: MAX_QUEUE, recent: MAX_RECENT, durationSeconds: [MIN_DURATION, MAX_DURATION], queueSeconds: [MIN_SECONDS, MAX_SECONDS], image: 'image, image2 and wallpaper: 3 MB, png/jpeg/gif/webp/bmp, http(s) URL up to 290 characters; the overlay bar draws only PNG up to 2 MB and 1024x1024, not interlaced, 8 bits per channel (grey and palette also 1, 2 or 4 bits); per download 8 s without data on a socket and 10 s in total, 3 redirects; 2 downloads at once', relaunchAfterSeconds: MIN_RELAUNCH_MS / 1000 },\n            fields: {\n                message: { type: 'string', required: true, max: MAX_MESSAGE, note: 'The text of the notification.' },\n                title: { type: 'string', max: MAX_TITLE },\n                level: { type: 'string', enum: Object.keys(LEVELS), default: 'info', note: 'Colours the card and the panel; the native banner shows the level emoji.' },\n                mode: { type: 'string', enum: Object.keys(MODES), default: 'setting defaultMode (banner)', note: 'banner = native Samsung banner over the running app (no app switch); full = full-screen card; both = card and banner; overlay = flat bar over the running picture, drawn by the Shard\\'s own helper; glass = the same bar in glass style, sliding and fading (setting overlayMotion); panel = dark panel almost the size of the screen with large logos, over the picture, no buttons (with action it is shown as full). In overlay, glass and panel `level` colours the stripe, a PNG `image` is the left icon and a PNG `image2` the right one; overlayPosition moves the two bars. See settings bannerAsOverlay and bannerImageAsBar.' },\n                duration: { type: 'integer', min: MIN_DURATION, max: MAX_DURATION, default: DEFAULT_DURATION, note: 'Seconds on screen. overlay, glass and panel without it use the setting overlayDuration (default 8).' },\n                icon: { type: 'string', max: MAX_ICON, note: 'One emoji (or an emoji sequence) in front of the title; default by level. Cut at whole emoji, never in the middle of one.' },\n                image: { type: 'url', note: 'http/https picture under the message on the full-screen card, or the left icon of the overlay bar (PNG), for example the logo of the home club. The Shard fetches it.' },\n                image2: { type: 'url', note: 'A second http/https picture, for example the logo of the away club: next to `image` on the card, the right icon of the overlay bar (PNG). Same rules as image; `app` does not fill it.' },\n                app: { type: 'string', note: 'Id of an app installed on the TV (for example 9Ur5IzDKqV.TizenYouTube; GET /apps on Vetro lists them). Its icon is used as the picture when there is no image: the card shows it, the overlay bar uses it as its icon.' },\n                wallpaper: { type: 'url', note: 'http/https full-screen background behind the card. The Shard fetches it. It wins over `theme`.' },\n                theme: { type: 'string', enum: themeNames(), note: 'A default wallpaper for the full-screen card: sport or news (shipped with the Shard) or a theme you added (GET themes), used when the request has no `wallpaper`. A source can have its own default theme.' },\n                priority: { type: 'string', enum: Object.keys(rules.PRIORITIES), default: 'normal', note: 'high = first in the queue, shown even in quiet hours and never merged as a repeat. A source can have a default priority. ntfy priority 5 is high.' },\n                action: { type: 'object', note: '{app, label?}: a button on the full-screen card (modes full and both) that opens the installed app with that id; label is up to 24 characters (default Open). The card also has a Dismiss button. The bar and the Samsung banner have no buttons.' },\n                seconds: { type: 'integer', min: MIN_SECONDS, max: MAX_SECONDS, default: DEFAULT_SECONDS, note: 'How long it waits in the queue (always at least duration + 20).' },\n                open: { type: 'boolean', default: true, note: 'false only queues it, without launching the app or its service.' },\n                sound: { type: 'string', enum: soundNames(), note: 'Plays one of the TV system sounds, or one of your own uploaded sounds (see GET sounds, custom), with the notification. Empty = no sound; one sound at most every 0.8 s. Not played for a notification held back by quiet hours or merged as a repeat.' },\n                volume: { type: 'integer', min: 10, max: 100, default: 100, note: 'Volume of the sound, in percent.' },\n                group: { type: 'boolean', default: true, note: 'false = never merge this notification with an identical recent one (the panel sends false for Resend and the test buttons). Merging only happens while the setting groupSeconds is above 0.' },\n                category: { type: 'string', max: 24, note: 'What kind of notification it is (a-z, 0-9, _ -), for example goal, civil, weather. A source can have its own defaults per category.' },\n                ttl: { type: 'integer', min: 1, max: 3600, note: 'After this many seconds it is no longer shown. It replaces seconds.' },\n                replace: { type: 'string', max: 40, note: 'A key of your own (for example match-123): a new notification of the same source with it replaces the one that waits or the bar on screen.' },\n                source: { type: 'string', max: 32, note: 'Who is sending (a-z, 0-9, . _ -), or the header X-NC-Source. If a profile with that name exists, its defaults (also per category) fill in what you leave out, its allow switches can overrule what you ask for, and its key, enabled flag and rate limit apply. It is only a name the sender states: without it that profile does not apply (strict refuses unknown names).' },\n                key: { type: 'string', max: 64, note: 'The key of the source, when its profile has one: this field of POST notify, or the header X-NC-Key (which wins). ntfy and webhooks take the header only. Never stored with the notification.' }\n            },\n            endpoints: [\n                { method: 'POST', path: 'notify', summary: 'Send a notification (JSON body with the fields above). With quiet hours it may answer {ok, id, suppressed}; a repeat inside the grouping window answers {ok, id, merged:true, count}.', returns: '{ok, id, status: queued|shown|merged|suppressed|failed, reason, effective:{mode,sound,volume,duration}, open, sound}; 429 {error, retryAfter} when the queue is full or over the rate' },\n                { method: 'GET', path: 'notify-status?id=<id>', summary: 'What happened to one of the last notifications: queued, shown, merged, suppressed, replaced, expired, dropped, rejected or failed.', returns: '{ok, id, status, reason, source, category}' },\n                { method: 'POST', path: 'ntfy', summary: 'ntfy-compatible publish: body = message; headers Title, Priority (5 alert, 4 warning), Tags; or JSON {message,title,priority,tags}.', returns: '{ok, id, open}' },\n                { method: 'GET', path: 'notifications', summary: 'The active queue (used by the app and its service); add ?js=1 for the script form.', returns: '{lang, notifications:[{id,title,message,level,mode,duration,icon,image,image2,wallpaper,priority:\"high\"|\"\",svc,action:{label}|null,seconds}]}; svc true = the banner service posts that banner (it reported in the last 10 minutes and did not say it failed), so the app screen must not' },\n                { method: 'GET', path: 'recent', summary: 'The last 20, newest first, also the held back and refused ones.', returns: '{recent:[{id,title,message,level,mode,duration,icon,image,image2,wallpaper,theme,priority,action,source,category,status,reason,sound,volume,at,count?,suppressed?}]}; action is the button label; a refused one has only id,title,message,level,source,category,status,reason,at' },\n                { method: 'GET', path: 'img?id=<id>[&kind=<kind>][&info=1]', summary: 'The picture of a queued notification (image, or with kind image2 or wallpaper), fetched and served by the Shard; info=1 returns {ok,type,bytes}.', returns: 'image bytes or JSON' },\n                { method: 'GET', path: 'status', summary: 'Installation status: companion app, its service, Vetro pairing, Shard version.', returns: '{version, app, appVersion, service, handoff, pairing, sound, overlay, screen, serviceDiag:{launch,reports,file}}; handoff = the queue file the banner service reads exists' },\n                { method: 'POST', path: 'service-report', summary: 'Used by the banner service to say what happened (started, where it read the queue, whether the banner function exists, its error). The last 8 are in GET status, serviceDiag.', body: '{stage, ...}', returns: '{ok}' },\n                { method: 'GET', path: 'lang', summary: 'Display language (en or pt).', returns: '{lang}' },\n                { method: 'POST', path: 'lang', summary: 'Set the display language.', body: '{lang: \"en\"|\"pt\"}', returns: '{lang}' },\n                { method: 'GET', path: 'profiles', summary: 'The sources (profiles): defaults per sender. Keys are never returned, only hasKey.', returns: '{profiles:{<source>:{enabled,icon,level,mode,duration,rate,sound,volume,theme,priority,allowSound,allowMode,allowUrgent,categories,hasKey}}, seen:{<source>:{categories,at,opened}}, max}' },\n                { method: 'POST', path: 'profiles', summary: 'Create, change or delete a source.', body: '{source, icon?, level?, mode?, duration?, sound?, volume?, theme?, priority?, allowSound?, allowMode?, allowUrgent? (false = what is set here wins over the request), categories? ({name:{mode?,sound?,volume?,duration?}}), rate? (per minute, 0 = no limit), enabled?, key? (\"\" clears), genKey? (true returns a new key once), delete?} or {source, opened:true} (the panel opened that sender: not new any more, nothing else changes)', returns: '{ok, source, profile, key?} or {ok, source, opened}' },\n                { method: 'GET', path: 'settings', summary: 'Quiet hours, grouping of repeats and strict mode.', returns: '{settings:{quiet:{enabled,from,to,allow},groupSeconds,strict,soundVolume,oneSound,bannerAsOverlay,soundDelayMs,overlayOpacity,defaultMode,bannerImageAsBar,overlayPosition:\"bottom\"|\"top\",overlayMotion,overlayDuration}}' },\n                { method: 'POST', path: 'settings', summary: 'Change those settings (send only what changes).', body: '{quiet?:{enabled,from:\"22:00\",to:\"07:00\",allow:\"alert\"|\"warn\"|\"none\"}, groupSeconds? (0 = off), strict? (true rejects unknown sources), soundVolume? (10-100 %, the volume of every sound, default 100), oneSound? (a sound name: every notification that has a sound plays this one instead; \"\" = off, the default), defaultMode? (a mode: the look of a request that names none; default banner), bannerImageAsBar? (true: a banner with a picture is shown as overlay; default false), bannerAsOverlay? (true: every banner is shown as overlay; both is not changed; default false), soundDelayMs? (0-10000, how long after the request the sound starts, default 3000), overlayOpacity? (20-100 %, how opaque the background of the overlay bar is, default 88)}', returns: '{ok, settings}' },\n                { method: 'GET', path: 'hooks', summary: 'The webhooks (templates that turn any JSON into a notification).', returns: '{hooks:{<name>:{title,message,level,icon,mode,duration,source,sound,volume}}, max, base}' },\n                { method: 'POST', path: 'hooks', summary: 'Create, change or delete a webhook.', body: '{name, message (template), title?, level?, icon?, mode?, duration?, sound? (a sound name), volume? (10-100), source?, delete?}; templates use {{a.b.0.c}} from the posted JSON', returns: '{ok, name, hook, url}' },\n                { method: 'POST', path: 'hook/<name>', summary: 'Send any JSON (up to 64 KB) to a webhook; its templates build the notification. Non-JSON bodies are available as {{text}}.', returns: 'same as notify' },\n                { method: 'POST', path: 'play', summary: 'Play one of the sounds without a notification, or a 10-second tune made of them (song). The sound volume setting applies. Answers 429 if another sound was played less than 0.8 s ago.', body: '{sound, volume?} or {song:\"rock\"|\"fate\"|\"stop\"}', returns: '{ok, sound:\"requested\"} or {ok, song:\"playing\"}' },\n                { method: 'POST', path: 'sound-upload?name=<name>', summary: 'Upload one of your own sounds: the raw bytes of a WAV (PCM 16 bit, mono or stereo, 8-48 kHz, at most 10 s and 1 MB) as the body. The name is 1-24 characters of a-z, 0-9 and -, and cannot be a built-in sound; at most 12. Then use the name as `sound`.', returns: '{ok, name, seconds}' },\n                { method: 'POST', path: 'sound-delete', summary: 'Delete one of your own sounds.', body: '{name}', returns: '{ok, deleted}' },\n                { method: 'POST', path: 'action?id=<id>', summary: 'Used by the full-screen card when the button of a notification is pressed: launches the app that notification named in `action` (404 if that notification has no button or is gone, 429 if used less than 2 s ago).', returns: '{ok, app}' },\n                { method: 'GET', path: 'themes', summary: 'The wallpaper themes: the built-in ones (sport, news) and your own (name to picture address).', returns: '{builtin:[...], custom:{name:url}, max}' },\n                { method: 'POST', path: 'themes', summary: 'Add or change one of your own themes, or delete it. Its name is 1-24 characters of a-z, 0-9 and -, not a built-in name; the address is http or https; at most 12. Then send theme:\"<name>\" (or give a source that default).', body: '{name, url} or {name, delete:true}', returns: '{ok, name, url} or {ok, deleted}' },\n                { method: 'GET', path: 'apps', summary: 'The apps shown on the TV, for the app id of an action button.', returns: '{apps:[{appId,name}]} (empty if Vetro does not answer)' },\n                { method: 'GET', path: 'export[?sounds=1][&keys=1]', summary: 'The setup of this Notification Center as one JSON file (settings, sources, webhooks); sounds=1 adds your own sounds, keys=1 adds the keys of the senders (keep that file private). Load it on another TV with POST import.', returns: 'a JSON file ({format, formatVersion, shard, exportedAt, settings, sources, webhooks, sounds})' },\n                { method: 'POST', path: 'import', summary: 'Load a setup file made by GET export: the settings are replaced, sources and webhooks of the same name are replaced and the others are kept, sounds are added. Everything is checked again; what cannot be used is listed in skipped.', body: 'the file, as it is', returns: '{ok, imported:{settings,sources,webhooks,sounds}, skipped:[...]}' },\n                { method: 'GET', path: 'sounds', summary: 'The sounds a request can choose, whether this Shard can play sounds (exec granted), the volume and timing settings, the timing of the last banner sound (trace) and the result of the last attempt.', returns: '{sounds:[...], songs:[{name,title}], available, volume, delayMs, trace, last}' },\n                { method: 'GET', path: 'emoji', summary: 'The bundled emoji list used by the icon picker.', returns: '{source, groups, list}' },\n                { method: 'GET', path: 'api', summary: 'This description.', returns: 'JSON' }\n            ],\n            docs: 'API.md in the Shard folder'\n        };\n    }\n\n    // Hands the queue to the banner service through a file (world-readable: the service runs as another user). Written before the service is launched.\n    // Written under a new name with 'wx' (fails if the name exists, never follows a planted symlink) and then renamed over the target,\n    // so a symlink left at the target path is replaced, not written through.\n    function writeQueueFile() {\n        var tmp = queueFile + '.' + process.pid + '.' + Date.now().toString(36) + '.tmp';\n        try {\n            fs.writeFileSync(tmp, JSON.stringify({ at: Date.now(), notifications: queue.map(function (n) {\n                return { id: n.id, title: n.title, message: n.message, level: n.level, mode: n.mode, duration: n.duration, icon: n.icon, expires: n.expires };\n            }) }), { mode: 420, flag: 'wx' });\n            fs.renameSync(tmp, queueFile);\n        } catch (e) {\n            try { fs.unlinkSync(tmp); } catch (e2) { /* nothing to remove */ }\n            /* /tmp not writable: the service falls back to asking the Shard over the network */\n        }\n    }\n\n    // An emoji or emoji sequence of at most MAX_ICON UTF-16 units. It is cut only between whole characters (never inside a surrogate pair) and never\n    // left ending on a joiner or variation selector that belonged to a sequence that did not fit.\n    function cleanIcon(v) {\n        var t = str(v).replace(/[\\x00-\\x1f]/g, '').replace(/^\\s+|\\s+$/g, ''), out = '', i = 0, step, c;\n        while (i < t.length) {\n            c = t.charCodeAt(i);\n            step = (c >= 0xD800 && c <= 0xDBFF && i + 1 < t.length) ? 2 : 1;\n            if (out.length + step > MAX_ICON) { break; }\n            out += t.substr(i, step);\n            i += step;\n        }\n        if (i < t.length) {\n            while (out.length && /[\\u200D\\uFE0F]$/.test(out)) { out = out.slice(0, -1); }\n        }\n        return out;\n    }\n\n    // A picture of a notification: an http(s) URL only.\n    function cleanUrl(u) { u = str(u).trim(); return /^https?:\\/\\/[^\\s\"'<>]{4,290}$/.test(u) ? u : ''; }\n\n    // ntfy-compatible publish: POST .../ntfy with the message as the body (headers Title, Priority, Tags) or JSON {message,title,priority,tags}.\n    var NTFY_TAGS = { warning: '\\u26A0\\uFE0F', rotating_light: '\\uD83D\\uDEA8', white_check_mark: '\\u2705', heavy_check_mark: '\\u2714\\uFE0F', tada: '\\uD83C\\uDF89',\n        fire: '\\uD83D\\uDD25', soccer: '\\u26BD', bell: '\\uD83D\\uDD14', skull: '\\uD83D\\uDC80', house: '\\uD83C\\uDFE0', package: '\\uD83D\\uDCE6', sunny: '\\u2600\\uFE0F' };\n    function handleNtfy(req, res) {\n        readBody(req, guard(res, function (raw) {\n            var b = {}, h = req.headers || {}, j = null, i, t;\n            if (/json/i.test(str(h['content-type']))) { try { j = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); } }\n            if (rules.isObj(j)) { b.message = j.message; b.title = j.title; } else { b.message = raw; j = null; }\n            b.title = b.title || h.title || h.t;\n            var p = j ? num(j.priority) : NaN, tags;\n            if (!(p >= 0)) { p = num(str(h.priority || h.p)); }\n            tags = j && j.tags != null ? j.tags : (h.tags || h.ta || '');\n            // Never loop over something the sender controls: only a real array, or a comma list, and at most 10 entries.\n            tags = (Array.isArray(tags) ? tags : str(tags).split(',')).slice(0, 10);\n            b.level = p >= 5 ? 'alert' : p === 4 ? 'warn' : 'info';\n            if (p >= 5) { b.priority = 'high'; }\n            for (i = 0; i < tags.length; i++) {\n                t = str(tags[i]).trim().toLowerCase();\n                if (has(NTFY_TAGS, t)) {\n                    b.icon = NTFY_TAGS[t];\n                    if (t === 'rotating_light' || t === 'skull') { b.level = 'alert'; }\n                    else if (t === 'warning' && b.level === 'info') { b.level = 'warn'; }\n                    else if ((t === 'white_check_mark' || t === 'heavy_check_mark' || t === 'tada') && b.level === 'info') { b.level = 'ok'; }\n                    break;\n                }\n            }\n            b.sound = j ? j.sound : h.sound; b.volume = j ? j.volume : h.volume;\n            submit(b, h, res);\n        }));\n    }\n\n    function handleNotify(req, res) {\n        readBody(req, guard(res, function (raw) {\n            var b;\n            try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\n            submit(b, req.headers || {}, res);\n        }));\n    }\n\n    // Play a sound without a notification (the panel's sound tests; any app can use it too). Only names from the closed list.\n    function handlePlay(req, res) {\n        readBodyG(req, res, function (raw) {\n            var b;\n            try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\n            b = rules.isObj(b) ? b : {};\n            if (b.song !== undefined) {\n                if (b.song === 'stop') { stopSong(); return sendJson(res, 200, { ok: true, song: 'stopped' }); }\n                if (!has(SONGS, b.song)) { return sendJson(res, 400, { error: 'song must be one of: ' + Object.keys(SONGS).join(', ') + ', stop' }); }\n                var played = playSong(b.song);\n                return sendJson(res, played === 'busy' ? 409 : 200, played === 'busy' ? { ok: false, error: 'a song is already playing (song: \"stop\" stops it)' } : { ok: true, song: played });\n            }\n            if (!rules.hasSound(b.sound)) { return sendJson(res, 400, { error: 'sound must be one of: ' + soundNames().join(', ') }); }\n            var st = playSound(b.sound, soundVolume(b.volume));\n            sendJson(res, st === 'skipped' ? 429 : 200, st === 'skipped' ? { ok: false, error: 'too soon: one sound every 0.8 s' } : { ok: true, sound: st });\n        });\n    }\n\n    // Webhook: POST hook/<name> with any JSON. The hook's templates turn it into a notification ({{a.b}} = that value of the posted JSON).\n    function handleHook(req, res, rawName) {\n        var name = rules.cleanHookName(rawName), hooks = cfgGet().hooks || {}, hook = name && has(hooks, name) ? hooks[name] : null;\n        if (!hook) { return sendJson(res, 404, { error: 'no such hook' }); }\n        readBody(req, guard(res, function (raw) {\n            var data;\n            try { data = JSON.parse(raw); } catch (e) { data = { text: raw }; }\n            if (!data || typeof data !== 'object') { data = { text: raw }; }\n            submit(rules.buildFromHook(hook, data), req.headers || {}, res, hook.source || name);\n        }), MAX_HOOK_BODY);\n    }\n\n    // What happened to a notification, kept with it in the recent list (GET recent, GET notify-status). Saved only when it changes.\n    function setStatus(id, status, reason) {\n        var i;\n        for (i = 0; i < recent.length; i++) {\n            if (recent[i].id !== id) { continue; }\n            if (recent[i].status !== status || recent[i].reason !== (reason || '')) { recent[i].status = status; recent[i].reason = reason || ''; saveRecent(); }\n            return;\n        }\n    }\n    function record(entry) { recent.unshift(entry); if (recent.length > MAX_RECENT) { recent.pop(); } saveRecent(); }\n    // A refused request of a known sender is logged once (a flood of them cannot push everything else out of the list).\n    function refuse(res, code, text, source, b, known) {\n        var last = recent[0];\n        if (known && !(last && last.status === 'rejected' && last.source === source && last.reason === text)) {\n            seq += 1;\n            record({ id: seq + '-' + Date.now().toString(36), title: clean(b.title, MAX_TITLE), message: clean(b.message, MAX_MESSAGE), level: 'info', source: source, category: rules.cleanCategory(b.category), status: 'rejected', reason: text, at: Date.now() });\n        }\n        if (code === 429 && res.setHeader) { res.setHeader('Retry-After', '60'); }\n        sendJson(res, code, code === 429 ? { error: text, reason: text, retryAfter: 60 } : { error: text, reason: text });\n        return null;\n    }\n    // Senders announce themselves by sending: the panel lists them with their categories. The configuration is only written for something new.\n    var seenAt = {};\n    function noteSeen(source, category) {\n        if (!source) { return; }\n        seenAt[source] = Date.now();\n        var seen = cfgGet().seen || {}, s = has(seen, source) ? seen[source] : null;\n        if (s && (!category || s.indexOf(category) >= 0 || s.length >= 12)) { return; }\n        if (!s && Object.keys(seen).length >= rules.MAX_SOURCES) { return; }\n        saveCfg(function (c) { c.seen = c.seen || {}; c.seen[source] = (has(c.seen, source) ? c.seen[source] : []).concat(category ? [category] : []); });\n    }\n    function seenSources() {\n        var seen = cfgGet().seen || {}, opened = cfgGet().opened || {}, list = {};\n        Object.keys(seen).forEach(function (k) {\n            var at = seenAt[k] || 0, i;\n            for (i = 0; i < recent.length && !at; i++) { if (recent[i].source === k) { at = recent[i].at; } }\n            list[k] = { categories: seen[k], at: at, opened: opened[k] === true };\n        });\n        return list;\n    }\n\n    // The one way into the queue: applies the source's profile (key, enabled, rate, defaults), then validates, then quiet hours and grouping.\n    // The checks every sender goes through before anything is queued or sent: strict mode, the source's on/off switch, key and rate limit, then its defaults.\n    // Answers the error itself and returns null, or returns {b, source, settings}.\n    function admit(b, headers, res, forcedSource) {\n        var settings = settingsNow(), profiles = cfgGet().profiles || {};\n        var source = forcedSource || rules.cleanSource(b.source || headers['x-nc-source']);\n        var profile = source && has(profiles, source) ? profiles[source] : null;\n        if (settings.strict && !profile) { return refuse(res, 403, source ? 'unknown source' : 'source is required', source, b, false); }\n        if (profile) {\n            if (profile.enabled === false) { return refuse(res, 403, 'source is disabled', source, b, true); }\n            if (profile.key && !rules.sameKey(headers['x-nc-key'] || b.key, profile.key)) { return refuse(res, 403, 'invalid key for this source', source, b, false); }\n            if (!limiter(source, profile.rate, Date.now())) { return refuse(res, 429, 'rate limit for this source', source, b, true); }\n        }\n        return { b: rules.applyProfile(b, profile), source: source, settings: settings };\n    }\n\n    // ---- wallpaper themes you can add ----\n    var THEME_NAME_RE = /^[a-z0-9][a-z0-9-]{0,23}$/, MAX_THEMES = 12;\n    function storedThemes() { var t = cfgGet().themes; return rules.isObj(t) ? t : {}; }\n    // Keeps rules.CUSTOM_THEMES in step with the configuration: only well-named themes with an http(s) address, never the name of a built-in one.\n    function loadThemes() {\n        var t = storedThemes();\n        Object.keys(rules.CUSTOM_THEMES).forEach(function (k) { delete rules.CUSTOM_THEMES[k]; });\n        Object.keys(t).forEach(function (n) {\n            if (THEME_NAME_RE.test(n) && !has(rules.THEMES, n) && cleanUrl(t[n]) && Object.keys(rules.CUSTOM_THEMES).length < MAX_THEMES) { rules.CUSTOM_THEMES[n] = 1; }\n        });\n    }\n    function themeNames() { return Object.keys(rules.THEMES).concat(Object.keys(rules.CUSTOM_THEMES)); }\n    function customThemes() { var t = storedThemes(), out = {}; Object.keys(rules.CUSTOM_THEMES).forEach(function (n) { out[n] = cleanUrl(t[n]); }); return out; }\n    // The wallpaper a theme stands for: a built-in one is served by the Shard (theme:name), an own one is the address the user gave.\n    function themeWallpaper(name) {\n        if (has(rules.THEMES, name)) { return 'theme:' + name; }\n        return has(rules.CUSTOM_THEMES, name) ? cleanUrl(storedThemes()[name]) : '';\n    }\n    function handleThemes(req, res) {\n        if (req.method === 'GET') { return sendJson(res, 200, { builtin: Object.keys(rules.THEMES), custom: customThemes(), max: MAX_THEMES }); }\n        readBodyG(req, res, function (raw) {\n            var b;\n            try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\n            b = rules.isObj(b) ? b : {};\n            var name = str(b.name).trim();\n            if (!THEME_NAME_RE.test(name) || has(rules.THEMES, name)) { return sendJson(res, 400, { error: 'name: 1-24 characters, a-z, 0-9 and -, and not the name of a built-in theme' }); }\n            if (b.delete === true) {\n                if (!has(rules.CUSTOM_THEMES, name)) { return sendJson(res, 404, { error: 'no theme with that name' }); }\n                saveCfg(function (c) { if (rules.isObj(c.themes)) { delete c.themes[name]; } });\n                loadThemes();\n                return sendJson(res, 200, { ok: true, deleted: name });\n            }\n            var url = cleanUrl(b.url);\n            if (!url) { return sendJson(res, 400, { error: 'url must be an http or https address of a picture (up to 290 characters)' }); }\n            if (!has(rules.CUSTOM_THEMES, name) && Object.keys(rules.CUSTOM_THEMES).length >= MAX_THEMES) { return sendJson(res, 400, { error: 'at most ' + MAX_THEMES + ' own themes: delete one first' }); }\n            saveCfg(function (c) { c.themes = rules.isObj(c.themes) ? c.themes : {}; c.themes[name] = url; });\n            loadThemes();\n            sendJson(res, 200, { ok: true, name: name, url: url });\n        });\n    }\n\n    // ---- copy the setup to another TV ----\n    // GET export gives one JSON file with the settings, the sources, the webhooks and (only if asked) the own sounds and the sender keys;\n    // POST import reads such a file back through the same checks as every other route (nothing is trusted: each part is sanitised again).\n    var SETUP_FORMAT = 'notification-center-setup', MAX_SETUP_BYTES = 12582912;\n    function handleExport(req, res) {\n        var q = String(req.url || ''), withKeys = /[?&]keys=1(&|$)/.test(q), withSounds = /[?&]sounds=1(&|$)/.test(q), c = cfgGet(), ver = '';\n        try { ver = require('./manifest.json').version; } catch (e) { /* manifest not readable */ }\n        var out = { format: SETUP_FORMAT, formatVersion: 1, shard: ver, exportedAt: new Date().toISOString(), keysIncluded: withKeys, settings: settingsNow(), sources: {}, webhooks: c.hooks || {}, themes: customThemes(), sounds: {} };\n        Object.keys(c.profiles || {}).forEach(function (k) {\n            var p = c.profiles[k], pub = rules.publicProfile(p);\n            delete pub.hasKey;\n            if (withKeys && p && p.key) { pub.key = p.key; }\n            out.sources[k] = pub;\n        });\n        if (withSounds) {\n            Object.keys(rules.CUSTOM).forEach(function (n) { try { out.sounds[n] = fs.readFileSync(customDir() + '/' + n + '.wav').toString('base64'); } catch (e) { /* gone: left out */ } });\n        }\n        var body = JSON.stringify(out, null, 1);\n        res.writeHead(200, { 'Content-Type': 'application/json; charset=utf-8', 'Content-Disposition': 'attachment; filename=\"notification-center-setup.json\"', 'Cache-Control': 'no-store', 'X-Content-Type-Options': 'nosniff' });\n        res.end(body);\n    }\n    function handleImport(req, res) {\n        readBinary(req, res, function (buf) {\n            var d;\n            try { d = JSON.parse(buf.toString('utf8')); } catch (e) { return sendJson(res, 400, { error: 'not a JSON file' }); }\n            if (!rules.isObj(d) || d.format !== SETUP_FORMAT || d.formatVersion !== 1) { return sendJson(res, 400, { error: 'not a Notification Center setup file' }); }\n            var skipped = [], done = { settings: false, sources: 0, webhooks: 0, sounds: 0, themes: 0 };\n            function short(v) { return str(v).replace(/[^A-Za-z0-9 ._-]/g, '?').slice(0, 32); }\n            // Sounds first, so that sources and webhooks can use them.\n            if (rules.isObj(d.sounds)) {\n                Object.keys(d.sounds).forEach(function (name) {\n                    var wb;\n                    if (!CUSTOM_NAME_RE.test(name) || has(SOUND_FILES, name) || typeof d.sounds[name] !== 'string') { skipped.push('sound ' + short(name)); return; }\n                    if (!has(rules.CUSTOM, name) && Object.keys(rules.CUSTOM).length >= MAX_CUSTOM) { skipped.push('sound ' + name + ' (too many sounds)'); return; }\n                    wb = new Buffer(d.sounds[name], 'base64');\n                    if (!wavInfo(wb)) { skipped.push('sound ' + name + ' (not a WAV the TV can play)'); return; }\n                    try { fs.mkdirSync(customDir()); } catch (e) { /* exists */ }\n                    if (!putFile(customDir() + '/' + name + '.wav', wb)) { skipped.push('sound ' + name + ' (could not save)'); return; }\n                    loadCustom(); done.sounds += 1;\n                });\n            }\n            saveCfg(function (c) {\n                if (rules.isObj(d.themes)) {\n                    c.themes = rules.isObj(c.themes) ? c.themes : {};\n                    Object.keys(d.themes).forEach(function (n) {\n                        var u = cleanUrl(d.themes[n]);\n                        if (!THEME_NAME_RE.test(n) || has(rules.THEMES, n) || !u) { skipped.push('theme ' + short(n)); return; }\n                        if (!has(c.themes, n) && Object.keys(c.themes).length >= MAX_THEMES) { skipped.push('theme ' + n + ' (too many themes)'); return; }\n                        c.themes[n] = u; done.themes += 1;\n                    });\n                }\n                if (rules.isObj(d.settings)) { c.settings = rules.sanitizeSettings(d.settings, c.settings); done.settings = true; }\n                var ps = c.profiles = c.profiles || {}, hs = c.hooks = c.hooks || {};\n                if (rules.isObj(d.sources)) {\n                    Object.keys(d.sources).forEach(function (k) {\n                        var name = rules.cleanSource(k), s;\n                        if (!name) { skipped.push('source ' + short(k)); return; }\n                        if (!has(ps, name) && Object.keys(ps).length >= rules.MAX_SOURCES) { skipped.push('source ' + name + ' (too many sources)'); return; }\n                        s = rules.sanitizeProfile(d.sources[k], cleanIcon, has(ps, name) ? ps[name] : {});\n                        if (s.error) { delete s.error; }   // an invalid key in the file is ignored: the source keeps the key it has (or none)\n                        ps[name] = s; done.sources += 1;\n                    });\n                }\n                if (rules.isObj(d.webhooks)) {\n                    Object.keys(d.webhooks).forEach(function (k) {\n                        var name = rules.cleanHookName(k), h;\n                        if (!name) { skipped.push('webhook ' + short(k)); return; }\n                        if (!has(hs, name) && Object.keys(hs).length >= rules.MAX_HOOKS) { skipped.push('webhook ' + name + ' (too many webhooks)'); return; }\n                        h = rules.sanitizeHook(d.webhooks[k]);\n                        if (!h.message) { skipped.push('webhook ' + name + ' (no message template)'); return; }\n                        hs[name] = h; done.webhooks += 1;\n                    });\n                }\n            });\n            loadThemes();   // the themes just imported can be used by the sources imported in the same file\n            sendJson(res, 200, { ok: true, imported: done, skipped: skipped.slice(0, 50) });\n        }, MAX_SETUP_BYTES);\n    }\n\n    // A high-priority notification goes to the front, the others to the back. When the queue is full the oldest normal one is dropped (the last one if all are high).\n    function enqueue(note) {\n        if (note.priority === 'high') { queue.unshift(note); } else { queue.push(note); }\n        while (queue.length > MAX_QUEUE) {\n            var i, drop = -1;\n            for (i = 0; i < queue.length; i++) { if (queue[i].priority !== 'high') { drop = i; break; } }\n            setStatus(queue.splice(drop < 0 ? queue.length - 1 : drop, 1)[0].id, 'dropped', 'queue full');\n        }\n    }\n    // The button on the full-screen card: the id of an app installed on the TV (a plain id) and a short label. Nothing else is kept.\n    function cleanAction(v) {\n        if (!rules.isObj(v)) { return null; }\n        var app = str(v.app);\n        if (!/^[A-Za-z0-9._-]{1,64}$/.test(app)) { return null; }\n        return { app: app, label: clean(v.label, 24) || 'Open' };\n    }\n    // POST action?id=<id>: the user pressed the button of a notification on the card. The Shard launches the app that notification named (never one the request names now).\n    var lastAction = 0;\n    function handleAction(req, res) {\n        var m = /[?&]id=([^&]+)/.exec(String(req.url || '')), id = '', note = null, i;\n        try { id = m ? decodeURIComponent(m[1]) : ''; } catch (e) { id = ''; }\n        for (i = 0; i < queue.length; i++) { if (queue[i].id === id) { note = queue[i]; } }\n        if (!note || !note.action) { return sendJson(res, 404, { ok: false, error: 'no button for that notification' }); }\n        var now = Date.now();\n        if (now - lastAction < MIN_RELAUNCH_MS) { return sendJson(res, 429, { ok: false, error: 'too soon' }); }\n        lastAction = now;\n        var body = JSON.stringify({ appId: note.action.app });\n        try {\n            var rq = http.request({ host: VHOST, port: VPORT, path: '/apps/launch', method: 'POST', timeout: 5000, headers: { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(body) } }, function (r) { r.resume(); });\n            rq.on('error', function () { /* Vetro busy or no such app */ });\n            rq.setTimeout(5000);\n            rq.on('timeout', function () { rq.destroy(); });\n            rq.write(body);\n            rq.end();\n        } catch (e) { return sendJson(res, 502, { ok: false, error: 'could not reach Vetro' }); }\n        sendJson(res, 200, { ok: true, app: note.action.app });\n    }\n\n    function submit(b, headers, res, forcedSource) {\n        b = rules.isObj(b) ? b : {};\n        {\n            var adm = admit(b, headers, res, forcedSource);\n            if (!adm) { return; }\n            b = adm.b;\n            var settings = adm.settings, source = adm.source;\n            var message = clean(b.message, MAX_MESSAGE);\n            if (!message) { return sendJson(res, 400, { error: 'message is required' }); }\n            var secs = num(b.seconds);\n            if (!(secs >= MIN_SECONDS)) { secs = DEFAULT_SECONDS; }\n            if (secs > MAX_SECONDS) { secs = MAX_SECONDS; }\n            // A request without a look takes the setting defaultMode. The panel cannot take the remote, so one with a button is the full-screen card.\n            // A banner becomes the bar when the setting bannerAsOverlay is on, or bannerImageAsBar and it has a picture; only when the bar can be drawn.\n            var image = cleanUrl(b.image) || appIconUrl(b.app), image2 = cleanUrl(b.image2);\n            var mode = has(MODES, b.mode) ? b.mode : settings.defaultMode;\n            if (mode === 'panel' && cleanAction(b.action)) { mode = 'full'; }\n            if (mode === 'banner' && overlayAvailable() && (settings.bannerAsOverlay || (settings.bannerImageAsBar && (image || image2) && overlayInstall()))) { mode = 'overlay'; }\n            // duration = how long the notification stays on the TV screen (the app shows it, then returns to the previous app). The bar has its own default.\n            var dur = num(b.duration);\n            if (!(dur >= MIN_DURATION)) { dur = has(BARS, mode) ? settings.overlayDuration : DEFAULT_DURATION; }\n            if (dur > MAX_DURATION) { dur = MAX_DURATION; }\n            if (secs < dur + 20) { secs = dur + 20; }\n            // ttl: after this many seconds the notification is old news and is not shown any more.\n            var ttl = num(b.ttl);\n            if (ttl >= 1) { secs = ttl > 3600 ? 3600 : ttl; }\n            var category = rules.cleanCategory(b.category);\n            noteSeen(source, category);\n            prune();\n            seq += 1;\n            var note = {\n                id: seq + '-' + Date.now().toString(36),\n                title: clean(b.title, MAX_TITLE),\n                icon: cleanIcon(b.icon),\n                image: image,\n                image2: image2,\n                wallpaper: cleanUrl(b.wallpaper) || themeWallpaper(b.theme),\n                theme: rules.hasTheme(b.theme) ? b.theme : '',\n                priority: b.priority === 'high' ? 'high' : '',\n                action: cleanAction(b.action),\n                message: message,\n                level: has(LEVELS, b.level) ? b.level : 'info',\n                mode: mode,\n                duration: dur,\n                source: source,\n                category: category,\n                replace: clean(b.replace, 40),\n                sound: !rules.hasSound(b.sound) ? '' : (rules.hasSound(settings.oneSound) ? settings.oneSound : b.sound),\n                volume: soundVolume(b.volume),\n                expires: Date.now() + secs * 1000\n            };\n            var entry = { id: note.id, title: note.title, message: note.message, level: note.level, mode: note.mode, duration: note.duration, icon: note.icon, image: note.image, image2: note.image2, wallpaper: note.wallpaper, theme: note.theme, priority: note.priority, action: note.action ? note.action.label : '', source: source, category: category, status: 'queued', reason: '', sound: note.sound, volume: note.volume, at: Date.now() };\n            var effective = { mode: note.mode, sound: note.sound, volume: note.volume || 100, duration: note.duration };\n            // Quiet hours: below the allowed level the notification is only recorded, never shown.\n            if (note.priority !== 'high' && rules.isQuiet(settings, note.level, new Date())) {\n                entry.suppressed = true; entry.status = 'suppressed'; entry.reason = 'quiet hours';\n                record(entry);\n                return sendJson(res, 200, { ok: true, id: note.id, status: 'suppressed', reason: 'quiet hours', suppressed: 'quiet hours', effective: effective });\n            }\n            // Full: say so instead of accepting a notification that would never be shown.\n            var isOverlay = has(BARS, note.mode);\n            if (isOverlay ? barFull(note) : (note.priority !== 'high' && queue.length >= MAX_QUEUE && queue.every(function (n) { return n.priority === 'high'; }))) {\n                entry.status = 'rejected'; entry.reason = 'queue full';\n                record(entry);\n                if (res.setHeader) { res.setHeader('Retry-After', '10'); }\n                return sendJson(res, 429, { ok: false, id: note.id, error: 'queue full', reason: 'queue full', retryAfter: 10 });\n            }\n            // Grouping: the same source, title, message and level within the window is counted, not shown again. It is skipped when it is off\n            // (groupSeconds 0) and for a request that says group:false (the panel's Resend and test buttons). The map only holds entries younger than the window.\n            if (settings.groupSeconds && b.group !== false && !note.replace && note.priority !== 'high') {\n                var sig = [source, note.title, note.message, note.level].join(String.fromCharCode(1)), nowMs = Date.now(), g = has(groups, sig) ? groups[sig] : null, r;\n                if (g && nowMs - g.at < settings.groupSeconds * 1000) {\n                    g.count += 1;\n                    for (r = 0; r < recent.length; r++) { if (recent[r].id === g.id) { recent[r].count = g.count; } }\n                    saveRecent();\n                    return sendJson(res, 200, { ok: true, id: g.id, status: 'merged', reason: 'repeat', merged: true, count: g.count, effective: effective });\n                }\n                groups[sig] = { at: nowMs, id: note.id, count: 1 };\n                pruneGroups(nowMs, settings.groupSeconds * 1000);\n            }\n            // The overlay bar is drawn by the Shard's own helper, so it never goes through the queue the app and the banner service read.\n            record(entry);\n            if (!isOverlay) {\n                if (note.replace) { queue = queue.filter(function (n) { if (sameSlot(n, note)) { setStatus(n.id, 'replaced'); return false; } return true; }); }\n                enqueue(note);\n                writeQueueFile();\n            }\n            var opened = b.open === false ? 'not requested' : (isOverlay ? overlayShow(note) : openApp(note.mode === 'banner', note.id));\n            if (isOverlay && (opened === 'error' || opened === 'unavailable')) { setStatus(note.id, 'failed', 'the bar is not available'); }\n            // The sound is asked for only now: not for a notification held back by quiet hours or merged as a repeat. The overlay bar appears within a second, so its sound plays at once.\n            var soundState = 'none';\n            if (note.sound) {\n                if (b.open === false || soundWaitMs <= 0 || isOverlay) { soundState = playSound(note.sound, note.volume); } else { soundState = scheduleSound(note) ? 'requested' : 'skipped'; }\n            }\n            // \"shown\" only where the Shard knows it: the bar that starts now. A launch or a start that fails later changes the status in the log.\n            var status = entry.status === 'failed' ? 'failed' : (isOverlay && opened === 'requested' ? 'shown' : 'queued');\n            sendJson(res, 200, { ok: true, id: note.id, status: status, reason: entry.reason, effective: effective, open: opened, sound: soundState });\n        }\n    }\n\n    // Sources (profiles), settings (quiet hours, grouping, strict) and webhooks are kept in ctx.config. Keys are never returned.\n    function saveCfg(mut) { var c = cfgGet(); mut(c); ctx.config.set(c); }\n    function handleProfiles(req, res) {\n        if (req.method === 'GET') {\n            var out = {}, ps = cfgGet().profiles || {};\n            Object.keys(ps).forEach(function (k) { out[k] = rules.publicProfile(ps[k]); });\n            return sendJson(res, 200, { profiles: out, seen: seenSources(), max: rules.MAX_SOURCES });\n        }\n        readBodyG(req, res, function (raw) {\n            var b, source, ps, p, genKey = '';\n            try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\n            source = rules.cleanSource(b && b.source);\n            if (!source) { return sendJson(res, 400, { error: 'source must be 1-32 characters: a-z, 0-9, . _ -' }); }\n            ps = cfgGet().profiles || {};\n            if (b.delete === true) { saveCfg(function (c) { c.profiles = c.profiles || {}; delete c.profiles[source]; if (c.seen) { delete c.seen[source]; } if (c.opened) { delete c.opened[source]; } }); delete seenAt[source]; return sendJson(res, 200, { ok: true, deleted: source }); }\n            // {source, opened:true}: only remembers that the panel opened a sender that announced itself; no profile is made or changed.\n            if (b.opened === true) {\n                var known = has(cfgGet().seen || {}, source);\n                if (known && !has(cfgGet().opened || {}, source)) { saveCfg(function (c) { c.opened = c.opened || {}; c.opened[source] = true; }); }\n                return sendJson(res, 200, { ok: true, source: source, opened: known });\n            }\n            if (!has(ps, source) && Object.keys(ps).length >= rules.MAX_SOURCES) { return sendJson(res, 400, { error: 'at most ' + rules.MAX_SOURCES + ' sources' }); }\n            if (b.genKey === true) { genKey = require('crypto').randomBytes(16).toString('hex'); b.key = genKey; }\n            p = rules.sanitizeProfile(b, cleanIcon, has(ps, source) ? ps[source] : null);\n            if (p.error) { return sendJson(res, 400, { error: p.error }); }\n            saveCfg(function (c) { c.profiles = c.profiles || {}; c.profiles[source] = p; });\n            sendJson(res, 200, genKey ? { ok: true, source: source, profile: rules.publicProfile(p), key: genKey } : { ok: true, source: source, profile: rules.publicProfile(p) });\n        });\n    }\n    function handleSettings(req, res) {\n        if (req.method === 'GET') { return sendJson(res, 200, { settings: settingsNow() }); }\n        readBodyG(req, res, function (raw) {\n            var b;\n            try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\n            var s = rules.sanitizeSettings(b && b.settings || b, settingsNow());\n            saveCfg(function (c) { c.settings = s; });\n            sendJson(res, 200, { ok: true, settings: s });\n        });\n    }\n    function handleHooks(req, res) {\n        if (req.method === 'GET') { return sendJson(res, 200, { hooks: cfgGet().hooks || {}, max: rules.MAX_HOOKS, base: 'hook/<name>' }); }\n        readBodyG(req, res, function (raw) {\n            var b, name, hs;\n            try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\n            name = rules.cleanHookName(b && b.name);\n            if (!name) { return sendJson(res, 400, { error: 'name must be 1-24 characters: a-z, 0-9, -' }); }\n            hs = cfgGet().hooks || {};\n            if (b.delete === true) { saveCfg(function (c) { c.hooks = c.hooks || {}; delete c.hooks[name]; }); return sendJson(res, 200, { ok: true, deleted: name }); }\n            if (!has(hs, name) && Object.keys(hs).length >= rules.MAX_HOOKS) { return sendJson(res, 400, { error: 'at most ' + rules.MAX_HOOKS + ' hooks' }); }\n            var h = rules.sanitizeHook(b);\n            if (!h.message) { return sendJson(res, 400, { error: 'message template is required' }); }\n            saveCfg(function (c) { c.hooks = c.hooks || {}; c.hooks[name] = h; });\n            sendJson(res, 200, { ok: true, name: name, hook: h, url: 'hook/' + name });\n        });\n    }\n\n    function sendFile(res, name, type) {\n        fs.readFile(path.join(__dirname, name), 'utf8', function (err, text) {\n            if (err) { return sendJson(res, 500, { error: name + ' is missing' }); }\n            send(res, 200, type, text);\n        });\n    }\n\n    return {\n        start: function () { loadCustom(); loadThemes(); },\n        stop: function () { abortFetches(); cancelSounds(); stopSong(); barStop(); queue = []; writeQueueFile(); },\n        status: function () { prune(); return { queued: queue.length, appId: appId() }; },\n        route: function (req, res, sub) {\n            sub = String(sub || '').split('?')[0].replace(/^\\/+|\\/+$/g, '');\n            try {\n            if (sub === 'ui' && req.method === 'GET') { sendFile(res, 'ui.html', 'text/html; charset=utf-8'); return true; }\n            if (sub === 'api' && req.method === 'GET') { sendJson(res, 200, describe()); return true; }\n            if (sub === 'status' && req.method === 'GET') { statusInfo(function (o) { sendJson(res, 200, o); }); return true; }\n            if (sub === 'service-report' && req.method === 'POST') { handleServiceReport(req, res); return true; }\n            if (sub === 'img' && req.method === 'GET') { mark('img', req); serveImage(req, res); return true; }\n            if (sub === 'ntfy' && req.method === 'POST') { handleNtfy(req, res); return true; }\n            if (sub === 'play' && req.method === 'POST') { handlePlay(req, res); return true; }\n            if (sub === 'themes' && (req.method === 'GET' || req.method === 'POST')) { handleThemes(req, res); return true; }\n            if (sub === 'action' && req.method === 'POST') { handleAction(req, res); return true; }\n            if (sub === 'apps' && req.method === 'GET') { handleApps(res); return true; }\n            if (sub === 'export' && req.method === 'GET') { handleExport(req, res); return true; }\n            if (sub === 'import' && req.method === 'POST') { handleImport(req, res); return true; }\n            if (sub === 'sound-upload' && req.method === 'POST') { handleSoundUpload(req, res); return true; }\n            if (sub === 'sound-delete' && req.method === 'POST') { handleSoundDelete(req, res); return true; }\n            if (sub === 'sounds' && req.method === 'GET') { sendJson(res, 200, { sounds: soundNames(), custom: Object.keys(rules.CUSTOM), songs: Object.keys(SONGS).map(function (k) { return { name: k, title: SONGS[k].title }; }), available: soundAvailable(), volume: settingsNow().soundVolume, delayMs: settingsNow().soundDelayMs, trace: soundTrace, last: soundLast }); return true; }\n            if (sub === 'profiles' && (req.method === 'GET' || req.method === 'POST')) { handleProfiles(req, res); return true; }\n            if (sub === 'settings' && (req.method === 'GET' || req.method === 'POST')) { handleSettings(req, res); return true; }\n            if (sub === 'hooks' && (req.method === 'GET' || req.method === 'POST')) { handleHooks(req, res); return true; }\n            if (/^hook\\/[^\\/]+$/.test(sub) && req.method === 'POST') { handleHook(req, res, sub.slice(5)); return true; }\n            if (sub === 'emoji' && req.method === 'GET') { sendFile(res, 'emoji.json', 'application/json; charset=utf-8'); return true; }\n            if (sub === 'nt.js' && req.method === 'GET') { mark('ntjs', req); sendFile(res, 'nt.js', 'application/javascript; charset=utf-8'); return true; }\n            if (sub === 'notify' && req.method === 'POST') { handleNotify(req, res); return true; }\n            if (sub === 'notifications' && req.method === 'GET') {\n                if (/[?&]src=app(&|$)/.test(String(req.url || ''))) {\n                    mark('poll', req);\n                    queue.forEach(function (n) { if (n.mode !== 'banner') { setStatus(n.id, 'shown'); } });\n                    appPoll = /[?&]bye=1(&|$)/.test(String(req.url || '')) ? 0 : Date.now();\n                    if (appPoll) { queue.forEach(function (n) { if (n.mode !== 'banner' && has(waitingSounds, n.id)) { waitingSounds[n.id].fire(); } }); }\n                }\n                prune();\n                var now = Date.now();\n                var out = { lang: getLang(), notifications: queue.map(function (n) {\n                    return { id: n.id, title: n.title, message: n.message, level: n.level, mode: n.mode, duration: n.duration, icon: n.icon, image: n.image, image2: n.image2, wallpaper: n.wallpaper, priority: n.priority, svc: n.mode === 'banner' && serviceHas(n.id), action: n.action ? { label: n.action.label } : null, seconds: Math.ceil((n.expires - now) / 1000) };\n                }) };\n                if (wantsScript(req)) { sendScript(res, out); } else { sendJson(res, 200, out); }\n                return true;\n            }\n            if (sub === 'lang' && req.method === 'GET') { sendJson(res, 200, { lang: getLang() }); return true; }\n            if (sub === 'lang' && req.method === 'POST') {\n                readBodyG(req, res, function (raw) {\n                    var b;\n                    try { b = JSON.parse(raw); } catch (e) { return sendJson(res, 400, { error: 'invalid JSON' }); }\n                    if (!b || (b.lang !== 'en' && b.lang !== 'pt')) { return sendJson(res, 400, { error: 'lang must be en or pt' }); }\n                    var c = ctx.config.get() || {};\n                    c.lang = b.lang;\n                    ctx.config.set(c);\n                    sendJson(res, 200, { lang: b.lang });\n                });\n                return true;\n            }\n            if (sub === 'notify-status' && req.method === 'GET') {\n                var want = /[?&]id=([0-9a-z-]+)/.exec(String(req.url || '')), found = want ? recent.filter(function (r) { return r.id === want[1]; })[0] : null;\n                sendJson(res, found ? 200 : 404, found ? { ok: true, id: found.id, status: found.status || 'queued', reason: found.reason || '', source: found.source || '', category: found.category || '' } : { ok: false, error: 'unknown id (only the last ' + MAX_RECENT + ' are kept)' });\n                return true;\n            }\n            if (sub === 'recent' && req.method === 'GET') { sendJson(res, 200, { recent: recent }); return true; }\n            return false;\n            } catch (e) { try { sendJson(res, 500, { error: 'internal error' }); } catch (e2) { /* the answer was already sent */ } return true; }\n        }\n    };\n};\n","nt.js":"// Logic of the companion web app, served by the Shard (the app on the TV is only a thin loader, see README).\n// It runs inside the app, with the app's `notification` privilege. Plain ES5.\n(function () {\n  'use strict';\n  if (window.__ncLoaded) { return; }\n  window.__ncLoaded = true;\n\n  var BASES = ['http://127.0.0.1:8099'];\n  // Also try the address this script was loaded from (the loader may have reached the Shard over the LAN).\n  try {\n    var me = document.currentScript && document.currentScript.src, o = me && /^(https?:\\/\\/[^\\/]+)\\/plugins\\//.exec(me);\n    if (o && BASES.indexOf(o[1]) < 0) { BASES.push(o[1]); }\n  } catch (e) { /* ignore */ }\n  var NOTES_PATH = '/plugins/notification-center/api/notifications';\n  var SEEN_KEY = 'nc_seen', WATCH_MS = 2000;\n  var logEl = document.getElementById('log');\n  var apiGood = null, busy = false;\n\n\n  // Screen shown while the app is open: a One UI style card (EN/PT by the TV language). The banner itself is the TV's native one.\n  // The language is a Shard setting (default English); it is applied as soon as the first answer from the Shard arrives.\n  var DICT = {\n    en: { wait: 'Notification Center', ready: 'Waiting for notifications', sent: 'Notification sent', dismiss: 'Dismiss', back: 'Returning to the previous app in', err: 'Cannot reach the Shard' },\n    pt: { wait: 'Centro de Notifica\\u00E7\\u00F5es', ready: '\\u00C0 espera de avisos', sent: 'Aviso enviado', dismiss: 'Fechar', back: 'A voltar \\u00E0 aplica\\u00E7\\u00E3o anterior em', err: 'Sem liga\\u00E7\\u00E3o ao Shard' }\n  };\n  var TX = DICT.en;\n  var EMO = { info: '\\u2139\\uFE0F', ok: '\\u2705', warn: '\\u26A0\\uFE0F', alert: '\\uD83D\\uDD34' };\n  var COL = { info: '#2f7bff', ok: '#2fc28b', warn: '#f5a524', alert: '#f0506e' };\n  // One UI style line icons (24x24, round caps): info, done, warning, alert.\n  var ICON_BODY = {\n    info: '<circle cx=\"12\" cy=\"12\" r=\"9.5\"/><path d=\"M12 11v6\"/><circle cx=\"12\" cy=\"7.6\" r=\"0.6\" fill=\"#fff\"/>',\n    ok: '<circle cx=\"12\" cy=\"12\" r=\"9.5\"/><path d=\"M7.6 12.6l3 3 5.8-6.4\"/>',\n    warn: '<path d=\"M12 3.8L21.2 20H2.8z\"/><path d=\"M12 10v4.6\"/><circle cx=\"12\" cy=\"17.4\" r=\"0.6\" fill=\"#fff\"/>',\n    alert: '<circle cx=\"12\" cy=\"12\" r=\"9.5\"/><path d=\"M12 7v6\"/><circle cx=\"12\" cy=\"16.6\" r=\"0.6\" fill=\"#fff\"/>'\n  };\n  function iconSvg(level, size) {\n    return '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"' + size + '\" height=\"' + size + '\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\">' + (ICON_BODY[level] || ICON_BODY.info) + '</svg>';\n  }\n  var cardEl = null, actBtns = [], actIdx = 0;\n  (function buildUi() {\n    var st = document.createElement('style');\n    st.textContent = 'body{margin:0;background:radial-gradient(circle at 30% 20%,#17203a,#07090f);color:#eef2f9;font-family:SamsungOne,\"Segoe UI\",sans-serif}' +\n      '#nc{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);width:1100px;max-width:90%;text-align:center}' +\n      '#nc h1{font-size:44px;font-weight:600;margin:0 0 8px}#nc p{font-size:28px;color:#8b96ab;margin:0 0 40px}' +\n      '#nc .card{display:flex;gap:28px;align-items:center;text-align:left;background:rgba(255,255,255,.08);border-radius:36px;padding:34px 42px;border-left:12px solid var(--c);margin-top:24px}' +\n      '#nc .ic{width:96px;height:96px;border-radius:50%;background:var(--c);display:grid;place-items:center;flex:none}' +\n      '#nc .t{font-size:38px;font-weight:600}#nc .m{font-size:30px;color:#c4cde0;margin-top:6px}#log{display:none}#nc .acts{display:flex;gap:18px;margin-top:22px}#nc .act{font:inherit;font-size:30px;padding:14px 36px;border-radius:18px;border:3px solid #3a4560;background:rgba(255,255,255,.08);color:#fff}#nc .act:focus{border-color:#5b9bff;background:rgba(61,139,255,.28);outline:none}';\n    document.head.appendChild(st);\n    cardEl = document.createElement('div'); cardEl.id = 'nc';\n    cardEl.innerHTML = '<h1></h1><p></p><div id=\"ncl\"></div>';\n    document.body.appendChild(cardEl);\n    applyLang('en');\n  })();\n  function applyLang(l) {\n    TX = DICT[l] || DICT.en;\n    if (!cardEl) { return; }\n    cardEl.getElementsByTagName('h1')[0].textContent = '\\uD83D\\uDD14 ' + TX.wait;\n    if (!document.getElementById('ncl').firstChild) { cardEl.getElementsByTagName('p')[0].textContent = TX.ready; }\n  }\n  function showCard(n) {\n    if (!cardEl) { return; }\n    var c = COL[n.level] || COL.info, d = document.createElement('div');\n    d.className = 'card'; d.style.setProperty('--c', c);\n    var ic = document.createElement('div'); ic.className = 'ic'; if (n.icon) { ic.textContent = n.icon; ic.style.fontSize = '48px'; } else { ic.innerHTML = iconSvg(n.level, 56); }\n    var b = document.createElement('div'), t = document.createElement('div'), m = document.createElement('div');\n    t.className = 't'; t.textContent = n.title || ''; m.className = 'm'; m.textContent = n.message || '';\n    b.appendChild(t); b.appendChild(m);\n    // Optional pictures (for example two club logos): the Shard fetches them and serves them from its own address (the app may only load declared origins).\n    if (n.image && n.image2) {\n      var pair = document.createElement('div');\n      pair.style.cssText = 'display:flex;align-items:center';\n      pair.appendChild(picture(n, '', 'max-width:360px;margin-right:48px'));\n      pair.appendChild(picture(n, 'image2', 'max-width:360px'));\n      b.appendChild(pair);\n    } else if (n.image || n.image2) {\n      b.appendChild(picture(n, n.image ? '' : 'image2', 'max-width:100%'));\n    }\n    if (n.wallpaper) {   // optional full-screen wallpaper behind the card, darkened so the text stays readable\n      var wsrc = (apiGood || BASES[0]) + '/plugins/notification-center/api/img?kind=wallpaper&id=' + encodeURIComponent(n.id), pre = new Image();\n      pre.onload = function () { document.body.style.background = 'linear-gradient(rgba(7,9,15,.5),rgba(7,9,15,.72)), url(\"' + wsrc + '\") center / cover no-repeat fixed'; };\n      pre.src = wsrc;\n    }\n    if (n.action && n.action.label) {   // a button that opens an app, and a Dismiss button; Left and Right move between them, OK presses\n      var row = document.createElement('div'), go = mkBtn(n.action.label, function () { runAction(n); }), no = mkBtn(TX.dismiss, leave);\n      row.className = 'acts'; row.appendChild(go); row.appendChild(no); b.appendChild(row);\n      actBtns = [go, no]; actIdx = 0;\n      setTimeout(function () { try { go.focus(); } catch (e) { /* not focusable yet */ } }, 50);\n    }\n    d.appendChild(ic); d.appendChild(b);\n    var host = document.getElementById('ncl'); host.appendChild(d);\n    cardEl.getElementsByTagName('p')[0].textContent = TX.sent;\n  }\n\n  function picture(n, kind, css) {\n    var im = document.createElement('img');\n    im.alt = '';\n    im.style.cssText = 'max-height:260px;border-radius:24px;margin-top:16px;display:block;' + css;\n    im.onerror = function () { im.style.display = 'none'; };   // a picture that cannot be fetched is left out\n    im.src = (apiGood || BASES[0]) + '/plugins/notification-center/api/img?' + (kind ? 'kind=' + kind + '&' : '') + 'id=' + encodeURIComponent(n.id);\n    return im;\n  }\n\n  function mkBtn(label, fn) {\n    var x = document.createElement('button');\n    x.type = 'button'; x.className = 'act'; x.textContent = label; x.onclick = fn;\n    return x;\n  }\n  // The button was pressed: the Shard launches the app the notification named, then this screen leaves.\n  function runAction(n) {\n    var done = false;\n    function go() { if (!done) { done = true; leave(); } }\n    try {\n      var x = new XMLHttpRequest();\n      x.open('POST', (apiGood || BASES[0]) + '/plugins/notification-center/api/action?id=' + encodeURIComponent(n.id), true);\n      x.onload = go; x.onerror = go;\n      x.send('');\n    } catch (e) { go(); }\n    setTimeout(go, 1500);\n  }\n\n  function now() { var d = new Date(); function p(n) { return (n < 10 ? '0' : '') + n; } return p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds()); }\n  function log(cls, text) {\n    if (!logEl) { return; }\n    var line = document.createElement('div');\n    line.className = cls; line.textContent = now() + '  ' + text;\n    logEl.appendChild(line);\n    while (logEl.childNodes.length > 14) { logEl.removeChild(logEl.firstChild); }\n  }\n\n  function xhrGet(base, cb) {\n    var x = new XMLHttpRequest(), done = false;\n    function end(err, text) { if (!done) { done = true; cb(err, text); } }\n    try {\n      x.open('GET', base + NOTES_PATH + '?src=app'); x.timeout = 4000;\n      x.onload = function () { if (x.status === 200) { end(null, x.responseText); } else { end('http ' + x.status); } };\n      x.onerror = function () { end('network'); };\n      x.ontimeout = function () { end('timeout'); };\n      x.send();\n    } catch (e) { end('blocked'); }\n  }\n  function scriptGet(base, cb) {\n    var s = document.createElement('script'), done = false, t;\n    function end(err, data) {\n      if (done) { return; }\n      done = true; clearTimeout(t); window.__ncNotes = undefined;\n      if (s.parentNode) { s.parentNode.removeChild(s); }\n      cb(err, data);\n    }\n    window.__ncNotes = function (d) { end(null, d); };\n    s.onerror = function () { end('network'); };\n    t = setTimeout(function () { end('timeout'); }, 5000);\n    s.src = base + NOTES_PATH + '?js=1&src=app&t=' + new Date().getTime();\n    (document.head || document.documentElement).appendChild(s);\n  }\n  function fetchQueue(done) {\n    var list = apiGood ? [apiGood] : BASES, i = 0, errors = [];\n    (function next() {\n      if (i >= list.length) { return done(errors.join('; ') || 'no address'); }\n      var base = list[i++];\n      xhrGet(base, function (err, text) {\n        if (!err) { try { apiGood = base; var jd = JSON.parse(text); applyLang(jd.lang); return done(null, jd.notifications || []); } catch (e) { err = 'json'; } }\n        scriptGet(base, function (err2, data) {\n          if (!err2) { apiGood = base; applyLang(data && data.lang); return done(null, (data && data.notifications) || []); }\n          errors.push(base + ' xhr:' + err + ' script:' + err2); next();\n        });\n      });\n    })();\n  }\n\n  function post(title, body, cb) {\n    try {\n      if (!window.Notification) { return cb('window.Notification is missing'); }\n      var show = function () { try { new Notification(title, { body: body }); cb(null); } catch (e) { cb('new Notification: ' + e.message); } };\n      if (Notification.permission === 'granted') { return show(); }\n      var r = Notification.requestPermission(function (p) { if (p === 'granted') { show(); } else { cb('permission ' + p); } });\n      if (r && r.then) { r.then(function (p) { if (p === 'granted') { show(); } else { cb('permission ' + p); } }); }\n    } catch (e) { cb(e.message); }\n  }\n\n  // Leaving: tell the Shard first (so the next notification launches the app again at once), then exit.\n  function leave() {\n    var done = false;\n    function go() { if (!done) { done = true; try { tizen.application.getCurrentApplication().exit(); } catch (x) { /* not on a TV */ } } }\n    try { var im = new Image(); im.onload = go; im.onerror = go; im.src = (apiGood || BASES[0]) + NOTES_PATH + '?src=app&bye=1&t=' + new Date().getTime(); } catch (e) { go(); }\n    setTimeout(go, 600);\n  }\n  // A notification that arrives while the app is open extends the stay instead of being cut short by the first one's exit timer.\n  var exitTimer = null, exitAt = 0;\n  function scheduleExit(ms) {\n    var at = new Date().getTime() + ms;\n    if (at > exitAt) { exitAt = at; clearTimeout(exitTimer); exitTimer = setTimeout(leave, ms); }\n  }\n  var cdTimer = null, cdEl = null;\n  function countdown(sec) {\n    if (!cardEl) { return; }\n    clearTimeout(cdTimer);\n    if (cdEl && cdEl.parentNode) { cdEl.parentNode.removeChild(cdEl); }\n    var el = cdEl = document.createElement('div');\n    // Small, in the top-left corner of the screen (the big number in the middle of the card was only for debugging).\n    el.style.cssText = 'position:fixed;left:36px;top:28px;color:#8b96ab;font-size:22px;line-height:1.2;text-align:left;z-index:5';\n    document.body.appendChild(el);\n    (function tick() {\n      el.innerHTML = '';\n      var lbl = document.createElement('span'), num = document.createElement('span');\n      lbl.textContent = TX.back + ' ';\n      num.textContent = String(sec) + ' s';\n      num.style.cssText = 'font-weight:700;color:#e8edf6';\n      el.appendChild(lbl); el.appendChild(num);\n      if (sec <= 0) { return; }\n      sec -= 1; cdTimer = setTimeout(tick, 1000);\n    })();\n  }\n\n  // On start, on resume and every few seconds while visible: post what is new, stay open while the banner shows, then exit.\n  function check(why) {\n    if (busy) { return; }\n    busy = true;\n    fetchQueue(function (err, list) {\n      if (err) { busy = false; return log('err', why + ': Shard unreachable (' + err + ')'); }\n      var seen = {}; try { seen = JSON.parse(localStorage.getItem(SEEN_KEY) || '{}'); } catch (e) { seen = {}; }\n      // 2 = left to the banner service: if the Shard later says the service does not post it, the screen posts it after all.\n      var fresh = list.filter(function (n) { return !seen[n.id] || (seen[n.id] === 2 && n.mode === 'banner' && !n.svc); });\n      if (!fresh.length) { busy = false; return log('inf', why + ': nothing new'); }\n      var pending = fresh.length;\n      // mode: 'banner' = native Samsung banner only, 'full' = full-screen card only, anything else = both.\n      // How long to stay on screen: the longest duration asked (default 8 s), exactly as requested.\n      var stayMs = 0;\n      fresh.forEach(function (n) { var d = parseInt(n.duration, 10) || 8; if (d * 1000 > stayMs) { stayMs = d * 1000; } });\n      var onlyBanner = fresh.every(function (n) { return n.mode === 'banner'; });\n      if (cardEl) { cardEl.style.display = onlyBanner ? 'none' : ''; }\n      fresh.forEach(function (n) {\n        seen[n.id] = n.svc ? 2 : 1;\n        if (n.mode !== 'banner') { showCard(n); }\n        (n.mode === 'full' || n.svc ? function (t, b, cb) { cb(null); } : post)(((n.icon || EMO[n.level] || '') + ' ' + (n.title || 'Notification')).replace(/^ /, ''), n.message || '', function (e) {\n          log(e ? 'err' : 'ok', (n.title || 'Notification') + ': ' + (e || 'posted'));\n          pending -= 1;\n          if (pending) { return; }\n          try { localStorage.setItem(SEEN_KEY, JSON.stringify(seen)); } catch (x) { /* storage unavailable */ }\n          busy = false;\n          // Leaving too early hides the banner: stay open while it is on screen.\n          scheduleExit(stayMs);\n          countdown(Math.max(1, Math.round((exitAt - new Date().getTime()) / 1000)));\n        });\n      });\n    });\n  }\n\n  check('start');\n  document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'visible') { check('resume'); } });\n  setInterval(function () { if (document.visibilityState !== 'hidden') { check('watch'); } }, WATCH_MS);\n  document.addEventListener('keydown', function (e) {\n    if (e.keyCode === 10009 || e.keyCode === 27) { leave(); }\n    else if ((e.keyCode === 37 || e.keyCode === 39) && actBtns.length) {\n      actIdx = (actIdx + (e.keyCode === 39 ? 1 : -1) + actBtns.length) % actBtns.length;\n      try { actBtns[actIdx].focus(); } catch (x) { /* gone */ }\n    }\n  });\n})();\n","overlay/Overlay.cs":"// Notification Center overlay helper (netcoreapp3.1, run by the TV's dotnet as the Shard asks).\n// One notification above the running picture for a few seconds: a flat bar, an animated glass bar or a large dark panel.\n// The window is like the Vetro launcher's: notification level, transparent, no focus, no input.\n//   dotnet ncoverlay.dll --file <job.txt>\n//\n// The job file is UTF-8 text, one value per line (never shell arguments, so no text can reach a shell):\n//   1 title (may be empty)   2 message   3 accent colour as 6 hex digits   4 seconds (1-120)   5 opacity of the background (20-100)\n//   6 optional: absolute path of a PNG icon, drawn on the left (decoded by this program; up to 2 MB and 1024x1024)\n//   7 optional: absolute path of a second PNG icon, drawn on the right (for example the away club)\n//   8 optional: 1 = animated (without it, or when the animator cannot run, the bar is simply there)\n//   9 optional: \"top\" = the bar near the top of the screen\n//  10 optional: the look, \"glass\" or \"panel\"; anything else is the flat bar\nusing System;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Globalization;\nusing System.Runtime.InteropServices;\n\ninternal static class NcOverlay\n{\n    private const int ElmWinNotification = 12;\n    private const int NotificationLevelTop = 40;\n    private const int ScreenW = 1920, ScreenH = 1080;\n    private const int BarW = 1600, BarMargin = 90, IconSize = 128, Radius = 36, Slide = 90;\n    private const int PanelW = 1760, PanelH = 940, PanelIcon = 380, PanelMinAlpha = 240;\n    private const double EnterDelay = 0.6, EnterSeconds = 0.6, LeaveSeconds = 0.4;\n\n    [UnmanagedFunctionPointer(CallingConvention.Cdecl)] private delegate int TaskCb(IntPtr data);\n\n    private static readonly TaskCb QuitCb = QuitLoop, FrameCb = Frame, SettleCb = Settle, LeaveCb = Leave, EnterCb = Enter;\n    private const string Elm = \"libelementary.so.1\", Evas = \"libevas.so.1\", Ecore = \"libecore.so.1\", Util = \"libcapi-ui-efl-util.so.0\";\n\n    [DllImport(Elm)] private static extern int elm_init(int argc, IntPtr argv);\n    [DllImport(Elm)] private static extern IntPtr elm_win_add(IntPtr parent, string name, int type);\n    [DllImport(Elm)] private static extern void elm_win_alpha_set(IntPtr win, int alpha);\n    [DllImport(Elm)] private static extern void elm_win_borderless_set(IntPtr win, int borderless);\n    [DllImport(Elm)] private static extern int elm_win_aux_hint_add(IntPtr win, string hint, string value);\n    [DllImport(Elm)] private static extern void elm_win_layer_set(IntPtr win, int layer);\n    [DllImport(Elm)] private static extern void elm_win_input_rect_set(IntPtr win, int x, int y, int w, int h);\n    [DllImport(Elm)] private static extern void elm_win_prop_focus_skip_set(IntPtr win, int skip);\n    [DllImport(Util)] private static extern int efl_util_set_notification_window_level(IntPtr win, int level);\n    [DllImport(Evas)] private static extern IntPtr evas_object_evas_get(IntPtr obj);\n    [DllImport(Evas)] private static extern IntPtr evas_object_image_add(IntPtr evas);\n    [DllImport(Evas)] private static extern void evas_object_image_alpha_set(IntPtr obj, int alpha);\n    [DllImport(Evas)] private static extern void evas_object_image_size_set(IntPtr obj, int w, int h);\n    [DllImport(Evas)] private static extern void evas_object_image_data_set(IntPtr obj, IntPtr data);\n    [DllImport(Evas)] private static extern void evas_object_image_data_update_add(IntPtr obj, int x, int y, int w, int h);\n    [DllImport(Evas)] private static extern void evas_object_image_fill_set(IntPtr obj, int x, int y, int w, int h);\n    [DllImport(Evas)] private static extern IntPtr evas_object_text_add(IntPtr evas);\n    [DllImport(Evas)] private static extern void evas_object_text_font_set(IntPtr obj, string font, int size);\n    [DllImport(Evas)] private static extern void evas_object_text_text_set(IntPtr obj, string text);\n    [DllImport(Evas)] private static extern int evas_object_text_horiz_advance_get(IntPtr obj);\n    [DllImport(Evas)] private static extern void evas_object_raise(IntPtr obj);\n    [DllImport(Evas)] private static extern void evas_object_color_set(IntPtr obj, int r, int g, int b, int a);\n    [DllImport(Evas)] private static extern void evas_object_pass_events_set(IntPtr obj, int pass);\n    [DllImport(Evas)] private static extern void evas_object_move(IntPtr obj, int x, int y);\n    [DllImport(Evas)] private static extern void evas_object_resize(IntPtr obj, int w, int h);\n    [DllImport(Evas)] private static extern void evas_object_show(IntPtr obj);\n    [DllImport(Evas)] private static extern void evas_object_hide(IntPtr obj);\n    [DllImport(Ecore)] private static extern IntPtr ecore_timer_add(double seconds, TaskCb cb, IntPtr data);\n    [DllImport(Ecore)] private static extern void ecore_main_loop_begin();\n    [DllImport(Ecore)] private static extern void ecore_main_loop_quit();\n    [DllImport(Ecore)] private static extern IntPtr ecore_animator_add(TaskCb cb, IntPtr data);\n    [DllImport(Ecore)] private static extern double ecore_time_get();\n\n    private static int QuitLoop(IntPtr data) { ecore_main_loop_quit(); return 0; }\n\n    [DllImport(\"libc.so.6\")] private static extern int setenv(string name, string value, int overwrite);\n    [DllImport(\"libc.so.6\")] private static extern uint getuid();\n\n    // Needed to redraw a moving window. Follows Vetro's dock/src/Program.cs SetupEnvironment (MIT, (c) 2026 Vetro contributors).\n    private static void Accelerate()\n    {\n        string run = \"/run\";\n        foreach (string dir in new[] { \"/run/user/5001\", \"/run\", \"/run/user/\" + getuid(), Environment.GetEnvironmentVariable(\"XDG_RUNTIME_DIR\") })\n            if (!string.IsNullOrEmpty(dir) && File.Exists(dir + \"/wayland-0\")) run = dir;   // the last one found wins\n        setenv(\"XDG_RUNTIME_DIR\", run, 1);\n        setenv(\"ELM_ENGINE\", \"gl\", 1);\n        setenv(\"ECORE_EVAS_ENGINE\", \"wayland_egl\", 1);\n        foreach (string pair in (\"WAYLAND_DISPLAY=wayland-0 ELM_PROFILE=tv ELM_DISPLAY=wl EVAS_FONT_DPI=72 ELM_ACCEL=gl EVAS_GL_NO_BLACKLIST=1 \" +\n            \"ECORE_EVAS_COMP_NOSYNC=1 ECORE_VSYNC_DRM_ALL=1 ECORE_EVAS_GL_SYNC_DRAW_DONE=1 EVAS_GL_PARTIAL_DISABLE=1\").Split(' '))\n            setenv(pair.Substring(0, pair.IndexOf('=')), pair.Substring(pair.IndexOf('=') + 1), 0);\n    }\n\n    // The first `max` characters and an ellipsis, never cutting a character of two halves (emoji) in two.\n    private static string Clip(string s, int max)\n    {\n        if (s.Length <= max) return s;\n        int n = max - 1;\n        if (n > 0 && char.IsHighSurrogate(s[n - 1])) n--;\n        return s.Substring(0, n) + \"…\";\n    }\n\n    // Everything on the bar, at its place inside it, so the whole bar can move and fade as one. Rgb is -1 for a picture.\n    private struct Item { public IntPtr O; public int X, Y, Rgb; }\n    private static readonly List<Item> Items = new List<Item>();\n    private static int _originX, _originY, _slide, _span, _runner = -1;\n    private static double _start;\n    private static bool _leaving;\n\n    private static void Add(IntPtr o, int x, int y, int rgb)\n    {\n        Items.Add(new Item { O = o, X = x, Y = y, Rgb = rgb });\n        evas_object_raise(o);   // above what was added before, also for a label made earlier to measure text\n        evas_object_show(o);\n    }\n\n    // p goes from 0 (invisible, shifted towards its edge of the screen) to 1 (in place). Colours are premultiplied by the alpha, as EFL expects.\n    private static void Place(double p)\n    {\n        int y = _originY + (int)Math.Round((1 - p) * _slide), a = (int)Math.Round(255 * p);\n        foreach (Item i in Items)\n        {\n            evas_object_move(i.O, _originX + i.X, y + i.Y);\n            if (i.Rgb < 0) evas_object_color_set(i.O, a, a, a, a);\n            else evas_object_color_set(i.O, ((i.Rgb >> 16) & 255) * a / 255, ((i.Rgb >> 8) & 255) * a / 255, (i.Rgb & 255) * a / 255, a);\n        }\n    }\n\n    // Fades in or out, and moves the runner along the lower edge.\n    private static int Frame(IntPtr data)\n    {\n        double now = ecore_time_get(), t = Math.Min(1, (now - _start) / (_leaving ? LeaveSeconds : EnterSeconds));\n        if (_runner >= 0) { Item r = Items[_runner]; r.X = 40 + (int)(now * 400 % _span); Items[_runner] = r; }\n        Place(_leaving ? 1 - t : t);\n        return 1;\n    }\n\n    // In case it never ticks.\n    private static int Settle(IntPtr data) { if (!_leaving) Place(1); return 0; }\n\n    // After the first frame is drawn.\n    private static int Enter(IntPtr data)\n    {\n        _start = ecore_time_get();\n        try { ecore_animator_add(FrameCb, IntPtr.Zero); }\n        catch (EntryPointNotFoundException) { Place(1); return 0; }\n        ecore_timer_add(EnterSeconds + 0.15, SettleCb, IntPtr.Zero);\n        return 0;\n    }\n\n    private static int Leave(IntPtr data) { _leaving = true; _start = ecore_time_get(); return 0; }\n\n    // How much of pixel (i, j) is inside a rounded rectangle: 1 inside, 0 outside, in between on the curved edge.\n    private static double Cover(int i, int j, int w, int h, int rad)\n    {\n        double dx = 0, dy = 0;\n        if (i < rad) dx = rad - 0.5 - i; else if (i >= w - rad) dx = i - (w - rad) + 0.5;\n        if (j < rad) dy = rad - 0.5 - j; else if (j >= h - rad) dy = j - (h - rad) + 0.5;\n        if (dx <= 0 || dy <= 0) return 1;\n        double d = Math.Sqrt(dx * dx + dy * dy);\n        return d <= rad - 1 ? 1 : d >= rad ? 0 : rad - d;\n    }\n\n    private static int Pixel(double r, double g, double b, double a)\n    {\n        int al = (int)Math.Round(a);\n        return (al << 24) | (((int)r * al / 255) << 16) | (((int)g * al / 255) << 8) | ((int)b * al / 255);\n    }\n\n    // A picture drawn from a pixel buffer (premultiplied ARGB), so no image file or decoder is needed.\n    private static void Picture(IntPtr evas, int[] px, int x, int y, int w, int h)\n    {\n        IntPtr mem = Marshal.AllocHGlobal(px.Length * 4);   // kept until the process exits: the canvas reads it while the bar is up\n        Marshal.Copy(px, 0, mem, px.Length);\n        IntPtr img = evas_object_image_add(evas);\n        evas_object_image_alpha_set(img, 1);\n        evas_object_image_size_set(img, w, h);\n        evas_object_image_data_set(img, mem);\n        evas_object_image_data_update_add(img, 0, 0, w, h);\n        evas_object_image_fill_set(img, 0, 0, w, h);\n        evas_object_resize(img, w, h);\n        Add(img, x, y, -1);\n    }\n\n    // The background: a rounded rectangle. Flat is one dark colour; glass is lighter at the top, with a thin bright edge that fades downwards (no blur).\n    private static void Panel(IntPtr evas, int w, int h, int alpha, bool glass)\n    {\n        int[] px = new int[w * h];\n        for (int j = 0; j < h; j++)\n        {\n            double t = j / (double)(h - 1), r = glass ? 40 - 28 * t : 10, g = glass ? 54 - 36 * t : 12, b = glass ? 82 - 52 * t : 18;\n            int solid = Pixel(r, g, b, alpha);\n            for (int i = 0; i < w; i++)\n            {\n                if (i >= Radius && i < w - Radius && (!glass || j >= 2 && j < h - 2)) { px[j * w + i] = solid; continue; }\n                double inner = !glass ? 1 : i < 2 || j < 2 || i >= w - 2 || j >= h - 2 ? 0 : Cover(i - 2, j - 2, w - 4, h - 4, Radius - 2);\n                double shine = (1 - inner) * (0.5 - 0.38 * t);\n                px[j * w + i] = Pixel(r + (255 - r) * shine, g + (255 - g) * shine, b + (255 - b) * shine, (alpha + (255 - alpha) * shine) * Cover(i, j, w, h, Radius));\n            }\n        }\n        Picture(evas, px, 0, 0, w, h);\n    }\n\n    // The stripe in the colour of the level.\n    private static void Stripe(IntPtr evas, int x, int y, int w, int h, int rgb)\n    {\n        int[] px = new int[w * h];\n        for (int j = 0; j < h; j++)\n            for (int i = 0; i < w; i++)\n                px[j * w + i] = Pixel((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255, 255 * Cover(i, j, w, h, Math.Min(w, h) / 2));\n        Picture(evas, px, x, y, w, h);\n    }\n\n    // A small PNG decoder (grey, grey+alpha, RGB, RGBA and palette with 8 bits per channel, grey and palette also with 1, 2 or 4; not interlaced),\n    // because the EFL image loader is not available to this process.\n    // Returns premultiplied-free RGBA bytes, or null for anything it does not understand or that is too big.\n    private static byte[] DecodePng(byte[] f, out int w, out int h)\n    {\n        w = 0; h = 0;\n        if (f.Length < 33 || f.Length > 2 * 1024 * 1024 || f[0] != 0x89 || f[1] != 0x50 || f[2] != 0x4E || f[3] != 0x47) return null;\n        int pos = 8, depth = 0, ctype = 0, interlace = 0;\n        byte[] plte = null, trns = null;\n        MemoryStream idat = new MemoryStream();\n        while (pos + 12 <= f.Length)\n        {\n            int len = (f[pos] << 24) | (f[pos + 1] << 16) | (f[pos + 2] << 8) | f[pos + 3];\n            if (len < 0 || pos + 12 + len > f.Length) return null;\n            string type = System.Text.Encoding.ASCII.GetString(f, pos + 4, 4);\n            int d = pos + 8;\n            if (type == \"IHDR\" && len >= 13)\n            {\n                w = (f[d] << 24) | (f[d + 1] << 16) | (f[d + 2] << 8) | f[d + 3];\n                h = (f[d + 4] << 24) | (f[d + 5] << 16) | (f[d + 6] << 8) | f[d + 7];\n                depth = f[d + 8]; ctype = f[d + 9]; interlace = f[d + 12];\n            }\n            else if (type == \"PLTE\") { plte = new byte[len]; Array.Copy(f, d, plte, 0, len); }\n            else if (type == \"tRNS\") { trns = new byte[len]; Array.Copy(f, d, trns, 0, len); }\n            else if (type == \"IDAT\") { idat.Write(f, d, len); }\n            else if (type == \"IEND\") break;\n            pos += 12 + len;\n        }\n        if (w < 1 || h < 1 || w > 1024 || h > 1024 || interlace != 0) return null;\n        if (depth != 8 && !((depth == 1 || depth == 2 || depth == 4) && (ctype == 0 || ctype == 3))) return null;\n        int ch;\n        switch (ctype) { case 0: ch = 1; break; case 2: ch = 3; break; case 3: ch = 1; break; case 4: ch = 2; break; case 6: ch = 4; break; default: return null; }\n        if (ctype == 3 && plte == null) return null;\n        int stride = (w * ch * depth + 7) / 8, bpp = depth == 8 ? ch : 1, rawLen = (stride + 1) * h;\n        byte[] raw = new byte[rawLen];\n        idat.Position = 2;   // skip the zlib header\n        try\n        {\n            using (System.IO.Compression.DeflateStream z = new System.IO.Compression.DeflateStream(idat, System.IO.Compression.CompressionMode.Decompress))\n            {\n                int got = 0, n;\n                while (got < rawLen && (n = z.Read(raw, got, rawLen - got)) > 0) got += n;\n                if (got < rawLen) return null;\n            }\n        }\n        catch (InvalidDataException) { return null; }\n        byte[] pix = new byte[stride * h];\n        for (int y = 0; y < h; y++)\n        {\n            int ft = raw[y * (stride + 1)], src = y * (stride + 1) + 1, dst = y * stride;\n            for (int x = 0; x < stride; x++)\n            {\n                int a = x >= bpp ? pix[dst + x - bpp] : 0, b = y > 0 ? pix[dst - stride + x] : 0, c = (x >= bpp && y > 0) ? pix[dst - stride + x - bpp] : 0, v = raw[src + x];\n                switch (ft)\n                {\n                    case 1: v += a; break;\n                    case 2: v += b; break;\n                    case 3: v += (a + b) / 2; break;\n                    case 4:\n                        int p = a + b - c, pa = Math.Abs(p - a), pb = Math.Abs(p - b), pc = Math.Abs(p - c);\n                        v += (pa <= pb && pa <= pc) ? a : (pb <= pc ? b : c); break;\n                    case 0: break;\n                    default: return null;\n                }\n                pix[dst + x] = (byte)v;\n            }\n        }\n        if (depth < 8)   // several pixels per byte, the first one in the high bits: one byte per pixel from here on\n        {\n            int mask = (1 << depth) - 1;\n            byte[] one = new byte[w * h];\n            for (int y = 0; y < h; y++)\n            {\n                for (int x = 0; x < w; x++)\n                {\n                    int v = (pix[y * stride + x * depth / 8] >> (8 - depth - x * depth % 8)) & mask;\n                    one[y * w + x] = (byte)(ctype == 0 ? v * 255 / mask : v);\n                }\n            }\n            pix = one;\n        }\n        byte[] rgba = new byte[w * h * 4];\n        for (int i = 0; i < w * h; i++)\n        {\n            int r, g, b, a = 255;\n            switch (ctype)\n            {\n                case 0: r = g = b = pix[i]; break;\n                case 2: r = pix[i * 3]; g = pix[i * 3 + 1]; b = pix[i * 3 + 2]; break;\n                case 3:\n                    int k = pix[i];\n                    if (k * 3 + 2 >= plte.Length) return null;\n                    r = plte[k * 3]; g = plte[k * 3 + 1]; b = plte[k * 3 + 2];\n                    if (trns != null && k < trns.Length) a = trns[k];\n                    break;\n                case 4: r = g = b = pix[i * 2]; a = pix[i * 2 + 1]; break;\n                default: r = pix[i * 4]; g = pix[i * 4 + 1]; b = pix[i * 4 + 2]; a = pix[i * 4 + 3]; break;\n            }\n            rgba[i * 4] = (byte)r; rgba[i * 4 + 1] = (byte)g; rgba[i * 4 + 2] = (byte)b; rgba[i * 4 + 3] = (byte)a;\n        }\n        return rgba;\n    }\n\n    // The pixels of an icon file, or null when there is none or it cannot be decoded (the bar is then laid out without it).\n    private static byte[] LoadIcon(string path, out int w, out int h)\n    {\n        w = 0; h = 0;\n        try { return path.Length > 0 && Path.IsPathRooted(path) && File.Exists(path) ? DecodePng(File.ReadAllBytes(path), out w, out h) : null; }\n        catch (IOException) { return null; }\n        catch (UnauthorizedAccessException) { return null; }\n    }\n\n    // The icon fitted into a square of `size`, keeping its shape (box filter), with rounded corners, drawn through the same pixel-buffer path as the bar.\n    private static void Icon(IntPtr evas, int x, int y, int size, byte[] src, int w, int h)\n    {\n        int dw = w >= h ? size : Math.Max(1, w * size / h), dh = h >= w ? size : Math.Max(1, h * size / w);\n        int[] px = new int[dw * dh];\n        int rad = Math.Min(dw, dh) / 5;\n        for (int j = 0; j < dh; j++)\n        {\n            for (int i = 0; i < dw; i++)\n            {\n                int x0 = i * w / dw, x1 = Math.Max(x0 + 1, (i + 1) * w / dw), y0 = j * h / dh, y1 = Math.Max(y0 + 1, (j + 1) * h / dh);\n                long sr = 0, sg = 0, sb = 0, sa = 0; int n = 0;\n                for (int yy = y0; yy < y1 && yy < h; yy++)\n                {\n                    for (int xx = x0; xx < x1 && xx < w; xx++)\n                    {\n                        int o = (yy * w + xx) * 4, al = src[o + 3];\n                        sr += src[o] * al; sg += src[o + 1] * al; sb += src[o + 2] * al; sa += al; n++;\n                    }\n                }\n                if (n == 0) continue;\n                double alpha = (sa / (double)n) / 255.0 * Cover(i, j, dw, dh, rad);   // premultiplied: colour = average of (colour * alpha) already\n                int pa = (int)Math.Round(alpha * 255);\n                double norm = sa > 0 ? 1.0 / sa : 0;   // weighted average colour, then premultiplied by the final alpha\n                int pr = (int)Math.Round(sr * norm * alpha), pg = (int)Math.Round(sg * norm * alpha), pb = (int)Math.Round(sb * norm * alpha);\n                px[j * dw + i] = (pa << 24) | (pr << 16) | (pg << 8) | pb;\n            }\n        }\n        Picture(evas, px, x + (size - dw) / 2, y + (size - dh) / 2, dw, dh);\n    }\n\n    private static IntPtr Label(IntPtr evas, int size)\n    {\n        IntPtr t = evas_object_text_add(evas);\n        evas_object_text_font_set(t, \"SamsungOne\", size);\n        return t;\n    }\n\n    private static int Width(IntPtr t, string value)\n    {\n        evas_object_text_text_set(t, value);\n        return evas_object_text_horiz_advance_get(t);\n    }\n\n    // `value` as at most `lines` lines no wider than `max` pixels, cut between words where it can; what does not fit ends in an ellipsis.\n    private static List<string> Wrap(IntPtr t, string value, int max, int lines)\n    {\n        List<string> result = new List<string>();\n        string rest = value.Trim();\n        while (rest.Length > 0 && result.Count < lines)\n        {\n            int n = rest.Length;\n            while (n > 1 && Width(t, rest.Substring(0, n)) > max) n--;\n            if (n < rest.Length && result.Count < lines - 1)\n            {\n                int cut = rest.LastIndexOf(' ', n);\n                if (cut >= n / 2) n = cut; else if (n > 1 && char.IsHighSurrogate(rest[n - 1])) n--;\n                result.Add(rest.Substring(0, n).TrimEnd());\n                rest = rest.Substring(n).TrimStart();\n                continue;\n            }\n            string line = rest.Substring(0, n);\n            if (n < rest.Length) for (int k = n; k > 1; k--) { line = Clip(rest, k); if (Width(t, line) <= max) break; }\n            result.Add(line);\n            break;\n        }\n        return result;\n    }\n\n    // Text at (x, y), or centred in the `centre` pixels that start at x when that is more than 0.\n    private static void Text(IntPtr t, int x, int y, string value, int rgb, int centre)\n    {\n        int w = Width(t, value);\n        Add(t, centre > 0 ? x + Math.Max(0, (centre - w) / 2) : x, y, rgb);\n    }\n\n    // The bar: a logo at each end, the title and up to two lines between them.\n    private static void DrawBar(IntPtr evas, int h, string title, List<string> body, IntPtr titleLabel, byte[] icon1, int w1, int h1, byte[] icon2, int w2, int h2)\n    {\n        int textH = 56 + ((title.Length > 0 ? 1 : 0) + body.Count) * 58;\n        int tx = 58, ty = (h - textH) / 2 + 24;\n        if (icon1 != null) { Icon(evas, 58, (h - IconSize) / 2, IconSize, icon1, w1, h1); tx = 58 + IconSize + 30; }\n        if (icon2 != null) Icon(evas, BarW - 58 - IconSize, (h - IconSize) / 2, IconSize, icon2, w2, h2);\n        if (title.Length > 0) { Text(titleLabel, tx, ty, title, 0xFFFFFF, 0); ty += 62; }\n        foreach (string line in body) { Text(Label(evas, 38), tx, ty, line, 0xD6DEEE, 0); ty += 54; }\n    }\n\n    // The panel: large logos side by side, then the title and up to four lines, all centred.\n    private static void DrawPanel(IntPtr evas, string title, List<string> body, IntPtr titleLabel, byte[] icon1, int w1, int h1, byte[] icon2, int w2, int h2)\n    {\n        int icons = (icon1 != null ? 1 : 0) + (icon2 != null ? 1 : 0);\n        int total = (icons > 0 ? PanelIcon + 50 : 0) + (title.Length > 0 ? 110 : 0) + body.Count * 70;\n        int y = (PanelH - total) / 2;\n        if (icons > 0)\n        {\n            int x = (PanelW - (icons == 2 ? 2 * PanelIcon + 300 : PanelIcon)) / 2;\n            if (icon1 != null) { Icon(evas, x, y, PanelIcon, icon1, w1, h1); x += PanelIcon + 300; }\n            if (icon2 != null) Icon(evas, x, y, PanelIcon, icon2, w2, h2);\n            y += PanelIcon + 50;\n        }\n        if (title.Length > 0) { Text(titleLabel, 80, y, title, 0xFFFFFF, PanelW - 160); y += 110; }\n        foreach (string line in body) { Text(Label(evas, 52), 80, y, line, 0xD6DEEE, PanelW - 160); y += 70; }\n    }\n\n    private static int Main(string[] args)\n    {\n        if (args.Length != 2 || args[0] != \"--file\") { Console.Error.WriteLine(\"usage: ncoverlay --file job.txt\"); return 2; }\n        string[] lines;\n        try\n        {\n            FileInfo fi = new FileInfo(args[1]);\n            if (!fi.Exists || fi.Length > 8192) { Console.Error.WriteLine(\"job file missing or too big\"); return 2; }\n            lines = File.ReadAllText(args[1], System.Text.Encoding.UTF8).Split('\\n');\n        }\n        catch (IOException) { Console.Error.WriteLine(\"job file unreadable\"); return 2; }\n        Func<int, string> at = delegate (int n) { return n < lines.Length ? lines[n].TrimEnd('\\r') : \"\"; };\n\n        string title = at(0).Trim();\n        string message = at(1).Trim();\n        int accent;\n        if (at(2).Length != 6 || !int.TryParse(at(2), NumberStyles.HexNumber, CultureInfo.InvariantCulture, out accent)) accent = 0x00beff;\n        int seconds;\n        if (!int.TryParse(at(3), NumberStyles.Integer, CultureInfo.InvariantCulture, out seconds)) seconds = 6;\n        seconds = Math.Max(1, Math.Min(120, seconds));\n        int opacity;\n        if (!int.TryParse(at(4), NumberStyles.Integer, CultureInfo.InvariantCulture, out opacity)) opacity = 88;\n        opacity = Math.Max(20, Math.Min(100, opacity));\n        if (title.Length == 0 && message.Length == 0) return 2;\n        bool panel = at(9) == \"panel\", glass = at(9) == \"glass\";\n        bool motion = (panel || glass) && at(7) == \"1\", onTop = !panel && at(8) == \"top\";\n\n        int w1, h1, w2, h2;\n        byte[] icon1 = LoadIcon(at(5).Trim(), out w1, out h1), icon2 = LoadIcon(at(6).Trim(), out w2, out h2);\n        if (motion) Accelerate();\n        elm_init(0, IntPtr.Zero);\n        IntPtr win = elm_win_add(IntPtr.Zero, \"nc-overlay\", ElmWinNotification);\n        if (win == IntPtr.Zero) { Console.Error.WriteLine(\"elm_win_add failed\"); return 1; }\n        elm_win_alpha_set(win, 1);\n        elm_win_borderless_set(win, 1);\n        elm_win_prop_focus_skip_set(win, 1);\n        efl_util_set_notification_window_level(win, NotificationLevelTop);\n        elm_win_layer_set(win, 900);\n        elm_win_input_rect_set(win, 0, 0, 0, 0);\n        elm_win_aux_hint_add(win, \"wm.comp.win.effect.enable\", \"0\");\n        IntPtr evas = evas_object_evas_get(win);\n        if (evas == IntPtr.Zero) return 1;\n\n        // The text is measured on the canvas before the window gets its size.\n        IntPtr titleLabel = Label(evas, panel ? 80 : 46);\n        int icons = (icon1 != null ? 1 : 0) + (icon2 != null ? 1 : 0);\n        int textW = panel ? PanelW - 160 : BarW - 116 - icons * (IconSize + 30);\n        List<string> head = Wrap(titleLabel, title, textW, 1);\n        title = head.Count > 0 ? head[0] : \"\";\n        List<string> body = Wrap(Label(evas, panel ? 52 : 38), message, textW, panel ? 4 : 2);\n        int textH = 56 + ((title.Length > 0 ? 1 : 0) + body.Count) * 58;\n        int boxW = panel ? PanelW : BarW, boxH = panel ? PanelH : icons > 0 ? Math.Max(textH, IconSize + 48) : textH;\n        int top = panel ? (ScreenH - boxH) / 2 : onTop ? BarMargin : ScreenH - BarMargin - boxH, left = (ScreenW - boxW) / 2;\n        // Animated: the window is the box and the room it slides through.\n        _slide = panel ? 0 : onTop ? -Slide : Slide;\n        int room = Math.Abs(_slide);\n        _originX = motion ? 0 : left;\n        _originY = !motion ? top : onTop ? room : 0;\n        if (motion) elm_win_aux_hint_add(win, \"wm.policy.win.user.geometry\", \"1\");\n        evas_object_move(win, motion ? left : 0, !motion ? 0 : onTop ? top - room : top);\n        evas_object_resize(win, motion ? boxW : ScreenW, motion ? boxH + room : ScreenH);\n\n        int alpha = 255 * opacity / 100;\n        Panel(evas, boxW, boxH, panel ? Math.Max(alpha, PanelMinAlpha) : alpha, glass);\n        Stripe(evas, 22, 20, 12, boxH - 40, accent);\n        if (motion) { _runner = Items.Count; _span = boxW - 240; Stripe(evas, 40, boxH - 14, 160, 8, accent); }\n        if (panel) DrawPanel(evas, title, body, titleLabel, icon1, w1, h1, icon2, w2, h2);\n        else DrawBar(evas, boxH, title, body, titleLabel, icon1, w1, h1, icon2, w2, h2);\n\n        Place(motion ? 0.01 : 1);\n        evas_object_pass_events_set(win, 1);\n        evas_object_show(win);\n        if (motion)\n        {\n            ecore_timer_add(EnterDelay, EnterCb, IntPtr.Zero);\n            ecore_timer_add(seconds - LeaveSeconds, LeaveCb, IntPtr.Zero);\n        }\n        ecore_timer_add(seconds, QuitCb, IntPtr.Zero);\n        ecore_main_loop_begin();\n        // The vendor notification window must not be deleted in a short-lived client: hide it and let the process exit close everything.\n        evas_object_hide(win);\n        return 0;\n    }\n}\n","overlay/ncoverlay.dll.b64":"","rules.js":"'use strict';\n// Rules of the Notification Center that do not touch the network: sources (profiles), quiet hours, grouping of repeats and webhook templates.\n// Pure functions, plain ES5 (older TVs run Node 4.4), so they can be tested on their own.\n// Everything here receives raw JSON from the LAN: values are never passed to String() or parseInt() before their type is checked\n// (String({toString: 1}) throws), and names are looked up with hasOwnProperty (so \"__proto__\" and \"constructor\" are not levels or modes).\nvar LEVEL_RANK = { info: 0, ok: 0, warn: 1, alert: 2 };\nvar LEVELS = { info: 1, ok: 1, warn: 1, alert: 1 };\nvar MODES = { both: 1, banner: 1, full: 1, overlay: 1, glass: 1, panel: 1 };\n// Default wallpapers of the full-screen card, shipped with the Shard as small SVG files (wallpapers/<name>.svg).\nvar THEMES = { sport: 1, news: 1 };\n// Wallpaper themes the user added (names only; the Shard keeps this in step with its configuration). A theme is a built-in one or one of these.\nvar CUSTOM_THEMES = {};\nfunction hasTheme(n) { return has(THEMES, n) || has(CUSTOM_THEMES, n); }\n// high: first in the queue, shown even in quiet hours, never merged as a repeat. Anything else is normal.\nvar PRIORITIES = { normal: 1, high: 1 };\n// The sounds of the notification-sound Shard (a closed list: a request can only pick one of these names, never a file).\nvar SOUNDS = { chime: 1, soft: 1, reward: 1, success: 1, alert: 1, rotation: 1, open: 1, poweron: 1 };\n// WAV files the user uploaded to the TV (names only; the Shard keeps this in step with its folder). A sound is a built-in one or one of these.\nvar CUSTOM = {};\nfunction hasSound(n) { return has(SOUNDS, n) || has(CUSTOM, n); }\nvar SOURCE_RE = /^[a-z0-9][a-z0-9._-]{0,31}$/;\nvar HOOK_RE = /^[a-z0-9][a-z0-9-]{0,23}$/;\nvar KEY_RE = /^[A-Za-z0-9._~-]{8,64}$/;\nvar MAX_SOURCES = 20, MAX_HOOKS = 10, MAX_TEMPLATE = 200, MAX_RATE = 600, MAX_CATEGORIES = 12;\nvar CATEGORY_RE = /^[a-z0-9][a-z0-9_-]{0,23}$/;\nfunction cleanCategory(v) { var s = str(v).trim().toLowerCase(); return CATEGORY_RE.test(s) ? s : ''; }\n// Per-category defaults of a sender: {name: {mode?, sound?, volume?, duration?}}; entries with nothing set are dropped.\nfunction sanitizeCategories(v) {\n    var out = {}, k, c, e, n = 0;\n    for (k in (isObj(v) ? v : {})) {\n        if (!has(v, k) || cleanCategory(k) !== k || !isObj(v[k]) || n >= MAX_CATEGORIES) { continue; }\n        c = v[k]; e = {};\n        if (has(MODES, c.mode)) { e.mode = c.mode; }\n        if (hasSound(c.sound)) { e.sound = c.sound; }\n        if (storedVolume(c.volume)) { e.volume = storedVolume(c.volume); }\n        if (clampInt(c.duration, 1, 60, 0)) { e.duration = clampInt(c.duration, 1, 60, 0); }\n        if (Object.keys(e).length) { out[k] = e; n += 1; }\n    }\n    return out;\n}\n\n// Text from the outside: only strings, numbers and booleans are accepted; objects, arrays and null become ''.\nfunction str(v) {\n    var t = typeof v;\n    return t === 'string' ? v : (t === 'number' || t === 'boolean') ? String(v) : '';\n}\n// An integer from the outside: numbers as they are, strings parsed, anything else NaN.\nfunction num(v) {\n    var t = typeof v;\n    if (t === 'number') { return v === v && v !== Infinity && v !== -Infinity ? Math.floor(v) : NaN; }\n    return t === 'string' ? parseInt(v, 10) : NaN;\n}\n// A volume from the outside: a number (or numeric text) is clamped to 10-100, so `volume: 0` or `5` means \"as quiet as allowed\", never \"full\".\n// Missing, empty or not a number means \"not given\" (0), and the default (100) applies later.\nfunction clampVolume(v) { var n = num(v); if (n !== n) { return 0; } return n < 10 ? 10 : (n > 100 ? 100 : n); }\n// The default volume stored for a source or a webhook: the same, except that 0 or empty clears it.\nfunction storedVolume(v) { var n = num(v); return n === 0 || n !== n ? 0 : clampVolume(n); }\nfunction has(o, k) { return o !== null && typeof o === 'object' && typeof k === 'string' && Object.prototype.hasOwnProperty.call(o, k); }\nfunction isObj(v) { return v !== null && typeof v === 'object' && !Array.isArray(v); }\n\nfunction cleanSource(v) {\n    var s = str(v).trim().toLowerCase();\n    return SOURCE_RE.test(s) ? s : '';\n}\nfunction cleanHookName(v) {\n    var s = str(v).trim().toLowerCase();\n    return HOOK_RE.test(s) ? s : '';\n}\nfunction clampInt(v, lo, hi, def) {\n    var n = num(v);\n    if (!(n >= lo)) { return def; }\n    return n > hi ? hi : n;\n}\n\n// Compares two keys without stopping at the first different character.\nfunction sameKey(a, b) {\n    a = str(a); b = str(b);\n    var d = a.length ^ b.length, i, n = a.length > b.length ? a.length : b.length;\n    for (i = 0; i < n; i++) { d |= (a.charCodeAt(i) || 0) ^ (b.charCodeAt(i) || 0); }\n    return d === 0;\n}\n\n// A stored profile. Only known fields are kept. `key` is kept as given (set by the Shard or by the user), never returned by GET.\n// icon: cleaned by the caller (cleanIcon lives next to the emoji rules in index.js).\nfunction sanitizeProfile(p, cleanIcon, old) {\n    p = isObj(p) ? p : {}; old = isObj(old) ? old : {};\n    var out = {\n        enabled: p.enabled === false ? false : (p.enabled === true ? true : old.enabled !== false),\n        icon: has(p, 'icon') ? cleanIcon(p.icon) : (old.icon || ''),\n        level: has(LEVELS, p.level) ? p.level : (has(p, 'level') && !p.level ? '' : (old.level || '')),\n        mode: has(MODES, p.mode) ? p.mode : (has(p, 'mode') && !p.mode ? '' : (old.mode || '')),\n        duration: has(p, 'duration') ? clampInt(p.duration, 1, 60, 0) : (old.duration || 0),\n        rate: has(p, 'rate') ? clampInt(p.rate, 0, MAX_RATE, 0) : (old.rate || 0),\n        sound: has(p, 'sound') ? (hasSound(p.sound) ? p.sound : '') : (old.sound || ''),\n        volume: has(p, 'volume') ? storedVolume(p.volume) : (old.volume || 0),\n        theme: hasTheme(p.theme) ? p.theme : (has(p, 'theme') && !p.theme ? '' : (old.theme || '')),\n        priority: has(p, 'priority') ? (p.priority === 'high' ? 'high' : '') : (old.priority || ''),\n        allowSound: has(p, 'allowSound') ? p.allowSound !== false : old.allowSound !== false,\n        allowMode: has(p, 'allowMode') ? p.allowMode !== false : old.allowMode !== false,\n        allowUrgent: has(p, 'allowUrgent') ? p.allowUrgent !== false : old.allowUrgent !== false,\n        categories: has(p, 'categories') ? sanitizeCategories(p.categories) : (old.categories || {}),\n        key: old.key || ''\n    };\n    if (has(p, 'key')) {\n        if (!p.key) { out.key = ''; }\n        else if (typeof p.key === 'string' && KEY_RE.test(p.key)) { out.key = p.key; }\n        else { out.error = 'key must be 8-64 characters: letters, digits and . _ ~ -'; }\n    }\n    return out;\n}\n// What GET returns: everything except the key itself.\nfunction publicProfile(p) {\n    return { enabled: p.enabled !== false, icon: p.icon || '', level: p.level || '', mode: p.mode || '', duration: p.duration || 0, rate: p.rate || 0, sound: p.sound || '', volume: p.volume || 0, theme: p.theme || '', priority: p.priority || '', allowSound: p.allowSound !== false, allowMode: p.allowMode !== false, allowUrgent: p.allowUrgent !== false, categories: p.categories || {}, hasKey: !!p.key };\n}\n// Fills in what the sender left out with the defaults of its category and then of the source. The sender's own values win, except where\n// the source does not allow it (allowSound, allowMode, allowUrgent false): then what is set here is used, and nothing means the plain default.\nfunction applyProfile(body, p) {\n    var out = {}, k;\n    for (k in body) { if (has(body, k) && k !== '__proto__') { out[k] = body[k]; } }\n    if (!p) { return out; }\n    var cat = cleanCategory(out.category), c = has(p.categories, cat) ? p.categories[cat] : {};\n    if (p.allowSound === false) { delete out.sound; delete out.volume; }\n    if (p.allowMode === false) { delete out.mode; }\n    if (p.allowUrgent === false) { delete out.priority; }\n    ['mode', 'sound', 'volume', 'duration'].forEach(function (f) { if ((out[f] == null || out[f] === '') && c[f]) { out[f] = c[f]; } });\n    if ((out.icon == null || out.icon === '') && p.icon) { out.icon = p.icon; }\n    if (!out.level && p.level) { out.level = p.level; }\n    if (!out.mode && p.mode) { out.mode = p.mode; }\n    if ((out.duration == null || out.duration === '') && p.duration) { out.duration = p.duration; }\n    if ((out.sound == null || out.sound === '') && p.sound) { out.sound = p.sound; }\n    if ((out.volume == null || out.volume === '') && p.volume) { out.volume = p.volume; }\n    if ((out.theme == null || out.theme === '') && p.theme) { out.theme = p.theme; }\n    if ((out.priority == null || out.priority === '') && p.priority) { out.priority = p.priority; }\n    return out;\n}\n\n// Sliding one-minute window per source: returns true when another notification is allowed.\nfunction makeLimiter() {\n    var hits = {};\n    return function allow(source, rate, now) {\n        if (!rate) { return true; }\n        var list = (has(hits, source) ? hits[source] : []).filter(function (t) { return now - t < 60000; });\n        if (list.length >= rate) { hits[source] = list; return false; }\n        list.push(now);\n        hits[source] = list;\n        return true;\n    };\n}\n\nfunction minutes(hhmm) {\n    var m = /^([01]?\\d|2[0-3]):([0-5]\\d)$/.exec(str(hhmm));\n    return m ? parseInt(m[1], 10) * 60 + parseInt(m[2], 10) : -1;\n}\n// settings.quiet = { enabled, from: \"22:00\", to: \"07:00\", allow: \"alert\" | \"warn\" | \"none\" }: levels at or above `allow` still get through.\nfunction sanitizeSettings(s, old) {\n    s = isObj(s) ? s : {}; old = isObj(old) ? old : {};\n    var q = isObj(s.quiet) ? s.quiet : {}, oq = isObj(old.quiet) ? old.quiet : {};\n    var from = minutes(q.from) >= 0 ? q.from : (oq.from || '22:00'), to = minutes(q.to) >= 0 ? q.to : (oq.to || '07:00');\n    var allow = q.allow === 'warn' || q.allow === 'alert' || q.allow === 'none' ? q.allow : (oq.allow || 'alert');\n    return {\n        quiet: { enabled: has(q, 'enabled') ? q.enabled === true : oq.enabled === true, from: from, to: to, allow: allow },\n        groupSeconds: has(s, 'groupSeconds') ? clampInt(s.groupSeconds, 0, 3600, 0) : (has(old, 'groupSeconds') ? old.groupSeconds : 60),\n        strict: has(s, 'strict') ? s.strict === true : old.strict === true,\n        soundVolume: has(s, 'soundVolume') && !isNaN(num(s.soundVolume)) ? clampVolume(s.soundVolume) : (has(old, 'soundVolume') ? clampInt(old.soundVolume, 10, 100, 100) : 100),\n        overlayOpacity: has(s, 'overlayOpacity') ? clampInt(s.overlayOpacity, 20, 100, has(old, 'overlayOpacity') ? clampInt(old.overlayOpacity, 20, 100, 88) : 88) : (has(old, 'overlayOpacity') ? clampInt(old.overlayOpacity, 20, 100, 88) : 88),\n        // The overlay bar: near which edge, whether it slides and fades, and its seconds when a request names none.\n        overlayPosition: (has(s, 'overlayPosition') ? s.overlayPosition : old.overlayPosition) === 'top' ? 'top' : 'bottom',\n        overlayMotion: has(s, 'overlayMotion') ? s.overlayMotion === true : old.overlayMotion !== false,\n        overlayDuration: clampInt(s.overlayDuration, 1, 60, clampInt(old.overlayDuration, 1, 60, 8)),\n        // One sound for everything: replaces whatever sound a notification asks for; '' = each keeps its own. Silent ones stay silent.\n        oneSound: has(s, 'oneSound') ? (hasSound(s.oneSound) ? s.oneSound : '') : str(old.oneSound),\n        // The look of a request that names none (and whose sender sets none), and whether a banner with a picture is drawn as the bar.\n        defaultMode: has(MODES, s.defaultMode) ? s.defaultMode : (has(MODES, old.defaultMode) ? old.defaultMode : 'banner'),\n        bannerImageAsBar: has(s, 'bannerImageAsBar') ? s.bannerImageAsBar === true : old.bannerImageAsBar === true,\n        // For a TV whose native banner does not show: `banner` requests (also the ones without a mode) are drawn as the overlay bar.\n        bannerAsOverlay: has(s, 'bannerAsOverlay') ? s.bannerAsOverlay === true : old.bannerAsOverlay === true,\n        soundDelayMs: has(s, 'soundDelayMs') ? clampInt(s.soundDelayMs, 0, 10000, has(old, 'soundDelayMs') ? clampInt(old.soundDelayMs, 0, 10000, 3000) : 3000) : (has(old, 'soundDelayMs') ? clampInt(old.soundDelayMs, 0, 10000, 3000) : 3000)\n    };\n}\nfunction defaultSettings() { return sanitizeSettings({}, {}); }\n// `now` is a Date in the TV's local time.\nfunction isQuiet(settings, level, now) {\n    var q = settings && settings.quiet;\n    if (!q || !q.enabled) { return false; }\n    var a = minutes(q.from), b = minutes(q.to), t = now.getHours() * 60 + now.getMinutes(), inside;\n    if (a < 0 || b < 0 || a === b) { return false; }\n    inside = a < b ? (t >= a && t < b) : (t >= a || t < b);\n    if (!inside) { return false; }\n    if (q.allow === 'none') { return true; }\n    return (has(LEVEL_RANK, level) ? LEVEL_RANK[level] : 0) < (q.allow === 'warn' ? 1 : 2);\n}\n\n// Webhook templates: \"{{a.b.0.c}}\" is replaced by that value of the JSON the sender posted. Plain text replacement, nothing is evaluated.\nfunction lookup(data, pathText) {\n    var parts = pathText.split('.'), cur = data, i;\n    for (i = 0; i < parts.length; i++) {\n        if (cur === null || typeof cur !== 'object' || !has(cur, parts[i])) { return ''; }\n        cur = cur[parts[i]];\n    }\n    if (cur === null || cur === undefined) { return ''; }\n    return typeof cur === 'object' ? JSON.stringify(cur) : str(cur);\n}\nfunction render(tpl, data) {\n    return str(tpl).replace(/\\{\\{\\s*([A-Za-z0-9_.-]{1,60})\\s*\\}\\}/g, function (m, p) { return lookup(data, p); });\n}\nfunction sanitizeHook(h) {\n    h = isObj(h) ? h : {};\n    var t = function (v, max) { return str(v).replace(/[\\x00-\\x1f]/g, ' ').slice(0, max || MAX_TEMPLATE); };\n    return {\n        title: t(h.title), message: t(h.message), level: t(h.level, 40), icon: t(h.icon, 40),\n        mode: has(MODES, h.mode) ? h.mode : '', duration: clampInt(h.duration, 1, 60, 0), source: cleanSource(h.source),\n        sound: hasSound(h.sound) ? h.sound : '', volume: storedVolume(h.volume)\n    };\n}\n// Builds the notify body from a hook definition and the posted data.\nfunction buildFromHook(hook, data) {\n    var level = render(hook.level, data).trim().toLowerCase();\n    var b = { title: render(hook.title, data), message: render(hook.message, data), icon: render(hook.icon, data) };\n    if (has(LEVELS, level)) { b.level = level; }\n    if (hook.mode) { b.mode = hook.mode; }\n    if (hook.duration) { b.duration = hook.duration; }\n    if (hook.sound) { b.sound = hook.sound; }\n    if (hook.volume) { b.volume = hook.volume; }\n    return b;\n}\n\nmodule.exports = {\n    cleanCategory: cleanCategory,\n    clampVolume: clampVolume, storedVolume: storedVolume,\n    LEVEL_RANK: LEVEL_RANK, LEVELS: LEVELS, MODES: MODES, THEMES: THEMES, CUSTOM_THEMES: CUSTOM_THEMES, hasTheme: hasTheme, PRIORITIES: PRIORITIES, SOUNDS: SOUNDS, CUSTOM: CUSTOM, hasSound: hasSound, MAX_SOURCES: MAX_SOURCES, MAX_HOOKS: MAX_HOOKS, MAX_TEMPLATE: MAX_TEMPLATE, MAX_RATE: MAX_RATE,\n    str: str, num: num, has: has, isObj: isObj,\n    cleanSource: cleanSource, cleanHookName: cleanHookName, sameKey: sameKey, KEY_RE: KEY_RE,\n    sanitizeProfile: sanitizeProfile, publicProfile: publicProfile, applyProfile: applyProfile, makeLimiter: makeLimiter,\n    sanitizeSettings: sanitizeSettings, defaultSettings: defaultSettings, isQuiet: isQuiet,\n    render: render, sanitizeHook: sanitizeHook, buildFromHook: buildFromHook\n};\n","ui.html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"dark\">\n<title>Notification Center</title>\n<style>\n/* The look of the Vetro dashboard: tokens from app/design-system/tokens.css, controls from app/service/dashboard.js\n   (andrearicci93/vetro). Dark only, as the dashboard. */\n:root { color-scheme: dark;\n  --bg: #080f23; --surface: #101c35; --raised: #192943; --text: #f5f8ff; --muted: #aab8d1; --border: #344360; --control: #7183a2;\n  --action: #123bb5; --action-hover: #0e3095; --accent: #8fbaff; --accent-soft: rgba(143, 186, 255, .14); --accent-line: rgba(143, 186, 255, .4);\n  --ok: #7fcba0; --ok-soft: rgba(127, 203, 160, .12); --ok-line: rgba(127, 203, 160, .4);\n  --warn: #e2b867; --warn-soft: rgba(226, 184, 103, .12); --warn-line: rgba(226, 184, 103, .4);\n  --danger: #ef8a80; --danger-soft: rgba(239, 138, 128, .12); --danger-line: rgba(239, 138, 128, .4);\n  --r: 8px; --r-surface: 16px; --pill: 999px; --fast: 120ms; --ease: cubic-bezier(.2, 0, 0, 1);\n  --mono: ui-monospace, SFMono-Regular, Consolas, monospace; }\n* { box-sizing: border-box; scrollbar-width: none; -ms-overflow-style: none; }\n*::-webkit-scrollbar { width: 0; height: 0; display: none; }\nbody { margin: 0; background: var(--bg); color: var(--text); font: 1rem/1.5 -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; -webkit-font-smoothing: antialiased; }\n.app { max-width: 1240px; margin: 0 auto; padding: 24px 24px 48px; }\nh1, h2, h3 { font-weight: 500; overflow-wrap: anywhere; }\nh1 { font-size: 1.5rem; line-height: 1.2; margin: 0; }\nh2 { font-size: 1.125rem; margin: 0 0 12px; }\nh3 { font-size: 1rem; margin: 0 0 8px; }\np { margin: 0; }\nul { list-style: none; margin: 0; padding: 0; }\na { color: var(--accent); }\ncode, pre { font-family: var(--mono); font-size: .875rem; }\ncode { background: var(--raised); border-radius: var(--r); padding: 1px 6px; overflow-wrap: anywhere; }\npre { background: var(--bg); border: 1px solid var(--border); border-radius: var(--r); padding: 12px 16px; white-space: pre-wrap; word-break: break-all; margin: 0; }\n[hidden] { display: none !important; }\n\n/* controls */\nbutton, input, select, textarea { font: inherit; color: var(--text); border: 1px solid var(--control); border-radius: var(--r); background: var(--raised); }\nbutton, select, input[type=text] { min-height: 44px; padding: 8px 16px; }\nbutton { cursor: pointer; max-width: 100%; overflow-wrap: anywhere; }\nbutton:hover:not(:disabled) { background: var(--border); }\nbutton:disabled { opacity: .45; cursor: default; }\ninput[type=text], select { width: 100%; min-width: 0; margin-bottom: 8px; }\ninput::placeholder, textarea::placeholder { color: var(--muted); }\ntextarea { width: 100%; padding: 12px; margin-top: 8px; font: 1rem/1.5 var(--mono); resize: vertical; }\ninput[type=range] { min-height: 44px; border: 0; background: none; accent-color: var(--accent); }\ninput[type=file] { max-width: 100%; padding: 8px; color: var(--muted); font-size: .875rem; }\ninput[type=file]::file-selector-button { min-height: 44px; margin-right: 12px; padding: 0 12px; border: 1px solid var(--control); border-radius: var(--r); background: var(--surface); color: var(--text); font: inherit; cursor: pointer; }\nbutton:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible, summary:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }\n.send { background: var(--action); border-color: var(--action); font-weight: 500; }\n.send:hover:not(:disabled) { background: var(--action-hover); border-color: var(--action-hover); }\n.ghost { font-size: .875rem; }\n.ghost.on { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }\n.danger { color: var(--danger); border-color: var(--danger-line); background: var(--danger-soft); }\n.danger:hover:not(:disabled) { background: var(--danger-soft); border-color: var(--danger); }\nbutton.busy { opacity: .65; pointer-events: none; }\nbutton.busy::after { content: \"\"; display: inline-block; width: 10px; height: 10px; margin-left: 8px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: sp .7s linear infinite; vertical-align: -1px; }\nbutton.done { color: var(--ok) !important; border-color: var(--ok-line) !important; background: var(--ok-soft) !important; }\nbutton.fail { color: var(--danger) !important; border-color: var(--danger) !important; background: var(--danger-soft) !important; }\n@keyframes sp { to { transform: rotate(360deg); } }\n\n/* switch: the name on the left, the switch and On / Off on the right */\n.setting { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin: 8px 0; }\n.setting > label:first-child { flex: 1; min-width: 0; cursor: pointer; }\n.switch { display: flex; min-height: 44px; align-items: center; gap: 12px; cursor: pointer; flex: none; }\n.switch input { appearance: none; -webkit-appearance: none; width: 40px; height: 24px; margin: 0; padding: 0; border: 1px solid var(--control); border-radius: var(--pill); background: var(--raised); position: relative; flex-shrink: 0; cursor: pointer; transition: background var(--fast) var(--ease); }\n.switch input::before { content: \"\"; position: absolute; left: 3px; top: 3px; width: 16px; height: 16px; border-radius: 50%; background: var(--muted); transition: transform var(--fast) var(--ease), background var(--fast) var(--ease); }\n.switch input:checked { background: var(--action); border-color: var(--accent); }\n.switch input:checked::before { transform: translateX(16px); background: var(--text); }\n.switch input:disabled { opacity: .45; cursor: default; }\n.switch span { font-size: .875rem; color: var(--muted); min-width: 24px; }\n.switch span::after { content: \"Off\"; }\n.switch input:checked + span::after { content: \"On\"; }\nhtml[lang=pt] .switch span { min-width: 80px; }\nhtml[lang=pt] .switch span::after { content: \"Desligado\"; }\nhtml[lang=pt] .switch input:checked + span::after { content: \"Ligado\"; }\n\n/* header */\n.top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px; }\n.brand { display: flex; align-items: center; gap: 12px; }\n.logo { width: 44px; height: 44px; border-radius: 22%; background: linear-gradient(135deg, #00115b 0%, #123bb5 48%, #1674fb 100%); display: grid; place-items: center; flex: none; }\n.sub { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 4px; min-height: 24px; }\n.chip { display: inline-flex; align-items: center; gap: 4px; min-height: 24px; padding: 2px 8px; border: 1px solid var(--border); border-radius: var(--pill); font-size: .875rem; line-height: 1.35; color: var(--muted); }\n.chip::before { content: \"\"; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }\n.chip.g { color: var(--ok); border-color: var(--ok-line); background: var(--ok-soft); }\n.chip.y { color: var(--warn); border-color: var(--warn-line); background: var(--warn-soft); }\n.chip.r { color: var(--danger); border-color: var(--danger-line); background: var(--danger-soft); }\n\n/* segmented views (language, how it appears) */\n.lang, .modes { display: flex; flex-wrap: wrap; gap: 4px; padding: 4px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r); }\n.lang button, .md { border: 0; background: transparent; color: var(--muted); }\n.md { flex: 1 0 auto; white-space: nowrap; }\n.lang button:hover:not(:disabled), .md:hover:not(:disabled) { background: var(--raised); color: var(--text); }\n.lang button.on, .lang button.on:hover:not(:disabled), .md.on, .md.on:hover:not(:disabled) { background: var(--accent-soft); color: var(--accent); font-weight: 500; }\n\n/* tabs */\n.dtabs { display: flex; gap: 4px; border-bottom: 1px solid var(--border); margin-bottom: 24px; overflow: auto hidden; }\n.dtabs button { flex: none; border: 0; border-bottom: 2px solid transparent; border-radius: 0; background: transparent; color: var(--muted); white-space: nowrap; margin-bottom: -1px; }\n.dtabs button:focus-visible { outline-offset: -2px; }\n.dtabs button:hover:not(:disabled) { color: var(--text); background: transparent; }\n.dtabs button.on, .dtabs button.on:hover:not(:disabled) { color: var(--text); font-weight: 500; border-bottom-color: var(--accent); }\n\n/* filter chips (request formats, emoji groups) */\n.tabs, .ecats { display: flex; gap: 8px; flex-wrap: wrap; }\n.tabs { margin-bottom: 12px; }\n.ecats { margin-top: 8px; }\n.tab, .ecats button { border-radius: var(--pill); padding: 0 12px; font-size: .875rem; }\n.tab.on, .tab.on:hover:not(:disabled), .ecats button.on, .ecats button.on:hover:not(:disabled) { color: var(--accent); background: var(--accent-soft); border-color: var(--accent-line); }\n\n/* layout and cards */\n.layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 24px; align-items: start; }\n.col, .dev { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-surface); }\n.sec { padding: 16px 24px; border-bottom: 1px solid var(--border); }\n.pane { padding: 16px 24px; }\ndetails.more { border-bottom: 1px solid var(--border); }\ndetails.more > summary { cursor: pointer; min-height: 44px; padding: 12px 24px; color: var(--muted); }\ndetails.more > summary:hover, details.more[open] > summary { color: var(--text); }\ndetails.more > .inner { padding: 0 24px 16px; }\n.hint, .note { color: var(--muted); font-size: .875rem; line-height: 1.6; }\n.hint { margin: 8px 0 0; }\n.row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }\n.row > input[type=text], .row > select { margin-bottom: 0; }\n.stack input:last-child { margin-bottom: 0; }\n.exgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; margin: 8px 0; }\n.exbtn { text-align: left; padding: 12px 16px; }\n.exbtn b { display: block; font-weight: 500; }\n.exbtn small { display: block; color: var(--muted); font-size: .875rem; }\n\n/* level picker */\n.levels { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-bottom: 12px; }\n.lv { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 8px; color: var(--muted); }\n.lv i { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; flex: none; margin: 0; }\n.lv i svg { width: 14px; height: 14px; }\n.lv.on, .lv.on:hover:not(:disabled) { color: var(--accent); background: var(--accent-soft); border-color: var(--accent); }\n\n/* footer of the composer */\n.foot { display: flex; flex-direction: column; align-items: stretch; gap: 16px; padding: 16px 24px; }\n.dur { display: flex; align-items: center; gap: 12px; min-width: 0; color: var(--muted); font-size: .875rem; }\n.dur input { flex: 1; margin: 0; }\n.dur b { color: var(--text); min-width: 40px; text-align: right; font-weight: 500; font-variant-numeric: tabular-nums; }\n.msg { min-height: 20px; font-size: .875rem; color: var(--muted); }\n.col > .msg { padding: 0 24px 16px; }\n.ok { color: var(--ok); } .err { color: var(--danger); }\n\n/* stage */\n.stage { display: flex; flex-direction: column; gap: 12px; }\n.tv { background: #04060a; border: 1px solid var(--border); border-radius: var(--r-surface); padding: 8px; }\n.scene { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; border-radius: var(--r); background: #0a1120; }\n.rhead { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; }\n.rhead h2 { margin: 0; }\n#recent li { display: flex; gap: 12px; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--border); }\n#recent li:last-child { border: 0; }\n#recent li div { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n#recent li b { font-weight: 500; }\n#recent li small { display: block; color: var(--muted); font-size: .875rem; }\n.dot { width: 8px; height: 8px; border-radius: 50%; flex: none; background: var(--c); }\n.empty { color: var(--muted); text-align: center; padding: 24px; }\n@keyframes ncSlide { 0% { opacity: 0; transform: translateX(90px); } 14%, 84% { opacity: 1; transform: translateX(0); } 100% { opacity: 0; transform: translateX(90px); } }\n@keyframes ncFade { 0%, 4% { opacity: 0; } 14%, 84% { opacity: 1; } 96%, 100% { opacity: 0; } }\n.sc-banner { animation: ncSlide 6s ease-in-out infinite; }\n.sc-card { animation: ncFade 6s ease-in-out infinite; }\n\n/* icon picker and popup */\n.modal { position: fixed; inset: 0; background: rgba(0, 8, 35, .74); display: grid; place-items: center; padding: 20px; z-index: 50; }\n.dlg { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-surface); padding: 24px; width: min(760px, 100%); max-height: 90vh; overflow: auto; box-shadow: 0 12px 32px rgba(0, 8, 35, .24); }\n.dhead { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }\n.dhead h2 { margin: 0; }\n.egrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(44px, 1fr)); gap: 4px; margin-top: 8px; }\n.egrid button { font-size: 26px; background: none; border: 0; padding: 4px; }\n\n/* rules, status and API */\n.rl { cursor: pointer; padding: 12px 16px; border: 1px solid var(--border); border-radius: var(--r); margin-bottom: 8px; }\n.rl:hover { background: var(--raised); }\n.rl b { font-weight: 500; }\n.rl small { display: block; color: var(--muted); font-size: .875rem; }\n.rulesgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }\n.rulesgrid > * { min-width: 0; }\n.lab { font-size: .875rem; color: var(--muted); margin: 8px 0 4px; }\ntable.api { display: block; overflow-x: auto; width: 100%; border-collapse: collapse; font-size: .875rem; margin: 4px 0 12px; }\ntable.api th, table.api td { text-align: left; padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }\ntable.api th { color: var(--muted); font-weight: 500; }\n#apiroutes li { padding: 4px 0; color: var(--muted); font-size: .875rem; }\n.apiform { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 12px; margin-bottom: 12px; }\n.af { display: flex; flex-direction: column; gap: 4px; font-size: .875rem; color: var(--muted); }\n.af input, .af select { margin: 0; }\n.appcols { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }\n.appcols > * { min-width: 0; }\n#statuslist li { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--border); }\n#statuslist li:last-child { border: 0; }\n#statuslist b { font-weight: 500; }\n#statuslist small { display: block; color: var(--muted); font-size: .875rem; }\n.dotc { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-top: 8px; flex: none; }\n.dotc.g { background: var(--ok); } .dotc.r { background: var(--danger); } .dotc.y { background: var(--warn); }\n@media (max-width: 1000px) { .layout, .appcols { grid-template-columns: minmax(0, 1fr); } }\n@media (max-width: 620px) { .app { padding: 16px 12px 48px; } .sec, .pane, .foot, details.more > summary, details.more > .inner { padding-left: 16px; padding-right: 16px; } .rulesgrid { grid-template-columns: 1fr; } }\n@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }\n@media (forced-colors: active) { .switch input { appearance: auto; -webkit-appearance: auto; } .switch input::before { display: none; } }\n\n/* Vetro components: one card per group, rows with a state chip, inline confirmation, toast, side drawer, disclosure */\n.lead { color: var(--muted); margin-top: 4px; }\n.col, .dev { background: none; border: 0; border-radius: 0; }\n.col { display: flex; flex-direction: column; gap: 16px; }\n.sec, details.more, .panel { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-surface); }\n.foot { padding: 0; }\n.col > .msg { padding: 0; }\n.col > .msg:empty { display: none; }\n.pane { padding: 0; }\n.panel { padding: 16px 24px; min-width: 0; }\n.panel + .panel, .appcols + .panel { margin-top: 16px; }\n.panel h4 { font-size: 1rem; font-weight: 500; margin: 24px 0 8px; }\n.panel > h3 { display: flex; align-items: center; gap: 12px; font-size: 1.125rem; margin: 0 0 12px; }\n.section-icon { width: 26px; height: 26px; flex: none; fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }\nlabel.lab { display: block; }\n#statuslist li { align-items: center; justify-content: space-between; }\n#statuslist li > div { min-width: 0; }\n.table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--r); margin-bottom: 12px; }\ntable.api { display: table; margin: 0; }\ntable.api tr:last-child td { border-bottom: 0; }\ndetails.help { margin-top: 8px; }\ndetails.help summary { cursor: pointer; min-height: 44px; padding: 10px 0; width: max-content; max-width: 100%; color: var(--muted); font-size: .875rem; }\ndetails.help summary:hover { color: var(--text); }\n.inline-confirm { background: var(--warn-soft); border: 1px solid var(--warn-line); border-radius: var(--r); padding: 12px 16px; margin-top: 12px; font-size: .875rem; }\n.inline-confirm p { margin: 0 0 12px; }\n.inline-confirm .warnbtn { background: var(--warn); border-color: var(--warn); color: #101c35; font-weight: 500; }\n.inline-confirm .warnbtn:hover:not(:disabled) { background: var(--warn); border-color: #101c35; }\n.msg.ok { display: none; }\n#toast { position: fixed; left: 50%; bottom: 16px; transform: translateX(-50%); display: flex; align-items: center; gap: 12px; width: max-content; max-width: min(440px, calc(100% - 32px)); padding: 8px 16px; border: 1px solid var(--ok-line); border-radius: var(--r); background: rgba(16, 28, 53, .88); backdrop-filter: blur(8px); font-size: .875rem; overflow-wrap: anywhere; pointer-events: none; z-index: 60; }\n#toast::before { content: \"\"; width: 14px; height: 8px; flex: none; border-left: 2px solid var(--ok); border-bottom: 2px solid var(--ok); transform: rotate(-45deg); }\n.modal { place-items: stretch end; padding: 0; }\n.dlg { width: min(480px, 100%); max-height: none; height: 100%; border-width: 0 0 0 1px; border-radius: 0; }\n@media (max-width: 620px) { .panel { padding: 16px; } }\n\n/* usability: the preview stays in view, time fields, list entries that are buttons, three levels in a row */\n@media (min-width: 1001px) { .stage { position: sticky; top: 16px; } }\ninput[type=time] { min-height: 44px; width: 100%; min-width: 0; margin-bottom: 8px; padding: 8px 16px; }\ninput:disabled, select:disabled { opacity: .45; cursor: default; }\n.levels { grid-template-columns: repeat(3, 1fr); }\nbutton.rl { display: block; width: 100%; text-align: left; background: transparent; border-color: var(--border); }\nbutton.rl[aria-pressed=true] { border-color: var(--accent-line); background: var(--accent-soft); }\n@media (max-width: 420px) { .levels { grid-template-columns: 1fr; } }\n/* the top bar of every Shard: one row across the whole width (name, state chips, language) */\n.app { padding-top: 16px; }\n.top { gap: 12px 16px; margin-bottom: 12px; }\n.brand { flex: 1 1 360px; min-width: 0; }\nh1 { font-size: 1.25rem; }\n.lead { margin-top: 0; font-size: .875rem; }\n.sub { margin: 0 0 0 auto; justify-content: flex-end; align-items: center; }\n.chip.plain::before { display: none; }\n.dtabs { margin-bottom: 16px; }\n@media (max-width: 620px) { .brand { flex: 1 1 0; } .lead { display: none; } .lang { order: 1; } .sub { order: 2; flex-basis: 100%; justify-content: flex-start; margin: 0; } }\n.rl .chip { margin-left: 8px; }\n#recent li div { white-space: normal; }\nbutton.chip { cursor: pointer; background: var(--danger-soft); }\n@media (max-width: 480px) { .md { flex-basis: 40%; } }\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <header class=\"top\">\n    <div class=\"brand\">\n      <div class=\"logo\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9a6 6 0 0 1 12 0c0 6 2 7 2 7H4s2-1 2-7\"/><path d=\"M10 19a2 2 0 0 0 4 0\"/></svg></div>\n      <div>\n        <h1 data-t=\"title\">Notification Center</h1>\n        <p class=\"lead\" data-t=\"lead\">Send messages to this TV and choose how they look.</p>\n      </div>\n    </div>\n    <div class=\"sub\" id=\"chips\" role=\"status\"></div>\n    <div class=\"lang\" role=\"group\" aria-label=\"Language / Idioma\"><button type=\"button\" id=\"l-en\">EN</button><button type=\"button\" id=\"l-pt\">PT</button></div>\n  </header>\n\n  <nav class=\"dtabs\" role=\"tablist\">\n    <button type=\"button\" role=\"tab\" aria-selected=\"true\" class=\"on\" data-pane=\"p-main\" data-t=\"tab_main\">Send</button>\n    <button type=\"button\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\" data-pane=\"p-test\" data-t=\"test_tab\">Try it</button>\n    <button type=\"button\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\" data-pane=\"p-rules\" data-t=\"rules_tab\">Senders and rules</button>\n    <button type=\"button\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\" data-pane=\"p-set\" data-t=\"set_tab\">Settings</button>\n    <button type=\"button\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\" data-pane=\"p-tech\" data-t=\"tech_tab\">System</button>\n  </nav>\n\n  <main class=\"layout\" id=\"p-main\">\n    <aside class=\"stage\">\n      <div class=\"tv\"><svg id=\"scene\" class=\"scene\" viewBox=\"0 0 1920 1080\" role=\"img\" font-family=\"SamsungOneUI, system-ui, Segoe UI, sans-serif\" font-weight=\"500\">\n      <defs>\n        <linearGradient id=\"tvSky\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#101c3f\"/><stop offset=\".45\" stop-color=\"#553b73\"/><stop offset=\".72\" stop-color=\"#d9707a\"/><stop offset=\"1\" stop-color=\"#f6b26b\"/></linearGradient>\n        <radialGradient id=\"tvSun\" cx=\".5\" cy=\".5\" r=\".5\"><stop offset=\"0\" stop-color=\"#fff2cf\" stop-opacity=\".95\"/><stop offset=\".35\" stop-color=\"#ffc58a\" stop-opacity=\".5\"/><stop offset=\"1\" stop-color=\"#ffc58a\" stop-opacity=\"0\"/></radialGradient>\n        <linearGradient id=\"tvWater\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#f0a26c\"/><stop offset=\"1\" stop-color=\"#1a2547\"/></linearGradient>\n      </defs>\n      <rect width=\"1920\" height=\"1080\" fill=\"url(#tvSky)\"/><circle cx=\"1330\" cy=\"640\" r=\"420\" fill=\"url(#tvSun)\"/><circle cx=\"1330\" cy=\"640\" r=\"64\" fill=\"#fff0c9\"/>\n      <path d=\"M0 690 220 520 420 640 640 470 880 650 1080 560 1290 690 1500 540 1740 660 1920 590V760H0z\" fill=\"#42375f\"/>\n      <path d=\"M0 760 180 640 400 740 640 620 900 760 1160 650 1420 770 1680 670 1920 740V800H0z\" fill=\"#26274a\"/>\n      <rect y=\"780\" width=\"1920\" height=\"300\" fill=\"url(#tvWater)\"/>\n      <rect x=\"1250\" y=\"790\" width=\"160\" height=\"6\" rx=\"3\" fill=\"#ffe3b3\" opacity=\".7\"/><rect x=\"1280\" y=\"820\" width=\"100\" height=\"5\" rx=\"2\" fill=\"#ffe3b3\" opacity=\".45\"/><rect x=\"1300\" y=\"850\" width=\"60\" height=\"4\" rx=\"2\" fill=\"#ffe3b3\" opacity=\".3\"/>\n      <path d=\"M0 900 0 1080H1920V920C1700 880 1500 930 1250 900 900 860 600 930 0 900z\" fill=\"#0d1530\" opacity=\".55\"/>\n      <g id=\"dyn\"></g>\n    </svg></div>\n      <p class=\"note\" data-t=\"prevnote\">The TV shows its own native banner; this is only an approximation.</p>\n    </aside>\n\n    <section class=\"col\">\n      <div class=\"sec\">\n        <h2 data-t=\"s2\">Choose how it looks</h2>\n        <div class=\"lab\" data-t=\"lab_kind\">What kind of message is it?</div>\n        <div class=\"levels\" id=\"levels\"></div>\n        <div class=\"lab\" data-t=\"lab_how\">How should it appear on the TV?</div>\n        <div class=\"modes\" id=\"modes\"></div>\n        <div class=\"hint\" id=\"modehint\"></div>\n      </div>\n      <div class=\"sec\">\n        <h2 data-t=\"s1\">Write the message</h2>\n        <label class=\"lab\" for=\"title\" data-t=\"f_title\">Title (optional)</label>\n        <input type=\"text\" id=\"title\" maxlength=\"40\" data-p=\"ph_title\">\n        <label class=\"lab\" for=\"message\" data-t=\"f_msg\">Message</label>\n        <input type=\"text\" id=\"message\" maxlength=\"200\" data-p=\"ph_msg\">\n      </div>\n      <details class=\"more\">\n        <summary data-t=\"more\">More options (sound, pictures, how long)</summary>\n        <div class=\"inner\">\n          <label class=\"lab\" for=\"sound\" data-t=\"lab_sound\">Sound</label>\n          <div class=\"row\"><select id=\"sound\" style=\"flex:1\"></select><span style=\"display:flex;align-items:center;gap:8px;flex:1;min-width:200px\"><span class=\"lab\" style=\"margin:0\" data-t=\"f_mvol\">Sound volume (%)</span><input type=\"range\" id=\"mvol\" min=\"10\" max=\"100\" step=\"5\" value=\"100\" style=\"flex:1;min-width:80px\"><b id=\"mvolv\">100%</b></span></div>\n          <label class=\"lab\" for=\"image\" data-t=\"lab_pic\">Picture (only used where the look has room for one)</label>\n          <div class=\"stack\"><input type=\"text\" id=\"image\" maxlength=\"290\" data-p=\"ph_image\"><input type=\"text\" id=\"app\" maxlength=\"64\" data-p=\"ph_app\"></div>\n          <label class=\"lab\" for=\"theme\" data-t=\"lab_wall\">Background of the full-screen card</label>\n          <div class=\"stack\"><select id=\"theme\"><option value=\"\">-</option></select><input type=\"text\" id=\"wallpaper\" maxlength=\"290\" data-p=\"ph_wall\"></div>\n          <label class=\"lab\" for=\"priority\" data-t=\"lab_prio\">How urgent is it?</label>\n          <select id=\"priority\"><option value=\"\" data-t=\"pr_normal\">Normal</option><option value=\"high\" data-t=\"pr_high\">High: first in line, shown even in quiet hours</option></select>\n          <label class=\"lab\" for=\"act_app\" data-t=\"lab_act\">A button on the full-screen card that opens an app</label>\n          <div class=\"row\"><input type=\"text\" id=\"act_app\" list=\"applist\" maxlength=\"64\" data-p=\"ph_actapp\" style=\"flex:1\"><input type=\"text\" id=\"act_label\" maxlength=\"24\" data-p=\"ph_actlabel\" style=\"flex:1\"></div>\n          <datalist id=\"applist\"></datalist>\n          <label class=\"lab\" for=\"icon\" data-t=\"lab_icon\">A different icon (an emoji)</label>\n          <div class=\"row\"><input type=\"text\" id=\"icon\" maxlength=\"16\" data-p=\"ph_icon\" style=\"flex:1\"><button type=\"button\" id=\"iconpick\" data-t=\"pick\">Choose icon</button></div>\n          <div class=\"dur\"><span data-t=\"secs\">Show for (s)</span><input type=\"range\" id=\"secs\" min=\"1\" max=\"60\" value=\"8\"><b id=\"secsv\">8 s</b></div>\n          <div class=\"setting\"><label for=\"open\" id=\"open-name\" data-t=\"open\">Show on TV now</label><label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"open\" aria-labelledby=\"open-name\" checked><span aria-hidden=\"true\"></span></label></div>\n        </div>\n      </details>\n      <div class=\"foot\">\n        <button class=\"send\" id=\"send\" type=\"button\" data-t=\"btn\">Send</button>\n      </div>\n      <div class=\"msg\" id=\"result\"></div>\n    </section>\n  </main>\n\n  <section class=\"dev\" id=\"devwrap\" hidden>\n    <div class=\"pane\" id=\"p-rules\" hidden>\n      <div class=\"appcols\">\n        <div>\n          <h3 data-t=\"src_title\">Sources</h3>\n          <div class=\"msg\" style=\"padding:0 0 8px\" data-t=\"src_note\">One entry per sender. Its defaults fill in what a request leaves out; a key makes it require the header X-NC-Key.</div>\n          <ul id=\"srclist\"></ul>\n          <div class=\"row\"><button type=\"button\" id=\"s_add\" data-t=\"s_add\">Add a sender</button></div>\n          <h3 data-t=\"r_title\">Repeats and unknown senders</h3>\n          <label class=\"lab\" for=\"g_secs\" data-t=\"g_secs\">Count repeats inside (s, 0 = off)</label>\n          <input type=\"text\" id=\"g_secs\" inputmode=\"numeric\" maxlength=\"4\">\n          <div class=\"setting\"><label for=\"g_strict\" id=\"g_strict-name\" data-t=\"g_strict\">Refuse senders that have no source entry</label><label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"g_strict\" aria-labelledby=\"g_strict-name\"><span aria-hidden=\"true\"></span></label></div>\n          <div class=\"row\"><button type=\"button\" class=\"send\" id=\"r_save\" data-t=\"save\">Save</button></div>\n          <div class=\"msg\" id=\"rmsg\"></div>\n          <h3 style=\"margin-top:22px\" data-t=\"h_title\">Webhooks</h3>\n          <div class=\"msg\" style=\"padding:0 0 8px\" data-t=\"h_note\">Turn any JSON a service already sends into a notification. Use {{path.to.value}} from the JSON in the texts.</div>\n          <ul id=\"hooklist\"></ul>\n          <div class=\"rulesgrid\" style=\"margin-top:10px\">\n            <div><label class=\"lab\" for=\"h_name\" data-t=\"f_name\">Name</label><input type=\"text\" id=\"h_name\" maxlength=\"24\" placeholder=\"github\"></div>\n            <div><label class=\"lab\" for=\"h_icon\" data-t=\"f_icon\">Icon</label><input type=\"text\" id=\"h_icon\" maxlength=\"16\"></div>\n          </div>\n          <label class=\"lab\" for=\"h_ttl\" data-t=\"h_ttl\">Title template</label><input type=\"text\" id=\"h_ttl\" maxlength=\"200\" placeholder=\"{{repository.name}}\">\n          <label class=\"lab\" for=\"h_msg\" data-t=\"h_msg\">Message template (required)</label><input type=\"text\" id=\"h_msg\" maxlength=\"200\" placeholder=\"{{pusher.name}} pushed {{head_commit.message}}\">\n          <div class=\"rulesgrid\">\n            <div><label class=\"lab\" for=\"h_level\" data-t=\"f_level\">Level</label><input type=\"text\" id=\"h_level\" maxlength=\"40\" placeholder=\"info\"></div>\n            <div><label class=\"lab\" for=\"h_src\" data-t=\"h_src\">Source (default: the name)</label><input type=\"text\" id=\"h_src\" maxlength=\"32\"></div>\n            <div><label class=\"lab\" for=\"h_sound\" data-t=\"f_sound\">Sound</label><select id=\"h_sound\"></select></div>\n          </div>\n          <div class=\"row\"><button type=\"button\" class=\"send\" id=\"h_save\" data-t=\"save\">Save</button><button type=\"button\" class=\"ghost danger\" id=\"h_del\" data-t=\"del\">Delete</button></div>\n          <div class=\"msg\" id=\"hmsg\" style=\"padding:8px 0 0\"></div>\n          <pre id=\"hurl\" hidden></pre>\n        </div>\n        <div>\n          <h3 data-t=\"ed_title\">Sender</h3>\n          <div class=\"rulesgrid\" style=\"margin-top:10px\">\n            <div><label class=\"lab\" for=\"s_name\" data-t=\"f_name\">Name</label><input type=\"text\" id=\"s_name\" maxlength=\"32\" placeholder=\"doorbell\"></div>\n            <div><label class=\"lab\" for=\"s_icon\" data-t=\"f_icon\">Icon</label><input type=\"text\" id=\"s_icon\" maxlength=\"16\"></div>\n            <div><label class=\"lab\" for=\"s_level\" data-t=\"f_level\">Level</label><select id=\"s_level\"><option value=\"\"></option><option>info</option><option>ok</option><option>warn</option><option>alert</option></select></div>\n            <div><label class=\"lab\" for=\"s_mode\" data-t=\"f_mode\">Show as</label><select id=\"s_mode\"><option value=\"\"></option><option>banner</option><option>full</option><option>both</option><option>overlay</option><option>glass</option><option>panel</option></select></div>\n            <div><label class=\"lab\" for=\"s_theme\" data-t=\"f_theme\">Default wallpaper</label><select id=\"s_theme\"><option value=\"\"></option></select></div>\n            <div><label class=\"lab\" for=\"s_priority\" data-t=\"lab_prio\">How urgent is it?</label><select id=\"s_priority\"><option value=\"\">normal</option><option value=\"high\">high</option></select></div>\n            <div><label class=\"lab\" for=\"s_dur\" data-t=\"f_dur\">Duration (s)</label><input type=\"text\" id=\"s_dur\" inputmode=\"numeric\" maxlength=\"2\"></div>\n            <div><label class=\"lab\" for=\"s_rate\" data-t=\"f_rate\">Max per minute (0 = no limit)</label><input type=\"text\" id=\"s_rate\" inputmode=\"numeric\" maxlength=\"3\"></div>\n            <div><label class=\"lab\" for=\"s_sound\" data-t=\"f_sound\">Sound</label><select id=\"s_sound\"></select></div>\n            <div><label class=\"lab\" for=\"s_vol\" data-t=\"f_vol\">Volume (%)</label><input type=\"text\" id=\"s_vol\" inputmode=\"numeric\" maxlength=\"3\"></div>\n          </div>\n          <div class=\"setting\"><label for=\"s_on\" id=\"s_on-name\" data-t=\"f_enabled\">Enabled</label><label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"s_on\" aria-labelledby=\"s_on-name\" checked><span aria-hidden=\"true\"></span></label></div>\n          <h4 data-t=\"al_title\">What this sender may decide</h4>\n          <div class=\"setting\"><label for=\"s_asound\" id=\"s_asound-name\" data-t=\"s_asound\">Choose the sound</label><label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"s_asound\" aria-labelledby=\"s_asound-name\" checked><span aria-hidden=\"true\"></span></label></div>\n          <div class=\"setting\"><label for=\"s_amode\" id=\"s_amode-name\" data-t=\"s_amode\">Choose how it appears</label><label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"s_amode\" aria-labelledby=\"s_amode-name\" checked><span aria-hidden=\"true\"></span></label></div>\n          <div class=\"setting\"><label for=\"s_aurgent\" id=\"s_aurgent-name\" data-t=\"s_aurgent\">Send urgent ones (they pass quiet hours)</label><label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"s_aurgent\" aria-labelledby=\"s_aurgent-name\" checked><span aria-hidden=\"true\"></span></label></div>\n          <div class=\"msg\" id=\"s_why\" aria-live=\"polite\" style=\"padding:0 0 8px;white-space:pre-line\"></div>\n          <h4 data-t=\"cat_title\">Categories</h4>\n          <div id=\"s_cats\"></div>\n          <div class=\"row\"><button type=\"button\" class=\"send\" id=\"s_save\" data-t=\"save\">Save</button><button type=\"button\" class=\"ghost\" id=\"s_key\" data-t=\"gen_key\">New key</button><button type=\"button\" class=\"ghost\" id=\"s_clearkey\" data-t=\"clear_key\">Remove key</button><button type=\"button\" class=\"ghost danger\" id=\"s_del\" data-t=\"del\">Delete</button><button type=\"button\" id=\"s_test\" data-t=\"b_test\">Test</button></div>\n          <div class=\"msg\" id=\"srcmsg\" style=\"padding:8px 0 0\"></div>\n          <pre id=\"srckey\" hidden></pre>\n        </div>\n      </div>\n    </div>\n    <div class=\"pane\" id=\"p-test\" hidden>\n      <div class=\"appcols\">\n        <div>\n          <h3 data-t=\"ex_title\">Try an example</h3>\n          <div class=\"msg\" style=\"padding:0 0 4px\" data-t=\"ex_note\">One click sends a real notification to your TV, so you can see what it looks like.</div>\n          <div class=\"exgrid\">\n            <button type=\"button\" class=\"exbtn\" data-ex=\"goal\"><b data-t=\"ex_goal\">Goal alert</b><small data-t=\"ex_goal_d\">Toast bar, goal sound, sport look</small></button>\n            <button type=\"button\" class=\"exbtn\" data-ex=\"civil\"><b data-t=\"ex_civil\">Civil protection</b><small data-t=\"ex_civil_d\">Urgent red warning on the full screen</small></button>\n            <button type=\"button\" class=\"exbtn\" data-ex=\"weather\"><b data-t=\"ex_weather\">Weather</b><small data-t=\"ex_weather_d\">Toast bar with a soft sound</small></button>\n            <button type=\"button\" class=\"exbtn\" data-ex=\"news\"><b data-t=\"ex_news\">Breaking news</b><small data-t=\"ex_news_d\">Full screen with the news background</small></button>\n            <button type=\"button\" class=\"exbtn\" data-ex=\"reminder\"><b data-t=\"ex_reminder\">Reminder</b><small data-t=\"ex_reminder_d\">The standard TV notification, with a chime</small></button>\n            <button type=\"button\" class=\"exbtn\" data-ex=\"bell\"><b data-t=\"ex_bell\">Doorbell</b><small data-t=\"ex_bell_d\">Warning on top of the picture, with a sound</small></button>\n            <button type=\"button\" class=\"exbtn\" data-ex=\"simple\"><b data-t=\"ex_simple\">Simple message</b><small data-t=\"ex_simple_d\">The standard TV notification</small></button>\n          </div>\n          <h3 style=\"margin-top:18px\" data-t=\"clubs_title\">Simulate a goal for a club</h3>\n          <div class=\"msg\" style=\"padding:0 0 4px\" data-t=\"clubs_note\">The toast bar with the crest and the colour of the club, as the Match alerts sends it.</div>\n          <div class=\"exgrid\" id=\"clubgrid\"></div>\n          <div class=\"msg\" id=\"exmsg\" style=\"padding:6px 0 0\"></div>\n        </div>\n        <div>\n          <h3 style=\"margin-top:22px\" data-t=\"t_show\">Try each way to show a message</h3>\n          <div class=\"row\"><button type=\"button\" class=\"ghost\" data-stm=\"banner\" data-t=\"st_tb\">Default Notification</button><button type=\"button\" class=\"ghost\" data-stm=\"full\" data-t=\"st_tc\">Full screen</button><button type=\"button\" class=\"ghost\" data-stm=\"both\" data-t=\"st_tboth\">Both</button><button type=\"button\" class=\"ghost\" data-stm=\"overlay\" data-t=\"m_overlay\">Bar</button><button type=\"button\" class=\"ghost\" data-stm=\"glass\" data-t=\"m_glass\">Glass bar</button><button type=\"button\" class=\"ghost\" data-stm=\"panel\" data-t=\"m_panel\">Panel</button></div>\n          <div class=\"msg\" id=\"stmsg\" style=\"padding:8px 0 0\"></div>\n          <h3 style=\"margin-top:22px\" data-t=\"t_sound\">Sounds</h3>\n          <div class=\"msg\" id=\"tsoundnote\" style=\"padding:0 0 8px\"></div>\n          <div class=\"row\" id=\"tsounds\"></div>\n          <h3 style=\"margin-top:22px\" data-t=\"t_goodie\">Goodie</h3>\n          <div class=\"msg\" style=\"padding:0 0 8px\" data-t=\"t_goodie_note\">About 10 seconds of a well-known tune, played only with the notification sounds (you recognise it by the rhythm).</div>\n          <div class=\"row\"><span id=\"tsongs\" class=\"row\"></span><button type=\"button\" class=\"ghost\" id=\"tsongstop\" data-t=\"t_stop\">Stop</button></div>\n        </div>\n      </div>\n    </div>\n    <div class=\"pane\" id=\"p-set\" hidden>\n      <div class=\"appcols\">\n        <div>\n          <h3 data-t=\"set_notif\">Notification</h3>\n          <span class=\"lab\" id=\"tdef-name\" data-t=\"f_def\">Look when the sender names none</span>\n          <div class=\"modes\" id=\"tdef\" role=\"group\" aria-labelledby=\"tdef-name\"><button type=\"button\" class=\"md\" aria-pressed=\"false\" data-def=\"banner\" data-t=\"m_banner\"></button><button type=\"button\" class=\"md\" aria-pressed=\"false\" data-def=\"full\" data-t=\"m_full\"></button><button type=\"button\" class=\"md\" aria-pressed=\"false\" data-def=\"both\" data-t=\"m_both\"></button><button type=\"button\" class=\"md\" aria-pressed=\"false\" data-def=\"overlay\" data-t=\"m_overlay\"></button><button type=\"button\" class=\"md\" aria-pressed=\"false\" data-def=\"glass\" data-t=\"m_glass\"></button><button type=\"button\" class=\"md\" aria-pressed=\"false\" data-def=\"panel\" data-t=\"m_panel\"></button></div>\n          <div class=\"setting\"><label for=\"tbim\" id=\"tbim-name\" data-t=\"tbim\">Show a banner with a picture as a bar</label><label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"tbim\" aria-labelledby=\"tbim-name\"><span aria-hidden=\"true\"></span></label></div>\n          <div class=\"setting\"><label for=\"tbao\" id=\"tbao-name\" data-t=\"tbao\">Show banners as a toast bar</label><label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"tbao\" aria-labelledby=\"tbao-name\"><span aria-hidden=\"true\"></span></label></div>\n          <span class=\"lab\" id=\"tovpos-name\" data-t=\"f_ovpos\">Where the bar appears</span>\n          <div class=\"modes\" id=\"tovpos\" role=\"group\" aria-labelledby=\"tovpos-name\"><button type=\"button\" class=\"md on\" aria-pressed=\"true\" data-pos=\"bottom\" data-t=\"pos_bottom\">Bottom</button><button type=\"button\" class=\"md\" aria-pressed=\"false\" data-pos=\"top\" data-t=\"pos_top\">Top</button></div>\n          <div class=\"setting\"><label for=\"tovmo\" id=\"tovmo-name\" data-t=\"f_ovmo\">Animate the bar</label><label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"tovmo\" aria-labelledby=\"tovmo-name\" checked><span aria-hidden=\"true\"></span></label></div>\n          <label class=\"lab\" for=\"tovdur\" data-t=\"f_ovdur\">Bar duration when the sender gives none (s)</label>\n          <div class=\"row\"><input type=\"range\" id=\"tovdur\" min=\"1\" max=\"60\" step=\"1\" value=\"8\" style=\"flex:1\"><b id=\"tovdurv\">8 s</b></div>\n          <label class=\"lab\" for=\"tovop\" data-t=\"f_ovop\">Opacity of the bar background (%)</label>\n          <div class=\"row\"><input type=\"range\" id=\"tovop\" min=\"20\" max=\"100\" step=\"2\" value=\"88\" style=\"flex:1\"><b id=\"tovopv\">88%</b></div>\n          <div class=\"row\"><button type=\"button\" id=\"ttest\" data-t=\"b_test\">Test</button></div>\n          <div class=\"msg\" id=\"tnmsg\"></div>\n          <h4 data-t=\"th_title\">Wallpapers</h4>\n          <div class=\"msg\" style=\"padding:0 0 8px\" data-t=\"th_note\">Sport and News come with the Notification Center. Add your own with a name and the address of a picture; then choose it by name when you send, or give it to a sender.</div>\n          <div class=\"row\"><input type=\"text\" id=\"th_name\" maxlength=\"24\" data-p=\"ph_thname\" style=\"flex:1\"><input type=\"text\" id=\"th_url\" maxlength=\"290\" data-p=\"ph_thurl\" style=\"flex:2\"><button type=\"button\" class=\"ghost\" id=\"th_add\" data-t=\"th_add\">Add</button></div>\n          <div class=\"row\" id=\"themelist\" style=\"margin-top:6px\"></div>\n          <div class=\"msg\" id=\"th_msg\" style=\"padding:6px 0 0\"></div>\n          <h3 data-t=\"set_sound\">Sound</h3>\n          <label class=\"lab\" for=\"tone\" data-t=\"f_one\">One sound for everything</label>\n          <select id=\"tone\"></select>\n          <label class=\"lab\" for=\"tmvol\" data-t=\"f_mvol\">Sound volume (%)</label>\n          <div class=\"row\"><input type=\"range\" id=\"tmvol\" min=\"10\" max=\"100\" step=\"5\" value=\"100\" style=\"flex:1\"><b id=\"tmvolv\">100%</b></div>\n          <label class=\"lab\" for=\"tdelay\" style=\"margin-top:12px\" data-t=\"f_delay\">The sound starts this long after the notification is sent (ms)</label>\n          <div class=\"row\"><input type=\"range\" id=\"tdelay\" min=\"0\" max=\"10000\" step=\"100\" value=\"3000\" style=\"flex:1\"><b id=\"tdelayv\">3000 ms</b></div>\n          <details class=\"help\"><summary data-t=\"how\">How to tune it</summary><div class=\"msg\" style=\"padding:4px 0 0\" data-t=\"f_delay_note\">The banner appears a few seconds after the request. Press \"Send a notification with this sound\" below and move this slider until the sound and the banner arrive together.</div></details>\n          <label class=\"lab\" for=\"tvol\" style=\"margin-top:12px\" data-t=\"f_tvol\">Volume for this test only (%)</label>\n          <div class=\"row\"><input type=\"range\" id=\"tvol\" min=\"10\" max=\"100\" step=\"5\" value=\"100\" style=\"flex:1\"><b id=\"tvolv\">100%</b></div>\n          <div class=\"row\" style=\"margin-top:12px\"><button type=\"button\" class=\"send\" id=\"tsend\" data-t=\"t_send_sound\">Send a notification with this sound</button></div>\n          <div class=\"msg\" id=\"tsmsg\" style=\"padding:8px 0 0\"></div>\n          <h4 data-t=\"t_custom\">Your own sounds (WAV, up to 10 s and 1 MB)</h4>\n          <div class=\"msg\" style=\"padding:0 0 8px\" data-t=\"t_custom_note\">Add a sound, such as a goal cheer, and choose it by its name when you send a notification.</div>\n          <div class=\"row\"><input type=\"text\" id=\"cname\" maxlength=\"24\" data-p=\"ph_cname\" style=\"flex:1\"><input type=\"file\" id=\"cfile\" accept=\".wav,audio/wav\" style=\"flex:2\"><button type=\"button\" class=\"ghost\" id=\"cup\" data-t=\"t_upload\">Upload</button></div>\n          <div class=\"row\" id=\"clist\" style=\"margin-top:6px\"></div>\n        </div>\n        <div>\n          <h3 data-t=\"q_title\">Quiet hours</h3>\n          <div class=\"msg\" data-t=\"q_all\">They apply to every Shard. A sender allowed to send urgent ones passes them.</div>\n          <div class=\"row\"><button type=\"button\" class=\"ghost\" id=\"q_senders\" data-t=\"q_senders\">Senders and rules</button></div>\n          <div class=\"setting\"><label for=\"q_on\" id=\"q_on-name\" data-t=\"q_on\">Quiet hours</label><label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"q_on\" aria-labelledby=\"q_on-name\"><span aria-hidden=\"true\"></span></label></div>\n          <div class=\"rulesgrid\">\n            <div><label class=\"lab\" for=\"q_from\" data-t=\"q_from\">From (HH:MM)</label><input type=\"time\" id=\"q_from\"></div>\n            <div><label class=\"lab\" for=\"q_to\" data-t=\"q_to\">To (HH:MM)</label><input type=\"time\" id=\"q_to\"></div>\n          </div>\n          <label class=\"lab\" for=\"q_allow\" data-t=\"q_allow\">Still show</label>\n          <select id=\"q_allow\"><option value=\"alert\">alert</option><option value=\"warn\">warn + alert</option><option value=\"none\">nothing</option></select>\n          <div class=\"row\"><button type=\"button\" class=\"send\" id=\"q_save\" data-t=\"save\">Save</button></div>\n          <div class=\"msg\" id=\"qmsg\"></div>\n          <h3 data-t=\"cp_title\">Copy this setup to another TV</h3>\n          <div class=\"msg\" style=\"padding:0 0 8px\" data-t=\"cp_note\">Get your settings, senders, webhooks and, if you want, your sounds as one text, then load it on another TV that has the Notification Center.</div>\n          <div class=\"setting\"><label for=\"cp_sounds\" id=\"cp_sounds-name\" data-t=\"cp_sounds\">Include my sounds (the file gets bigger)</label><label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"cp_sounds\" aria-labelledby=\"cp_sounds-name\"><span aria-hidden=\"true\"></span></label></div>\n          <div class=\"setting\"><label for=\"cp_keys\" id=\"cp_keys-name\" data-t=\"cp_keys\">Include the keys of the senders (keep the file private)</label><label class=\"switch\"><input type=\"checkbox\" role=\"switch\" id=\"cp_keys\" aria-labelledby=\"cp_keys-name\"><span aria-hidden=\"true\"></span></label></div>\n          <div class=\"row\" style=\"margin-top:10px\"><button type=\"button\" class=\"send\" id=\"cp_save\" data-t=\"cp_save\">Show the setup</button> <button type=\"button\" class=\"ghost\" id=\"cp_copy\" data-t=\"cp_copy\">Copy the text</button></div>\n          <textarea id=\"cp_out\" readonly rows=\"6\" spellcheck=\"false\" style=\"display:none\"></textarea>\n          <div class=\"msg\" id=\"cp_url\" style=\"padding:6px 0 0;word-break:break-all\"></div>\n          <label class=\"lab\" for=\"cp_file\" style=\"margin-top:14px\" data-t=\"cp_load\">Load a setup file</label>\n          <div class=\"row\"><input type=\"file\" id=\"cp_file\" accept=\".json,application/json\" style=\"flex:1\"><button type=\"button\" class=\"ghost\" id=\"cp_up\" data-t=\"cp_up\">Load it</button></div>\n          <textarea id=\"cp_in\" rows=\"3\" spellcheck=\"false\" data-p=\"ph_cpin\" placeholder=\"...or paste the setup text here\"></textarea>\n          <div class=\"msg\" id=\"cp_msg\" style=\"padding:8px 0 0\"></div>\n          <div class=\"row\" style=\"margin-top:12px\"><button type=\"button\" class=\"danger\" id=\"cp_reset\" data-t=\"b_reset\">Reset settings</button></div>\n        </div>\n      </div>\n    </div>\n    <div class=\"pane\" id=\"p-tech\" hidden>\n      <div class=\"appcols\">\n        <div>\n          <h3 data-t=\"ok_title\">Is everything working?</h3>\n          <ul id=\"statuslist\"></ul>\n          <h3 data-t=\"sn_title\">Senders</h3>\n          <ul id=\"seenlist\"></ul>\n          <h3 data-t=\"app\">Companion app</h3>\n          <div class=\"msg\" style=\"padding:0 0 10px\" data-t=\"appnote\">Launches NotifCtr01.NotifCenter (fixed id). It must be installed on the TV, see the README.</div>\n          <h3 data-t=\"curl\">Send from another device</h3>\n          <pre id=\"curl\"></pre>\n      <h3 style=\"margin-top:26px\" data-t=\"rq_title\">Request for other apps and Shards</h3>\n      <div class=\"tabs\" id=\"reqtabs\"></div>\n      <pre id=\"reqcode\"></pre>\n      <div class=\"row\" style=\"margin-top:10px\"><button type=\"button\" class=\"ghost\" id=\"reqcopy\" data-t=\"copy\">Copy</button></div>\n      <h3 style=\"margin-top:26px\" data-t=\"api_title\">API</h3>\n      <div class=\"msg\" id=\"apiver\" style=\"padding:0 0 8px\"></div>\n      <div class=\"table-wrap\"><table class=\"api\"><thead><tr><th data-t=\"th_field\">Field</th><th data-t=\"th_type\">Type</th><th data-t=\"th_default\">Default</th><th data-t=\"th_meaning\">Meaning</th></tr></thead><tbody id=\"apifields\"></tbody></table></div>\n      <ul id=\"apiroutes\"></ul>\n      <h3 style=\"margin-top:26px\" data-t=\"api_try\">Try the API</h3>\n      <div id=\"apiform\" class=\"apiform\"></div>\n      <div class=\"row\" style=\"margin-bottom:10px\"><button type=\"button\" class=\"send\" id=\"apitry\" data-t=\"send_btn\">Send</button></div>\n      <pre id=\"apiout\"></pre>\n        </div>\n        <div>\n          <h3 data-t=\"recent\">Recently sent</h3>\n          <div class=\"row\"><button class=\"ghost\" id=\"refresh\" type=\"button\" data-t=\"refresh\">Refresh</button></div>\n          <div class=\"tabs\" id=\"recfilter\"></div>\n          <ul id=\"recent\"></ul>\n          <div class=\"msg\" id=\"recmsg\"></div>\n        </div>\n      </div>\n    </div>\n  </section>\n</div>\n<div id=\"toast\" role=\"status\" aria-live=\"polite\" hidden></div>\n<div class=\"modal\" id=\"picker\" hidden>\n  <div class=\"dlg\" role=\"dialog\" aria-modal=\"true\">\n    <div class=\"dhead\"><h2 data-t=\"pick_title\">Choose an icon</h2><button type=\"button\" class=\"ghost\" id=\"pclose\" data-t=\"close\">Close</button></div>\n    <input type=\"text\" id=\"esearch\" data-p=\"ph_search\">\n    <div class=\"ecats\" id=\"ecats\"></div>\n    <div class=\"egrid\" id=\"egrid\"></div>\n    <div class=\"msg\" id=\"esrc\" style=\"padding:8px 0 0\"></div>\n  </div>\n</div>\n\n<script>\n(function () {\n  \"use strict\";\n  var $ = function (id) { return document.getElementById(id); };\n  var T = {\n    en: { title: \"Notification Center\", send: \"Send a notification\", secs: \"Show for (s)\", open: \"Show on TV now\", btn: \"Send\", preview: \"Preview\",\n      prevnote: \"The TV shows its own native banner; this is only an approximation.\", recent: \"Recently sent\", refresh: \"Refresh\", app: \"Companion app\",\n      appnote: \"Launches NotifCtr01.NotifCenter (fixed id). It must be installed on the TV, see the README.\", curl: \"Send from another device\",\n      ph_title: \"Title (optional)\", ph_msg: \"Message\", st_title: \"Status\", ph_auto: \"\\u00cdcone autom\\u00e1tico:\", pick_title: \"Escolher um \\u00edcone\", close: \"Fechar\", tab_main: \"Send\", pick_title: \"Choose an icon\", close: \"Close\", ph_auto: \"Automatic icon:\", sec_msg: \"Message\", sec_pics: \"Pictures for the full-screen card\", c_app: \"App\", c_svc: \"Banner service\", c_pair_on: \"Pairing on\", c_pair_off: \"Pairing off\", st_shard: \"Notification Center Shard\", st_app: \"Companion app installed\", st_appfix: \"Install the .wgt with Apps2Samsung or TV-Store\", st_svc: \"Banner service installed\", st_svcfix: \"Reinstall the app (version 0.2 or newer)\", st_pair: \"Vetro pairing\", st_pair_on: \"On: other devices need a key\", st_pair_off: \"Off: any device on the network can send\", st_pair_unknown: \"Could not tell\", st_tb: \"Default Notification\", st_tc: \"Full screen\", st_tboth: \"Both\", st_to: \"Toast bar\", th_title: \"Wallpapers\", th_note: \"Sport and News come with the Notification Center. Add your own with a name and the address of a picture; then choose it by name when you send, or give it to a sender.\", ph_thname: \"Name, e.g. derby\", ph_thurl: \"Picture address (http or https)\", th_add: \"Add\", th_bad: \"A name (a-z, 0-9 and -) and an http or https picture address are needed.\", th_ok: \"Wallpaper added.\", clubs_title: \"Simulate a goal for a club\", clubs_note: \"The toast bar with the crest and the colour of the club, as the Match alerts sends it.\", club_goal: \"Goal!\", ex_scp: \"Sporting goal\", ex_scp_d: \"Toast bar with the Sporting crest, green\", ex_scp_t: \"Goal! Sporting\", ex_scp_m: \"Sporting 1-0 Benfica\", ex_slb: \"Benfica goal\", ex_slb_d: \"Toast bar with the Benfica crest, red\", ex_slb_t: \"Goal! Benfica\", ex_slb_m: \"Sporting 1-1 Benfica\", lab_prio: \"How urgent is it?\", pr_normal: \"Normal\", pr_high: \"High: first in line, shown even in quiet hours\", lab_act: \"A button on the full-screen card that opens an app\", ph_actapp: \"App id (pick from the list or type it)\", ph_actlabel: \"Button text (default: Open)\", set_tab: \"Settings\", s1: \"1 - Write the message\", s2: \"2 - Choose how it looks\", lab_kind: \"What kind of message is it?\", lab_how: \"How should it appear on the TV?\", more: \"More options (sound, pictures, how long)\", lab_sound: \"Sound\", lab_pic: \"Picture (only used where the look has room for one)\", lab_wall: \"Background of the full-screen card\", lab_icon: \"A different icon (an emoji)\", mh_banner: \"The TV's own small notification, over whatever is playing. Plain text only.\", mh_full: \"A big card that takes over the screen for a few seconds. Good for news, with a picture or a background.\", mh_both: \"The big card and the small notification together.\", mh_overlay: \"A bar over the picture, at the bottom or the top (see Settings), without interrupting what you are watching. Good for goals.\", ex_title: \"Try an example\", ex_note: \"One click sends a real notification to your TV, so you can see what it looks like.\", ex_goal: \"Goal alert\", ex_goal_d: \"Toast bar and one beep\", ex_goal_t: \"Goal!\", ex_goal_m: \"Sporting 1-0 Benfica\", ex_news: \"Breaking news\", ex_news_d: \"Full screen with the news background\", ex_news_t: \"Breaking news\", ex_news_m: \"The government approves a new package of measures\", ex_bell: \"Doorbell\", ex_bell_d: \"Warning on top of the picture, with a sound\", ex_bell_t: \"Doorbell\", ex_bell_m: \"Someone is at the front door\", ex_simple: \"Simple message\", ex_simple_d: \"The standard TV notification\", ex_simple_t: \"Hello\", ex_simple_m: \"This is a test notification\", ok_title: \"Is everything working?\", set_sound: \"Sound\", set_toast: \"Toast bar\", t_custom_note: \"Add a sound, such as a goal cheer, and choose it by its name when you send a notification.\", t_sure: \"Sure? Delete\", t_custom: \"Your own sounds (WAV, up to 10 s and 1 MB)\", t_upload: \"Upload\", t_cbad: \"Give the sound a name (a-z, 0-9 and -) and choose a WAV file.\", t_cok: \"Sound uploaded.\", ph_cname: \"Name, e.g. goal\", th_none: \"Default wallpaper: none\", th_sport: \"Sport wallpaper\", th_news: \"News wallpaper\", f_theme: \"Default wallpaper\", f_ovop: \"Opacity of the bar background (%)\", m_overlay: \"Bar\", rq_title: \"Request for other apps and Shards\", copy: \"Copy\", api_title: \"API\", api_try: \"Try the API\", send_btn: \"Send\", sent_ok: \"Sent.\",\n      ph_app: \"App id whose icon is the picture (optional, e.g. 9Ur5IzDKqV.TizenYouTube)\",\n      ph_wall: \"Wallpaper URL, full-screen background (optional)\", ph_image: \"Image URL for the card and the toast bar (optional)\", ph_icon: \"Icon (emoji, optional; default by level)\", pick: \"Choose icon\", noicon: \"Level icon\", ph_search: \"Search icons...\", groups: \"Smileys,People,Animals,Food,Travel,Activities,Objects,Symbols,Flags\", sending: \"Sending...\", queued: \"Sent to the TV\", queuedq: \"Queued (TV not launched)\", none: \"Nothing sent yet.\", notitle: \"Notification\",\n      info: \"Info\", ok: \"Done\", warn: \"Warning\", alert: \"Alert\", sample: \"Your message appears here\", back: \"Returning to the previous app in\",\n      mode: \"Show as\", m_both: \"Both\", m_banner: \"Default notification\", m_full: \"Full screen\", resend: \"Resend\", resent: \"Sent again\" },\n    pt: { title: \"Centro de Notifica\\u00E7\\u00F5es\", send: \"Enviar notifica\\u00E7\\u00E3o\", secs: \"Mostrar durante (s)\", open: \"Mostrar na TV agora\", btn: \"Enviar\", preview: \"Pr\\u00E9-visualiza\\u00E7\\u00E3o\",\n      prevnote: \"A TV mostra o seu pr\\u00F3prio aviso nativo; isto \\u00E9 s\\u00F3 uma aproxima\\u00E7\\u00E3o.\", recent: \"Enviadas recentemente\", refresh: \"Atualizar\", app: \"App companheira\",\n      appnote: \"Lan\\u00E7a NotifCtr01.NotifCenter (id fixo). Tem de estar instalada na TV, ver o README.\", curl: \"Enviar a partir de outro dispositivo\",\n      ph_title: \"T\\u00EDtulo (opcional)\", ph_msg: \"Mensagem\", st_title: \"Estado\", tab_main: \"Enviar\", sec_msg: \"Mensagem\", sec_pics: \"Imagens para o cart\\u00e3o de ecr\\u00e3 inteiro\", c_app: \"App\", c_svc: \"Servi\\u00e7o\", c_pair_on: \"Emparelhamento ligado\", c_pair_off: \"Emparelhamento desligado\", st_shard: \"Shard Notification Center\", st_app: \"App companheira instalada\", st_appfix: \"Instala o .wgt com o Apps2Samsung ou o TV-Store\", st_svc: \"Servi\\u00E7o de banners instalado\", st_svcfix: \"Reinstala a app (vers\\u00E3o 0.2 ou mais recente)\", st_pair: \"Emparelhamento do Vetro\", st_pair_on: \"Ligado: os outros dispositivos precisam de chave\", st_pair_off: \"Desligado: qualquer dispositivo da rede pode enviar\", st_pair_unknown: \"N\\u00E3o consegui saber\", st_tb: \"Notifica\\u00E7\\u00E3o normal\", st_tc: \"Ecr\\u00E3 inteiro\", st_tboth: \"Ambos\", st_to: \"Barra\", th_title: \"Wallpapers\", th_note: \"Sport e News v\\u00EAm com o Centro de Notifica\\u00E7\\u00F5es. Acrescente os seus com um nome e o endere\\u00E7o de uma imagem; depois escolha-os pelo nome ao enviar, ou d\\u00EA-os a um emissor.\", ph_thname: \"Nome, ex.: derby\", ph_thurl: \"Endere\\u00E7o da imagem (http ou https)\", th_add: \"Acrescentar\", th_bad: \"\\u00C9 preciso um nome (a-z, 0-9 e -) e o endere\\u00E7o http ou https de uma imagem.\", th_ok: \"Wallpaper acrescentado.\", clubs_title: \"Simular um golo de um clube\", clubs_note: \"A barra com o escudo e a cor do clube, como o Match alerts o envia.\", club_goal: \"Golo!\", ex_scp: \"Golo do Sporting\", ex_scp_d: \"Barra com o escudo do Sporting, verde\", ex_scp_t: \"Golo! Sporting\", ex_scp_m: \"Sporting 1-0 Benfica\", ex_slb: \"Golo do Benfica\", ex_slb_d: \"Barra com o escudo do Benfica, vermelho\", ex_slb_t: \"Golo! Benfica\", ex_slb_m: \"Sporting 1-1 Benfica\", lab_prio: \"Qu\\u00E3o urgente \\u00E9?\", pr_normal: \"Normal\", pr_high: \"Alta: passa \\u00E0 frente e aparece mesmo no sil\\u00EAncio\", lab_act: \"Um bot\\u00E3o no cart\\u00E3o em ecr\\u00E3 inteiro que abre uma app\", ph_actapp: \"Id da app (escolha da lista ou escreva)\", ph_actlabel: \"Texto do bot\\u00E3o (por omiss\\u00E3o: Abrir)\", set_tab: \"Defini\\u00E7\\u00F5es\", s1: \"1 - Escreva a mensagem\", s2: \"2 - Escolha o aspeto\", lab_kind: \"Que tipo de mensagem \\u00E9?\", lab_how: \"Como deve aparecer na TV?\", more: \"Mais op\\u00E7\\u00F5es (som, imagens, dura\\u00E7\\u00E3o)\", lab_sound: \"Som\", lab_pic: \"Imagem (s\\u00F3 aparece onde o aspeto tem espa\\u00E7o)\", lab_wall: \"Fundo do cart\\u00E3o em ecr\\u00E3 inteiro\", lab_icon: \"Outro \\u00EDcone (um emoji)\", mh_banner: \"A pequena notifica\\u00E7\\u00E3o da pr\\u00F3pria TV, por cima do que estiver a passar. S\\u00F3 texto.\", mh_full: \"Um cart\\u00E3o grande que ocupa o ecr\\u00E3 durante uns segundos. Bom para not\\u00EDcias, com imagem ou fundo.\", mh_both: \"O cart\\u00E3o grande e a pequena notifica\\u00E7\\u00E3o em conjunto.\", mh_overlay: \"Uma barra junto ao fundo do ecr\\u00E3, por cima da imagem, sem interromper o que est\\u00E1 a ver. Bom para golos.\", ex_title: \"Experimente um exemplo\", ex_note: \"Um clique envia uma notifica\\u00E7\\u00E3o a s\\u00E9rio \\u00E0 sua TV, para ver como fica.\", ex_goal: \"Alerta de golo\", ex_goal_d: \"Barra e um beep\", ex_goal_t: \"Golo!\", ex_goal_m: \"Sporting 1-0 Benfica\", ex_news: \"\\u00DAltima hora\", ex_news_d: \"Ecr\\u00E3 inteiro com o fundo de not\\u00EDcias\", ex_news_t: \"\\u00DAltima hora\", ex_news_m: \"O Governo aprova um novo pacote de medidas\", ex_bell: \"Campainha\", ex_bell_d: \"Aviso por cima da imagem, com som\", ex_bell_t: \"Campainha\", ex_bell_m: \"Est\\u00E1 algu\\u00E9m \\u00E0 porta\", ex_simple: \"Mensagem simples\", ex_simple_d: \"A notifica\\u00E7\\u00E3o normal da TV\", ex_simple_t: \"Ol\\u00E1\", ex_simple_m: \"Isto \\u00E9 uma notifica\\u00E7\\u00E3o de teste\", ok_title: \"Est\\u00E1 tudo a funcionar?\", set_sound: \"Som\", set_toast: \"Barra\", t_custom_note: \"Acrescente um som, por exemplo uma festa de golo, e escolha-o pelo nome ao enviar.\", t_sure: \"Certeza? Apagar\", t_custom: \"Os seus sons (WAV, at\\u00E9 10 s e 1 MB)\", t_upload: \"Carregar\", t_cbad: \"D\\u00EA um nome ao som (a-z, 0-9 e -) e escolha um ficheiro WAV.\", t_cok: \"Som carregado.\", ph_cname: \"Nome, ex.: golo\", th_none: \"Wallpaper por defeito: nenhum\", th_sport: \"Wallpaper de desporto\", th_news: \"Wallpaper de not\\u00EDcias\", f_theme: \"Wallpaper por defeito\", f_ovop: \"Opacidade do fundo da barra (%)\", m_overlay: \"Barra\", rq_title: \"Pedido para outras apps e Shards\", copy: \"Copiar\", api_title: \"API\", api_try: \"Experimentar a API\", send_btn: \"Enviar\", sent_ok: \"Enviado.\",\n      ph_app: \"Id da app cujo \\u00EDcone \\u00E9 a imagem (opcional, ex.: 9Ur5IzDKqV.TizenYouTube)\",\n      ph_wall: \"URL do wallpaper de fundo em ecr\\u00E3 inteiro (opcional)\", ph_image: \"URL da imagem para o cart\\u00E3o e a barra (opcional)\", ph_icon: \"\\u00CDcone (emoji, opcional; por defeito pelo n\\u00EDvel)\", pick: \"Escolher \\u00EDcone\", noicon: \"\\u00CDcone do n\\u00EDvel\", ph_search: \"Pesquisar \\u00EDcones...\", groups: \"Smileys,Pessoas,Animais,Comida,Viagens,Atividades,Objetos,S\\u00EDmbolos,Bandeiras\", sending: \"A enviar...\", queued: \"Enviada para a TV\", queuedq: \"Em fila (TV n\\u00E3o lan\\u00E7ada)\", none: \"Ainda nada enviado.\", notitle: \"Notifica\\u00E7\\u00E3o\",\n      info: \"Info\", ok: \"Conclu\\u00EDdo\", warn: \"Aviso\", alert: \"Alerta\", sample: \"A sua mensagem aparece aqui\", back: \"A voltar \\u00E0 aplica\\u00E7\\u00E3o anterior em\",\n      mode: \"Mostrar como\", m_both: \"Ambos\", m_banner: \"Notifica\\u00E7\\u00E3o normal\", m_full: \"Ecr\\u00E3 inteiro\", resend: \"Reenviar\", resent: \"Enviada de novo\" }\n  };\n  var LEVELS = [\"info\", \"ok\", \"warn\", \"alert\"];\n  // One UI style line icons (24x24, round caps): info, done, warning, alert.\n  var ICON_BODY = {\n    info: '<circle cx=\"12\" cy=\"12\" r=\"9.5\"/><path d=\"M12 11v6\"/><circle cx=\"12\" cy=\"7.6\" r=\"0.6\" fill=\"#fff\"/>',\n    ok: '<circle cx=\"12\" cy=\"12\" r=\"9.5\"/><path d=\"M7.6 12.6l3 3 5.8-6.4\"/>',\n    warn: '<path d=\"M12 3.8L21.2 20H2.8z\"/><path d=\"M12 10v4.6\"/><circle cx=\"12\" cy=\"17.4\" r=\"0.6\" fill=\"#fff\"/>',\n    alert: '<circle cx=\"12\" cy=\"12\" r=\"9.5\"/><path d=\"M12 7v6\"/><circle cx=\"12\" cy=\"16.6\" r=\"0.6\" fill=\"#fff\"/>'\n  };\n  function iconSvg(level, size) {\n    return '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"' + size + '\" height=\"' + size + '\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\">' + (ICON_BODY[level] || ICON_BODY.info) + '</svg>';\n  }\n  var LEVEL_EMOJI = { info: \"\\u2139\\uFE0F\", ok: \"\\u2705\", warn: \"\\u26A0\\uFE0F\", alert: \"\\uD83D\\uDD34\" };\n  var COLORS = { info: \"#2f7bff\", ok: \"#2fc28b\", warn: \"#f5a524\", alert: \"#f0506e\" };\n  var lang = \"en\", level = \"info\", mode = \"banner\", lastRecent = [];\n  function tr(k) { return T[lang][k] || T.en[k] || k; }\n  function esc(s) { return String(s == null ? \"\" : s).replace(/[&<>\"']/g, function (c) { return { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c]; }); }\n  function say(text, cls) { $(\"result\").textContent = text || \"\"; $(\"result\").className = \"msg \" + (cls || \"\"); }\n  function api(path, body) {\n    var opt = body ? { method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify(body) } : {};\n    return fetch(path, opt).then(function (r) { return r.json().then(function (j) { if (!r.ok) { throw new Error(j.error || \"error \" + r.status); } return j; }); });\n  }\n  function icon(l) { return iconSvg(l, 24); }\n  function paintLevels() {\n    var shown = [\"info\", \"warn\", \"alert\"];\n    $(\"levels\").innerHTML = shown.map(function (l) {\n      return '<button type=\"button\" class=\"lv' + (l === level ? \" on\" : \"\") + '\" aria-pressed=\"' + (l === level) + '\" data-l=\"' + l + '\" style=\"--c:' + COLORS[l] + '\"><i style=\"background:' + COLORS[l] + '\">' + iconSvg(l, 22) + \"</i>\" + esc(tr(l)) + \"</button>\";\n    }).join(\"\");\n    var b = $(\"levels\").getElementsByTagName(\"button\"), i;\n    for (i = 0; i < b.length; i++) {\n      b[i].addEventListener(\"click\", function () {\n        level = this.getAttribute(\"data-l\"); paintLevels(); preview();\n      });\n    }\n  }\n  function paintModes() {\n    var MODES = [\"banner\", \"full\", \"both\", \"overlay\", \"glass\", \"panel\"];\n    $(\"modehint\").textContent = tr(\"mh_\" + mode);\n    $(\"modes\").innerHTML = MODES.map(function (m) {\n      return '<button type=\"button\" class=\"md' + (m === mode ? \" on\" : \"\") + '\" aria-pressed=\"' + (m === mode) + '\" data-m=\"' + m + '\">' + esc(tr(\"m_\" + m)) + \"</button>\";\n    }).join(\"\");\n    var b = $(\"modes\").getElementsByTagName(\"button\"), i;\n    for (i = 0; i < b.length; i++) { b[i].addEventListener(\"click\", function () { mode = this.getAttribute(\"data-m\"); paintModes(); preview(); }); }\n  }\n  function cut(t, n) { t = String(t || \"\"); return t.length > n ? t.slice(0, n - 1) + \"\\u2026\" : t; }\n  function iconAt(l, x, y, size) {\n    return '<svg x=\"' + x + '\" y=\"' + y + '\" width=\"' + size + '\" height=\"' + size + '\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\">' + (ICON_BODY[l] || ICON_BODY.info) + \"</svg>\";\n  }\n  function glyph(cx, cy, size) {\n    var e = $(\"icon\").value;\n    if (e) { return '<text x=\"' + cx + '\" y=\"' + (cy + Math.round(size * 0.35)) + '\" text-anchor=\"middle\" font-size=\"' + size + '\">' + esc(e) + \"</text>\"; }\n    return iconAt(level, cx - size / 2, cy - size / 2, size);\n  }\n  // Preview drawn like the Vetro UI overview: the same sunset scene as the TV, with the notification on top.\n  var overlayOp = 88, overlayPos = \"bottom\";\n  function preview() {\n    var c = COLORS[level], ttl = $(\"title\").value || tr(\"notitle\"), msg = $(\"message\").value || tr(\"sample\");\n    var dur = parseInt($(\"secs\").value, 10) || 8, h = \"\";\n    var wall = urlOk($(\"wallpaper\").value), pic = urlOk($(\"image\").value);\n    var bhead = $(\"icon\").value || LEVEL_EMOJI[level];\n    $(\"icon\").placeholder = tr(\"ph_auto\") + \" \" + LEVEL_EMOJI[level];   // the icon follows the level by itself; type or pick one only to override\n    if (mode === \"full\" || mode === \"both\") {\n      h += '<g class=\"sc-card\">' + (wall ? '<image x=\"0\" y=\"0\" width=\"1920\" height=\"1080\" preserveAspectRatio=\"xMidYMid slice\" href=\"' + esc(/^https?:\\/\\/[^\\s\"'<>]+$/.test(wall) ? wall : \"\") + '\"/>' : \"\") +\n        '<rect width=\"1920\" height=\"1080\" fill=\"#07090f\" fill-opacity=\"' + (wall ? \".6\" : \".55\") + '\"/>' +\n        '<rect x=\"360\" y=\"330\" width=\"1200\" height=\"310\" rx=\"64\" fill=\"#fff\" fill-opacity=\".1\"/><rect x=\"360\" y=\"330\" width=\"18\" height=\"310\" rx=\"9\" fill=\"' + c + '\"/>' +\n        '<circle cx=\"520\" cy=\"485\" r=\"74\" fill=\"' + c + '\"/>' + glyph(520, 485, 88) +\n        '<text x=\"640\" y=\"470\" font-size=\"54\" font-weight=\"600\" fill=\"#fff\">' + esc(cut(ttl, 30)) + '</text>' +\n        '<text x=\"640\" y=\"540\" font-size=\"38\" fill=\"#c4cde0\">' + esc(cut(msg, pic ? 30 : 52)) + \"</text>\" +\n        (pic ? '<image x=\"1120\" y=\"350\" width=\"400\" height=\"270\" preserveAspectRatio=\"xMidYMid meet\" href=\"' + esc(/^https?:\\/\\/[^\\s\"'<>]+$/.test(pic) ? pic : \"\") + '\"/>' : \"\") +\n        '<text x=\"960\" y=\"745\" text-anchor=\"middle\" font-size=\"36\" fill=\"#8b96ab\">' + esc(tr(\"back\")) + '</text>' +\n        '<text x=\"960\" y=\"900\" text-anchor=\"middle\" font-size=\"160\" font-weight=\"700\" fill=\"#fff\">' + dur + \"</text></g>\";\n    }\n    if (mode === \"banner\" || mode === \"both\") {\n      h += '<g class=\"sc-banner\"><rect x=\"1236\" y=\"60\" width=\"628\" height=\"196\" rx=\"44\" fill=\"#fff\" fill-opacity=\".22\"/><rect x=\"1238\" y=\"62\" width=\"624\" height=\"192\" rx=\"42\" fill=\"#243448\" fill-opacity=\".94\"/>' +\n        '<rect x=\"1268\" y=\"96\" width=\"88\" height=\"88\" rx=\"24\" fill=\"#4a6cf7\"/><text x=\"1312\" y=\"154\" text-anchor=\"middle\" font-size=\"52\">\\uD83D\\uDD14</text>' +\n        '<text x=\"1380\" y=\"132\" font-size=\"32\" font-weight=\"600\" fill=\"#fff\">' + esc(cut(bhead + \" \" + ttl, 24)) + \"</text>\" +\n        '<text x=\"1380\" y=\"172\" font-size=\"26\" fill=\"#fff\" fill-opacity=\".75\">' + esc(cut(msg, 30)) + \"</text>\" +\n        '<text x=\"1380\" y=\"226\" font-size=\"24\" font-weight=\"600\" fill=\"#8fbaff\">OK</text><text x=\"1470\" y=\"226\" font-size=\"24\" fill=\"#8fbaff\">View history</text></g>';\n    }\n    if (mode === \"overlay\" || mode === \"glass\") {\n      var oh = 56 + (ttl ? 58 : 0) + (msg ? 58 : 0), ot = overlayPos === \"top\" ? 90 : 1080 - 90 - oh;\n      h += '<g class=\"sc-banner\"><linearGradient id=\"ovglass\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#283652\"/><stop offset=\"1\" stop-color=\"#0c121e\"/></linearGradient><rect x=\"160\" y=\"' + ot + '\" width=\"1600\" height=\"' + oh + '\" rx=\"36\" fill=\"' + (mode === \"glass\" ? \"url(#ovglass)\" : \"#0a0c12\") + '\" fill-opacity=\"' + (overlayOp / 100) + '\" stroke=\"#fff\" stroke-opacity=\"' + (mode === \"glass\" ? 0.3 : 0) + '\" stroke-width=\"2\"/>' +\n        '<rect x=\"182\" y=\"' + (ot + 20) + '\" width=\"12\" height=\"' + (oh - 40) + '\" rx=\"6\" fill=\"' + c + '\"/>' +\n        '<text x=\"218\" y=\"' + (ot + 74) + '\" font-size=\"46\" fill=\"#fff\">' + esc(cut(ttl, 40)) + \"</text>\" +\n        '<text x=\"218\" y=\"' + (ot + 130) + '\" font-size=\"38\" fill=\"#d6deee\">' + esc(cut(msg, 66)) + \"</text></g>\";\n    }\n    if (mode === \"panel\") {\n      h += '<g class=\"sc-banner\"><rect x=\"80\" y=\"70\" width=\"1760\" height=\"940\" rx=\"36\" fill=\"#0a0c12\" fill-opacity=\".95\"/><rect x=\"102\" y=\"90\" width=\"12\" height=\"900\" rx=\"6\" fill=\"' + c + '\"/>' +\n        '<text x=\"960\" y=\"520\" text-anchor=\"middle\" font-size=\"80\" fill=\"#fff\">' + esc(cut(ttl, 40)) + \"</text>\" +\n        '<text x=\"960\" y=\"610\" text-anchor=\"middle\" font-size=\"52\" fill=\"#d6deee\">' + esc(cut(msg, 60)) + \"</text></g>\";\n    }\n    $(\"dyn\").innerHTML = h;\n    paintReq();\n  }\n\n  // Visible feedback on action buttons: spinner while it runs (at least 0.45 s), then green (done) or red (failed) for a moment.\n  function act(btn, p) {\n    var t0 = Date.now();\n    btn.classList.add(\"busy\");\n    function end(cls) {\n      setTimeout(function () {\n        btn.classList.remove(\"busy\"); btn.classList.add(cls);\n        setTimeout(function () { btn.classList.remove(cls); }, 1300);\n      }, Math.max(0, 450 - (Date.now() - t0)));\n    }\n    p.then(function () { end(\"done\"); }, function () { end(\"fail\"); });\n  }\n  var recFilter = \"all\", failed = 0;\n  var BAD = { failed: 1, rejected: 1, dropped: 1 }, WARN = { merged: 1, suppressed: 1, replaced: 1, expired: 1 };\n  function statChip(st) { st = st || \"queued\"; return '<span class=\"chip ' + (st === \"shown\" ? \"g\" : BAD[st] ? \"r\" : WARN[st] ? \"y\" : \"plain\") + '\">' + esc(tr(\"o_\" + st)) + \"</span>\"; }\n  function outcome(r) { return tr(\"o_\" + (r.status || \"queued\")) + (r.reason ? \": \" + r.reason : \"\"); }\n  // Something did not arrive: a chip in the top bar opens the log on those.\n  function failChip() {\n    var old = $(\"failchip\");\n    if (old) { old.parentNode.removeChild(old); }\n    if (!failed) { return; }\n    $(\"chips\").insertAdjacentHTML(\"afterbegin\", '<button type=\"button\" class=\"chip r\" id=\"failchip\">' + esc(failed + \" \" + tr(\"n_failed\")) + \"</button>\");\n    $(\"failchip\").addEventListener(\"click\", function () { recFilter = \"failed\"; document.querySelector('[data-pane=\"p-tech\"]').click(); recent().catch(function () {}); });\n  }\n  function recent() {\n    return api(\"recent\").then(function (d) {\n      var all = d.recent, keys = [\"all\", \"failed\"], list;\n      all.forEach(function (n) { if (n.source && keys.indexOf(n.source) < 0) { keys.push(n.source); } });\n      if (keys.indexOf(recFilter) < 0) { recFilter = \"all\"; }\n      failed = all.filter(function (n) { return BAD[n.status] === 1; }).length;\n      failChip();\n      list = all.filter(function (n) { return recFilter === \"all\" || (recFilter === \"failed\" ? BAD[n.status] === 1 : n.source === recFilter); });\n      lastRecent = list;\n      $(\"recfilter\").innerHTML = keys.map(function (k) { return '<button type=\"button\" class=\"tab' + (k === recFilter ? \" on\" : \"\") + '\" aria-pressed=\"' + (k === recFilter) + '\" data-f=\"' + esc(k) + '\">' + esc(k === \"all\" || k === \"failed\" ? tr(\"f_\" + k) : k) + \"</button>\"; }).join(\"\");\n      Array.prototype.forEach.call($(\"recfilter\").children, function (b) { b.addEventListener(\"click\", function () { recFilter = this.getAttribute(\"data-f\"); recent().catch(function () {}); }); });\n      $(\"recent\").innerHTML = list.length ? list.map(function (n, i) {\n        return '<li style=\"--c:' + (COLORS[n.level] || COLORS.info) + '\"><span class=\"dot\"></span><div><b>' + esc(n.title || tr(\"notitle\")) + \"</b> \" + esc(n.message) +\n          \"<small>\" + esc([n.source, n.category, new Date(n.at).toLocaleTimeString(), n.reason].filter(Boolean).join(\" \\u00B7 \")) + \"</small>\" + statChip(n.status) + \"</div>\" +\n          '<button type=\"button\" class=\"ghost rs\" data-i=\"' + i + '\">' + esc(tr(\"resend\")) + \"</button></li>\";\n      }).join(\"\") : '<li class=\"empty\">' + esc(tr(\"none\")) + \"</li>\";\n      var rb = $(\"recent\").getElementsByClassName(\"rs\"), k;\n      for (k = 0; k < rb.length; k++) {\n        rb[k].addEventListener(\"click\", function () {\n          var n = lastRecent[parseInt(this.getAttribute(\"data-i\"), 10)];\n          if (!n) { return; }\n          act(this, api(\"notify\", { title: n.title, message: n.message, level: n.level, icon: n.icon, image: n.image, image2: n.image2, wallpaper: n.wallpaper, mode: n.mode, sound: n.sound, volume: n.volume || undefined, source: n.source, category: n.category, group: false, duration: parseInt($(\"secs\").value, 10) || 8, open: $(\"open\").checked })\n            .then(function (r) { $(\"recmsg\").textContent = outcome(r); $(\"recmsg\").className = \"msg ok\"; recent(); })\n            .catch(function (e) { $(\"recmsg\").textContent = e.message; $(\"recmsg\").className = \"msg err\"; recent(); throw e; }));\n        });\n      }\n    }).catch(function (e) { say(e.message, \"err\"); throw e; });\n  }\n  T.en.lead = \"Send messages to this TV and choose how they look.\"; T.pt.lead = \"Envie mensagens para esta TV e escolha como aparecem.\";\n  T.en.how = \"How to tune it\"; T.pt.how = \"Como afinar\";\n  T.en.st_ok = \"Done\"; T.pt.st_ok = \"Pronto\"; T.en.st_no = \"Missing\"; T.pt.st_no = \"Em falta\"; T.en.st_check = \"Check\"; T.pt.st_check = \"Verificar\";\n  T.en.cancel = \"Cancel\"; T.pt.cancel = \"Cancelar\"; T.en.q_del = \"Delete {n}? This cannot be undone.\"; T.pt.q_del = \"Apagar {n}? N\\u00E3o se pode anular.\";\n  T.en.no_src = \"No senders yet.\"; T.pt.no_src = \"Ainda n\\u00E3o h\\u00E1 emissores.\"; T.en.no_hook = \"No webhooks yet.\"; T.pt.no_hook = \"Ainda n\\u00E3o h\\u00E1 webhooks.\";\n  // One card per group, headed by a purpose icon, as on the Vetro dashboard.\n  (function () {\n    var P = {\n      tv: '<rect x=\"3\" y=\"5\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M8 21h8M12 17v4\"/>',\n      sound: '<rect x=\"9\" y=\"2\" width=\"6\" height=\"12\" rx=\"3\"/><path d=\"M5 10v1a7 7 0 0 0 14 0v-1M12 18v4M8 22h8\"/>',\n      shield: '<path d=\"M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Z\"/><path d=\"m9 12 2 2 4-4\"/>',\n      clock: '<path d=\"M3.5 12a8.5 8.5 0 1 0 2.6-6.1L3.5 8.5M3.5 3.8v4.7h4.7M12 7.5V12l3 2\"/>',\n      flask: '<path d=\"M9 3h6M10 3v6l-5.2 9.1A2 2 0 0 0 6.5 21h11a2 2 0 0 0 1.7-2.9L14 9V3\"/><path d=\"M7.4 15h9.2\"/>',\n      code: '<rect x=\"6\" y=\"6\" width=\"12\" height=\"12\" rx=\"2\"/><path d=\"M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4\"/>'\n    };\n    var ICON = { ed_title: \"shield\", sn_title: \"shield\",set_notif: \"tv\", r_title: \"shield\", recent: \"clock\", ex_title: \"flask\", clubs_title: \"tv\", t_show: \"tv\", t_sound: \"sound\", t_goodie: \"sound\", ok_title: \"shield\", set_sound: \"sound\", t_custom: \"sound\", cp_title: \"clock\", set_toast: \"tv\", q_title: \"clock\", th_title: \"tv\", src_title: \"shield\", h_title: \"code\", app: \"tv\", curl: \"code\", rq_title: \"code\", api_title: \"code\", api_try: \"flask\" };\n    var boxes = document.querySelectorAll(\"#devwrap .appcols > div, #p-tech\"), i, j, box, kids, card, el, h, key, span;\n    for (i = 0; i < boxes.length; i++) {\n      box = boxes[i]; kids = Array.prototype.slice.call(box.children); card = null;\n      for (j = 0; j < kids.length; j++) {\n        el = kids[j];\n        if (el.tagName === \"H3\") {\n          card = document.createElement(\"section\"); card.className = \"panel\"; box.insertBefore(card, el);\n          el.removeAttribute(\"style\");\n        }\n        if (card) { card.appendChild(el); }\n      }\n    }\n    h = document.querySelectorAll(\".panel > h3\");\n    for (i = 0; i < h.length; i++) {\n      key = h[i].getAttribute(\"data-t\");\n      if (!ICON[key]) { continue; }\n      // the words move into a span, so that a change of language keeps the icon\n      span = document.createElement(\"span\"); span.setAttribute(\"data-t\", key); span.textContent = h[i].textContent;\n      h[i].removeAttribute(\"data-t\");\n      h[i].innerHTML = '<svg class=\"section-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">' + P[ICON[key]] + \"</svg>\";\n      h[i].appendChild(span);\n    }\n  })();\n  // A success shows as a toast; an error stays where the content is.\n  (function () {\n    var timer = null, list = document.querySelectorAll(\".msg\"), i, watch;\n    if (!window.MutationObserver) { return; }\n    watch = new MutationObserver(function (changes) {\n      var el = changes[changes.length - 1].target;\n      if (el.nodeType !== 1) { el = el.parentNode; }\n      if (!el || !/(^| )ok( |$)/.test(el.className) || !el.textContent) { return; }\n      $(\"toast\").textContent = el.textContent; $(\"toast\").hidden = false;\n      clearTimeout(timer); timer = setTimeout(function () { $(\"toast\").hidden = true; }, 4000);\n    });\n    for (i = 0; i < list.length; i++) { watch.observe(list[i], { childList: true, characterData: true, subtree: true, attributes: true, attributeFilter: [\"class\"] }); }\n  })();\n  // Vetro's inline confirmation: the question next to the control, then the action or Cancel.\n  function confirmHere(btn, name, run, question, action) {\n    var old = document.querySelector(\".inline-confirm\"), box = document.createElement(\"div\"), p = document.createElement(\"p\"),\n      row = document.createElement(\"div\"), yes = document.createElement(\"button\"), no = document.createElement(\"button\"), host = btn.parentNode;\n    if (old) { old.parentNode.removeChild(old); }\n    box.className = \"inline-confirm\"; box.setAttribute(\"role\", \"group\"); p.textContent = question || tr(\"q_del\").replace(\"{n}\", name); p.id = \"confirm-q\"; box.setAttribute(\"aria-labelledby\", p.id);\n    row.className = \"row\"; yes.type = \"button\"; yes.className = \"warnbtn\"; yes.textContent = action || tr(\"del\"); no.type = \"button\"; no.textContent = tr(\"cancel\");\n    function close() { if (box.parentNode) { box.parentNode.removeChild(box); } }\n    yes.addEventListener(\"click\", function () { close(); btn.focus(); run(); });\n    no.addEventListener(\"click\", function () { close(); btn.focus(); });\n    box.addEventListener(\"keydown\", function (e) { if (e.key === \"Escape\") { close(); btn.focus(); } });\n    row.appendChild(yes); row.appendChild(no); box.appendChild(p); box.appendChild(row);\n    host.parentNode.insertBefore(box, host.nextSibling);\n    no.focus();\n  }\n  T.en.f_title = \"Title (optional)\"; T.pt.f_title = \"T\\u00EDtulo (opcional)\"; T.en.f_msg = \"Message\"; T.pt.f_msg = \"Mensagem\";\n  T.en.ph_title = \"e.g. Oven\"; T.pt.ph_title = \"ex.: Forno\"; T.en.ph_msg = \"e.g. Dinner is ready\"; T.pt.ph_msg = \"ex.: O jantar est\\u00E1 pronto\";\n  T.en.s1 = \"Write the message\"; T.pt.s1 = \"Escreva a mensagem\"; T.en.s2 = \"Choose how it looks\"; T.pt.s2 = \"Escolha o aspeto\";\n  T.en.need_msg = \"Write a message first.\"; T.pt.need_msg = \"Escreva primeiro uma mensagem.\";\n  T.en.no_tv = \"No answer from the TV\"; T.pt.no_tv = \"A TV n\\u00E3o responde\"; T.en.retry = \"Try again\"; T.pt.retry = \"Tentar de novo\";\n  T.en.f_tvol = \"Volume for this test only (%)\"; T.pt.f_tvol = \"Volume s\\u00F3 para este teste (%)\";\n  function applyLang() {\n    document.documentElement.lang = lang;\n    var els = document.querySelectorAll(\"[data-t]\"), i;\n    for (i = 0; i < els.leng