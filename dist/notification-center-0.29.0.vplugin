hidden = id === \"p-main\";\n      });\n      // Left and Right move between the tabs, as in a tab list.\n      tb[i].addEventListener(\"keydown\", function (e) {\n        var step = e.key === \"ArrowRight\" ? 1 : e.key === \"ArrowLeft\" ? -1 : 0, n;\n        if (!step) { return; }\n        e.preventDefault();\n        n = tb[(Array.prototype.indexOf.call(tb, this) + step + tb.length) % tb.length];\n        n.focus(); n.click();\n      });\n    }\n  })();\n\n  // Sources and rules: sources (profiles with keys), quiet hours, grouping and webhooks. Every control calls the documented API (API.md).\n  (function () {\n    var X = {\n      en: { rules_tab: \"Senders and rules\", src_title: \"Sources\", src_note: \"One entry per sender. Its defaults fill in what a request leaves out; a key makes it require the header X-NC-Key.\",\n        f_name: \"Name\", f_icon: \"Icon\", f_level: \"Level\", f_mode: \"Show as\", f_dur: \"Duration (s)\", f_rate: \"Max per minute (0 = no limit)\", f_enabled: \"Enabled\", save: \"Save\", gen_key: \"New key\", clear_key: \"Remove key\", del: \"Delete\",\n        q_title: \"Quiet hours and repeats\", q_on: \"Quiet hours\", q_from: \"From (HH:MM)\", q_to: \"To (HH:MM)\", q_allow: \"Still show\", g_secs: \"Count repeats inside (s, 0 = off)\", g_strict: \"Refuse senders that have no source entry\",\n        h_title: \"Webhooks\", h_note: \"Turn any JSON a service already sends into a notification. Use {{path.to.value}} from the JSON in the texts.\", h_ttl: \"Title template\", h_msg: \"Message template (required)\", h_src: \"Source (default: the name)\",\n        off: \"off\", haskey: \"key\", saved: \"Saved\", deleted: \"Deleted\", keynote: \"Copy this key now, it is shown only once. Senders send it in the header X-NC-Key:\", hookurl: \"Send any JSON to:\", needname: \"Type a name first\" },\n      pt: { rules_tab: \"Emissores e regras\", src_title: \"Origens\", src_note: \"Uma entrada por emissor. Os valores por defeito preenchem o que o pedido