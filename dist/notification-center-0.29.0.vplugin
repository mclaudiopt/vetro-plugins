unction () {\n      act(this, api(\"profiles\", { source: srcName(), key: \"\" }).then(function () { $(\"srckey\").hidden = true; note(\"srcmsg\", tr(\"saved\"), \"ok\"); return loadSources(); }, fail(\"srcmsg\")));\n    });\n    $(\"s_del\").addEventListener(\"click\", function () {\n      var btn = this, n = srcName();\n      if (!n) { note(\"srcmsg\", tr(\"needname\"), \"err\"); return; }\n      confirmHere(btn, n, function () { act(btn, api(\"profiles\", { source: n, delete: true }).then(function () { note(\"srcmsg\", tr(\"deleted\"), \"ok\"); $(\"s_name\").value = \"\"; return loadSources(); }, fail(\"srcmsg\"))); });\n    });\n\n    function quietState() { [\"q_from\", \"q_to\", \"q_allow\"].forEach(function (id) { $(id).disabled = !$(\"q_on\").checked; }); }\n    $(\"q_on\").addEventListener(\"change\", quietState);\n    function loadSettings() {\n      return api(\"settings\").then(function (d) {\n        var s = d.settings;\n        $(\"q_on\").checked = s.quiet.enabled; $(\"q_from\").value = s.quiet.from; $(\"q_to\").value = s.quiet.to; $(\"q_allow\").value = s.quiet.allow;\n        $(\"g_secs\").value = s.groupSeconds; $(\"g_strict\").checked = s.strict; quietState();\n      }).catch(function (e) { note(\"qmsg\", e.message, \"err\"); });\n    }\n    $(\"q_save\").addEventListener(\"click\", function () {\n      act(this, api(\"settings\", { quiet: { enabled: $(\"q_on\").checked, from: $(\"q_from\").value, to: $(\"q_to\").value, allow: $(\"q_allow\").value } })\n        .then(function (r) { note(\"qmsg\", tr(\"saved\"), \"ok\"); $(\"q_from\").value = r.settings.quiet.from; $(\"q_to\").value = r.settings.quiet.to; }, fail(\"qmsg\")));\n    });\n\n    $(\"r_save\").addEventListener(\"click\", function () {\n      act(this, api(\"settings\", { groupSeconds: num(\"g_secs\"), strict: $(\"g_strict\").checked }).then(function () { note(\"rmsg\", tr(\"saved\"), \"ok\"); }, fail(\"rmsg\")));\n    });\n    $(\"cp_reset\").addEventListener(\"click\", function () {\n      var btn = this;\n      confirmHere(btn, \"\", function () {\n        act(btn, api(\"settings\", { quiet: { enabled: false, from: \"22:00\", to: \"07:00\", allow: \"alert\" }, groupSeconds: 60, strict: false, soundVolume: 100, overlayOpacity: 88, defaultMode: \"banner\", bannerImageAsBar: false, overlayPosition: \"bottom\", overlayMotion: true, overlayDuration: 8, oneSound: \"\", bannerAsOverlay: false, soundDelayMs: 3000 })\n          .then(function () { note(\"cp_msg\", tr(\"reset_done\"), \"ok\"); setTimeout(function () { location.reload(); }, 1500); }, fail(\"cp_msg\")));\n      }, tr(\"q_reset\"), tr(\"b_reset\"));\n    });\n\n    function loadHooks() {\n      return api(\"hooks\").then(function (d) {\n        HOOKS = d.hooks;\n        var names = Object.keys(HOOKS);\n        $(\"hooklist\").innerHTML = names.length ? names.map(function (n) {\n          return '<li><button type=\"button\" class=\"rl\" aria-pressed=\"false\" data-n=\"' + esc(n) + '\"><b>' + esc(n) + \"</b><small>\" + esc(HOOKS[n].message) + \"</small></button></li>\";\n        }).join(\"\") : '<li class=\"empty\">' + esc(tr(\"no_hook\")) + \"</li>\";\n        var li = $(\"hooklist\").getElementsByClassName(\"rl\"), i;\n        for (i = 0; i < li.length; i++) {\n          li[i].addEventListener(\"click\", function () {\n            var n = this.getAttribute(\"data-n\"), h = HOOKS[n];\n            pick(this);\n            $(\"h_name\").value = n; $(\"h_icon\").value = h.icon; $(\"h_ttl\").value = h.title; $(\"h_msg\").value = h.message; $(\"h_level\").value = h.level; $(\"h_src\").value = h.source; $(\"h_sound\").value = h.sound || \"\";\n            $(\"hurl\").hidden = false; $(\"hurl\").textContent = tr(\"hookurl\") + \"\\n\" + BASE + \"hook/\" + n;\n          });\n        }\n      }).catch(function (e) { note(\"hmsg\", e.message, \"err\"); });\n    }\n    function hookName() { return $(\"h_name\").value.trim().toLowerCase(); }\n    $(\"h_save\").addEventListener(\"click\", function () {\n      act(this, api(\"hooks\", { name: hookName(), icon: $(\"h_icon\").value, title: $(\"h_ttl\").value, message: $(\"h_msg\").value, level: $(\"h_level\").value, source: $(\"h_src\").value, sound: $(\"h_sound\").value })\n        .then(function (r) { note(\"hmsg\", tr(\"saved\"), \"ok\"); $(\"hurl\").hidden = false; $(\"hurl\").textContent = tr(\"hookurl\") + \"\\n\" + BASE + r.url; return loadHooks(); }, fail(\"hmsg\")));\n    });\n    $(\"h_del\").addEventListener(\"click\", function () {\n      var btn = this, n = hookName();\n      if (!n) { note(\"hmsg\", tr(\"needname\"), \"err\"); return; }\n      confirmHere(btn, n, function () { act(btn, api(\"hooks\", { name: n, delete: true }).then(function () { note(\"hmsg\", tr(\"deleted\"), \"ok\"); $(\"hurl\").hidden = true; $(\"h_name\").value = \"\"; return loadHooks(); }, fail(\"hmsg\"))); });\n    });\n    loadSources(); loadSettings(); loadHooks();\n    // The two lists are drawn when they load: draw them again when the language changes.\n    var baseApplyLangRules = applyLang;\n    applyLang = function () { baseApplyLangRules(); whyNot(); loadSources().catch(function () {}); loadHooks().catch(function () {}); };\n  })();\n\n  // Sounds: the list comes from the Shard (GET sounds); this Shard plays them with one fixed paplay command. Used by the send form, the source and webhook\n  // forms and the Testing tab.\n  (function () {\n    var X = {\n      en: { test_tab: \"Try it\", tech_tab: \"System\", t_show: \"Try each way to show a message\", t_show_note: \"Each button sends a real test notification to the TV.\", t_sound: \"Sounds\", f_mvol: \"Sound volume (%)\", f_delay: \"The sound starts this long after the notification is sent (ms)\", f_delay_note: \"The banner appears a few seconds after the request. Press the button \\\"Send a notification with this sound\\\" below and move this slider until the sound and the banner arrive together.\", t_goodie: \"Goodie\", t_goodie_note: \"About 10 seconds of a well-known tune, played only with the notification sounds (you recognise it by the rhythm).\", t_stop: \"Stop\", f_sound: \"Sound\", f_vol: \"Volume (%)\", no_sound: \"No sound\",\n        t_send_sound: \"Send a notification with this sound\", t_pick: \"Tapping a sound plays it. Then press Send to try it in a notification.\", t_missing: \"This Shard cannot play sounds (the exec permission was not granted).\",\n        t_ready: \"Sound Shard found.\", t_sent: \"Sent\", t_none: \"Pick a sound first\" },\n      pt: { test_tab: \"Experimentar\", tech_tab: \"Sistema\", t_show: \"Experimente cada forma de mostrar uma mensagem\", t_show_note: \"Cada botão envia uma notificação de teste real para a TV.\", t_sound: \"Sons\", f_mvol: \"Volume do som (%)\", f_delay: \"O som começa este tempo depois de a notificação ser enviada (ms)\", f_delay_note: \"O banner aparece alguns segundos depois do pedido. Carregue no botão \\\"Enviar uma notificação com este som\\\" e mexa neste controlo até o som e o banner chegarem juntos.\", t_goodie: \"Surpresa\", t_goodie_note: \"Cerca de 10 segundos de uma música conhecida, tocada só com os sons de notificação (reconhece-se pelo ritmo).\", t_stop: \"Parar\", f_sound: \"Som\", f_vol: \"Volume (%)\", no_sound: \"Sem som\",\n        t_send_sound: \"Enviar uma notificação com este som\", t_pick: \"Escolha um som e carregue em Enviar. Tocar num som também o reproduz.\", t_missing: \"Este Shard não pode tocar sons (a permissão exec não foi concedida).\",\n        t_ready: \"Shard de som encontrado.\", t_sent: \"Enviado\", t_none: \"Escolha primeiro um som\" }\n    }, k, names = [], installed = null, chosen = \"\";\n    for (k in X.en) { T.en[k] = X.en[k]; }\n    for (k in X.pt) { T.pt[k] = X.pt[k]; }\n    function options(current) {\n      return '<option value=\"\">' + esc(tr(\"no_sound\")) + \"</option>\" + names.map(function (n) { return '<option value=\"' + esc(n) + '\"' + (n === current ? \" selected\" : \"\") + \">\" + esc(n) + \"</option>\"; }).join(\"\");\n    }\n    function paintSounds() {\n      [\"sound\", \"s_sound\", \"h_sound\"].forEach(function (id) { var cur = $(id).value; $(id).innerHTML = options(cur); });\n      $(\"tsounds\").innerHTML = names.map(function (n) { return '<button type=\"button\" class=\"ghost' + (n === chosen ? \" on\" : \"\") + '\" aria-pressed=\"' + (n === chosen) + '\" data-snd=\"' + esc(n) + '\">' + esc(n) + \"</button>\"; }).join(\"\");\n      paintOne();\n      $(\"tsoundnote\").textContent = installed === false ? tr(\"t_missing\") : (installed ? tr(\"t_pick\") : \"\");\n      $(\"tsoundnote\").className = \"msg\" + (installed === false ? \" err\" : \"\");\n      $(\"clist\").innerHTML = custom.map(function (n) { return '<button type=\"button\" class=\"ghost\" data-del=\"' + esc(n) + '\">' + \"\\u2715 \" + esc(n) + \"</button>\"; }).join(\"\");\n      var d2 = $(\"clist\").getElementsByTagName(\"button\"), k;\n      for (k = 0; k < d2.length; k++) {\n        d2[k].addEventListener(\"click\", function () {\n          var btn = this, nm = btn.getAttribute(\"data-del\");\n          confirmHere(btn, nm, function () { act(btn, api(\"sound-delete\", { name: nm }).then(function () { return loadSounds(); })); });\n        });\n      }\n      var b = $(\"tsounds\").getElementsByTagName(\"button\"), i;\n      for (i = 0; i < b.length; i++) {\n        b[i].addEventListener(\"click\", function () {\n          chosen = this.getAttribute(\"data-snd\"); paintSounds();\n          api(\"play\", { sound: chosen, volume: parseInt($(\"tvol\").value, 10) }).catch(function (e) { $(\"exmsg\").textContent = e.message; $(\"exmsg\").className = \"msg err\"; });\n        });\n      }\n    }\n    var songs = [], custom = [], one = \"\";\n    function paintOne() {\n      $(\"tone\").innerHTML = '<option value=\"\">' + esc(tr(\"one_none\")) + \"</option>\" + names.map(function (n) { return '<option value=\"' + esc(n) + '\">' + esc(n) + \"</option>\"; }).join(\"\");\n      $(\"tone\").value = one;\n    }\n    function failed(id) { return function (e) { $(id).textContent = e.message; $(id).className = \"msg err\"; }; }\n    $(\"tone\").addEventListener(\"change\", function () { one = this.value; api(\"settings\", { oneSound: one }).then(saved, failed(\"tsmsg\")); });\n    $(\"tbao\").addEventListener(\"change\", function () { api(\"settings\", { bannerAsOverlay: this.checked }).then(saved, failed(\"tnmsg\")); });\n    $(\"ttest\").addEventListener(\"click\", function () {\n      act(this, api(\"notify\", { title: tr(\"title\"), message: tr(\"ex_simple_m\"), mode: \"banner\", duration: 8, group: false })\n        .then(function () { $(\"tnmsg\").textContent = tr(\"sent_ok\"); $(\"tnmsg\").className = \"msg ok\"; }, function (e) { failed(\"tnmsg\")(e); throw e; }));\n    });\n    function paintSongs() {\n      $(\"tsongs\").innerHTML = songs.map(function (s) { return '<button type=\"button\" class=\"ghost\" data-song=\"' + esc(s.name) + '\">♪ ' + esc(s.title) + \"</button>\"; }).join(\"\");\n      var b = $(\"tsongs\").getElementsByTagName(\"button\"), i;\n      for (i = 0; i < b.length; i++) {\n        b[i].addEventListener(\"click\", function () {\n          var btn = this;\n          act(btn, api(\"play\", { song: btn.getAttribute(\"data-song\") }).then(function () { $(\"tsmsg\").textContent = \"\"; }, function (e) { $(\"tsmsg\").textContent = e.message; $(\"tsmsg\").className = \"msg err\"; throw e; }));\n        });\n      }\n    }\n    // The volume and the timing are Shard settings (POST settings). The two volume sliders (send form and Testing tab) show the same value.\n    function showVolume(v) { [\"mvol\", \"tmvol\"].forEach(function (id) { $(id).value = v; }); $(\"mvolv\").textContent = v + \"%\"; $(\"tmvolv\").textContent = v + \"%\"; }\n    function saved() { $(\"tsmsg\").textContent = tr(\"saved\"); $(\"tsmsg\").className = \"msg ok\"; }\n    function loadSounds() {\n      return api(\"sounds\").then(function (d) {\n        names = d.sounds; custom = d.custom || []; installed = d.available; songs = d.songs || [];\n        showVolume(d.volume); api(\"settings\").then(function (s) { overlayOp = s.settings.overlayOpacity; $(\"tbao\").checked = s.settings.bannerAsOverlay === true; one = s.settings.oneSound || \"\"; paintOne(); $(\"tovop\").value = overlayOp; $(\"tovopv\").textContent = overlayOp + \"%\"; showBar(s.settings); preview(); }).catch(function () { /* keep */ }); $(\"tdelay\").value = d.delayMs; $(\"tdelayv\").textContent = d.delayMs + \" ms\";\n        paintSounds(); paintSongs();\n      }).catch(function () { /* keep the lists empty */ });\n    }\n    $(\"tvol\").addEventListener(\"input\", function () { $(\"tvolv\").textContent = this.value + \"%\"; });\n    [\"mvol\", \"tmvol\"].forEach(function (id) {\n      $(id).addEventListener(\"input\", function () { showVolume(this.value); });\n      $(id).addEventListener(\"change\", function () { api(\"settings\", { soundVolume: parseInt(this.value, 10) }).then(function (r) { showVolume(r.settings.soundVolume); saved(); }).catch(function (e) { $(\"tsmsg\").textContent = e.message; $(\"tsmsg\").className = \"msg err\"; }); });\n    });\n    $(\"tovop\").addEventListener(\"input\", function () { overlayOp = parseInt(this.value, 10); $(\"tovopv\").textContent = this.value + \"%\"; preview(); });\n    $(\"tovop\").addEventListener(\"change\", function () { api(\"settings\", { overlayOpacity: parseInt(this.value, 10) }).then(saved).catch(function (e) { $(\"tsmsg\").textContent = e.message; $(\"tsmsg\").className = \"msg err\"; }); });\n    function showBar(s) {\n      var b = $(\"tovpos\").getElementsByTagName(\"button\"), i, on;\n      overlayPos = s.overlayPosition || \"bottom\"; $(\"tbim\").checked = s.bannerImageAsBar === true;\n      Array.prototype.forEach.call($(\"tdef\").getElementsByTagName(\"button\"), function (d) { var is = d.getAttribute(\"data-def\") === (s.defaultMode || \"banner\"); d.className = \"md\" + (is ? \" on\" : \"\"); d.setAttribute(\"aria-pressed\", is); });\n      $(\"tovmo\").checked = s.overlayMotion !== false; $(\"tovdur\").value = s.overlayDuration || 8; $(\"tovdurv\").textContent = $(\"tovdur\").value + \" s\";\n      for (i = 0; i < b.length; i++) { on = b[i].getAttribute(\"data-pos\") === overlayPos; b[i].className = \"md\" + (on ? \" on\" : \"\"); b[i].setAttribute(\"aria-pressed\", on); }\n    }\n    function saveBar(change) { api(\"settings\", change).then(function (r) { showBar(r.settings); preview(); $(\"tnmsg\").textContent = tr(\"saved\"); $(\"tnmsg\").className = \"msg ok\"; }, failed(\"tnmsg\")); }\n    Array.prototype.forEach.call($(\"tovpos\").getElementsByTagName(\"button\"), function (b) { b.addEventListener(\"click\", function () { saveBar({ overlayPosition: this.getAttribute(\"data-pos\") }); }); });\n    $(\"tovmo\").addEventListener(\"change\", function () { saveBar({ overlayMotion: this.checked }); });\n    $(\"tbim\").addEventListener(\"change\", function () { saveBar({ bannerImageAsBar: this.checked }); });\n    Array.prototype.forEach.call($(\"tdef\").getElementsByTagName(\"button\"), function (b) { b.addEventListener(\"click\", function () { saveBar({ defaultMode: this.getAttribute(\"data-def\") }); }); });\n    $(\"tovdur\").addEventListener(\"input\", function () { $(\"tovdurv\").textContent = this.value + \" s\"; });\n    $(\"tovdur\").addEventListener(\"change\", function () { saveBar({ overlayDuration: parseInt(this.value, 10) }); });\n    $(\"tdelay\").addEventListener(\"input\", function () { $(\"tdelayv\").textContent = this.value + \" ms\"; });\n    $(\"tdelay\").addEventListener(\"change\", function () { api(\"settings\", { soundDelayMs: parseInt(this.value, 10) }).then(saved).catch(function (e) { $(\"tsmsg\").textContent = e.message; $(\"tsmsg\").className = \"msg err\"; }); });\n    $(\"cup\").addEventListener(\"click\", function () {\n      var f = $(\"cfile\").files && $(\"cfile\").files[0], n = $(\"cname\").value.trim().toLowerCase();\n      if (!f || !/^[a-z0-9][a-z0-9-]{0,23}$/.test(n)) { $(\"tsmsg\").textContent = tr(\"t_cbad\"); $(\"tsmsg\").className = \"msg err\"; return; }\n      act(this, new Promise(function (ok, no) {\n        var r = new FileReader();\n        r.onload = function () {\n          fetch(\"sound-upload?name=\" + encodeURIComponent(n), { method: \"POST\", body: r.result })\n            .then(function (x) { return x.json().then(function (j) { if (!x.ok) { throw new Error(j.error || \"error \" + x.status); } return j; }); })\n            .then(function () { $(\"tsmsg\").textContent = tr(\"t_cok\"); $(\"tsmsg\").className = \"msg ok\"; $(\"cfile\").value = \"\"; return loadSounds(); })\n            .then(ok, function (e) { $(\"tsmsg\").textContent = e.message; $(\"tsmsg\").className = \"msg err\"; no(e); });\n        };\n        r.onerror = no;\n        r.readAsArrayBuffer(f);\n      }));\n    });\n    $(\"tsongstop\").addEventListener(\"click\", function () { act(this, api(\"play\", { song: \"stop\" })); });\n    $(\"tsend\").addEventListener(\"click\", function () {\n      if (!chosen) { $(\"tsmsg\").textContent = tr(\"t_none\"); $(\"tsmsg\").className = \"msg err\"; return; }\n      act(this, api(\"notify\", { title: \"Sound test\", message: \"Sound: \" + chosen, level: \"info\", mode: \"banner\", duration: 6, group: false, sound: chosen, volume: parseInt($(\"tvol\").value, 10) })\n        .then(function () { $(\"tsmsg\").textContent = tr(\"t_sent\"); $(\"tsmsg\").className = \"msg ok\"; }, function (e) { $(\"tsmsg\").textContent = e.message; $(\"tsmsg\").className = \"msg err\"; throw e; }));\n    });\n    var baseApplyLang = applyLang;\n    applyLang = function () { baseApplyLang(); paintSounds(); };\n    loadSounds();\n  })();\n\n  // Copy the setup to another TV: download one file here, load it there.\n  (function () {\n    T.en.th_field = \"Field\"; T.pt.th_field = \"Campo\"; T.en.th_type = \"Type\"; T.pt.th_type = \"Tipo\";\n    T.en.th_default = \"Default\"; T.pt.th_default = \"Por omiss\\u00E3o\"; T.en.th_meaning = \"Meaning\"; T.pt.th_meaning = \"Significado\";\n    T.pt.pick_title = \"Escolher um \\u00EDcone\"; T.pt.close = \"Fechar\"; T.pt.ph_auto = \"\\u00CDcone autom\\u00E1tico:\";\n    T.en.cp_title = \"Copy this setup to another TV\"; T.pt.cp_title = \"Copiar esta configura\\u00E7\\u00E3o para outra TV\";\n    T.en.cp_note = \"Get your settings, senders, webhooks and, if you want, your sounds as one text, then load it on another TV that has the Notification Center.\"; T.pt.cp_note = \"Obtenha as defini\\u00E7\\u00F5es, os emissores, os webhooks e, se quiser, os seus sons num texto, e carregue-o noutra TV que tenha o Centro de Notifica\\u00E7\\u00F5es.\";\n    T.en.cp_sounds = \"Include my sounds (the file gets bigger)\"; T.pt.cp_sounds = \"Incluir os meus sons (o ficheiro fica maior)\";\n    T.en.cp_keys = \"Include the keys of the senders (keep the file private)\"; T.pt.cp_keys = \"Incluir as chaves dos emissores (guarde o ficheiro em privado)\";\n    T.en.cp_save = \"Show the setup\"; T.pt.cp_save = \"Mostrar a configura\\u00E7\\u00E3o\";\n    T.en.cp_copy = \"Copy the text\"; T.pt.cp_copy = \"Copiar o texto\";\n    T.en.cp_copied = \"Copied. Save it as a .json file or paste it on the other TV.\"; T.pt.cp_copied = \"Copiado. Guarde num ficheiro .json ou cole na outra TV.\";\n    T.en.cp_manual = \"The text is selected: copy it with Ctrl+C or the Copy menu.\"; T.pt.cp_manual = \"O texto est\\u00E1 selecionado: copie com Ctrl+C ou pelo menu Copiar.\";\n    T.en.cp_first = \"Press Show the setup first.\"; T.pt.cp_first = \"Carregue primeiro em Mostrar a configura\\u00E7\\u00E3o.\";\n    T.en.cp_dl = \"To download it as a file, open this address in a new browser tab: \"; T.pt.cp_dl = \"Para descarregar como ficheiro, abra este endere\\u00E7o num novo separador do browser: \";\n    T.en.ph_cpin = \"...or paste the setup text here\"; T.pt.ph_cpin = \"...ou cole aqui o texto da configura\\u00E7\\u00E3o\";\n    T.en.cp_load = \"Load a setup file\"; T.pt.cp_load = \"Carregar um ficheiro de configura\\u00E7\\u00E3o\";\n    T.en.cp_up = \"Load it\"; T.pt.cp_up = \"Carregar\";\n    T.en.cp_none = \"Choose a setup file or paste the text first.\"; T.pt.cp_none = \"Escolha primeiro um ficheiro ou cole o texto.\";\n    T.en.cp_done = \"Loaded: {s} sources, {w} webhooks, {n} sounds.\"; T.pt.cp_done = \"Carregado: {s} emissores, {w} webhooks, {n} sons.\";\n    T.en.cp_skip = \" Not loaded: \"; T.pt.cp_skip = \" N\\u00E3o carregado: \";\n    function cpSay(text, kind) { $(\"cp_msg\").textContent = text; $(\"cp_msg\").className = \"msg \" + kind; }\n    $(\"cp_save\").addEventListener(\"click\", function () {\n      var url = \"export?sounds=\" + ($(\"cp_sounds\").checked ? \"1\" : \"0\") + \"&keys=\" + ($(\"cp_keys\").checked ? \"1\" : \"0\");\n      act(this, fetch(url).then(function (r) { if (!r.ok) { throw new Error(\"error \" + r.status); } return r.text(); }).then(function (text) {\n        $(\"cp_out\").value = text; $(\"cp_out\").style.display = \"block\"; cpSay(\"\", \"\");\n        $(\"cp_url\").textContent = tr(\"cp_dl\") + baseUrl() + \"/plugins/notification-center/api/\" + url;\n      }).catch(function (e) { cpSay(e.message, \"err\"); throw e; }));\n    });\n    $(\"cp_copy\").addEventListener(\"click\", function () {\n      var out = $(\"cp_out\"), done = false;\n      if (!out.value) { cpSay(tr(\"cp_first\"), \"err\"); return; }\n      out.focus(); out.select();\n      try { done = document.execCommand(\"copy\"); } catch (e) { done = false; }\n      cpSay(tr(done ? \"cp_copied\" : \"cp_manual\"), \"ok\");\n    });\n    function load(body) {\n      return fetch(\"import\", { method: \"POST\", body: body })\n        .then(function (x) { return x.json().then(function (j) { if (!x.ok) { throw new Error(j.error || \"error \" + x.status); } return j; }); })\n        .then(function (j) {\n          var i = j.imported;\n          cpSay(tr(\"cp_done\").replace(\"{s}\", i.sources).replace(\"{w}\", i.webhooks).replace(\"{n}\", i.sounds) + (j.skipped.length ? tr(\"cp_skip\") + j.skipped.join(\", \") : \"\"), j.skipped.length ? \"err\" : \"ok\");\n          $(\"cp_file\").value = \"\"; $(\"cp_in\").value = \"\";\n          setTimeout(function () { location.reload(); }, j.skipped.length ? 6000 : 1800);\n        }).catch(function (e) { cpSay(e.message, \"err\"); throw e; });\n    }\n    $(\"cp_up\").addEventListener(\"click\", function () {\n      var f = $(\"cp_file\").files && $(\"cp_file\").files[0], pasted = $(\"cp_in\").value.trim();\n      if (!f && !pasted) { cpSay(tr(\"cp_none\"), \"err\"); return; }\n      act(this, pasted ? load(pasted) : new Promise(function (ok, no) {\n        var r = new FileReader();\n        r.onload = function () { load(r.result).then(ok, no); };\n        r.onerror = no;\n        r.readAsArrayBuffer(f);\n      }));\n    });\n  })();\n\n  [[\"set_notif\", \"Notification\", \"Aviso\"], [\"q_title\", \"Quiet hours\", \"Horas de sil\\u00EAncio\"], [\"q_on\", \"Hold notifications in these hours\", \"Reter avisos nestas horas\"], [\"cp_title\", \"Backup\", \"C\\u00F3pia\"],\n    [\"m_glass\", \"Glass bar\", \"Barra de vidro\"], [\"m_panel\", \"Panel\", \"Painel\"], [\"f_def\", \"Look when the sender names none\", \"Aspeto quando o emissor n\\u00E3o o indica\"], [\"tbim\", \"Show a banner with a picture as a bar\", \"Mostrar como barra um banner com imagem\"],\n    [\"mh_glass\", \"The bar in glass style, sliding in and out over the picture.\", \"A barra em estilo de vidro, que entra e sai por cima da imagem.\"], [\"mh_panel\", \"A dark panel almost the size of the screen, with large logos, without leaving what you are watching. No buttons.\", \"Um painel escuro quase do tamanho do ecr\\u00E3, com log\\u00F3tipos grandes, sem sair do que est\\u00E1 a ver. Sem bot\\u00F5es.\"],\n    [\"tbao\", \"Show banners as a toast bar\", \"Mostrar os banners como barra\"], [\"b_test\", \"Test\", \"Testar\"], [\"f_one\", \"One sound for everything\", \"Um som para tudo\"], [\"one_none\", \"Each keeps its own\", \"Cada um fica com o seu\"],\n    [\"r_title\", \"Repeats and unknown senders\", \"Repeti\\u00E7\\u00F5es e emissores desconhecidos\"], [\"b_reset\", \"Reset settings\", \"Repor defini\\u00E7\\u00F5es\"], [\"reset_done\", \"Settings reset\", \"Defini\\u00E7\\u00F5es repostas\"],\n    [\"q_reset\", \"Reset all settings to their defaults? Senders, webhooks, sounds and wallpapers are kept.\", \"Repor todas as defini\\u00E7\\u00F5es? Os emissores, webhooks, sons e wallpapers ficam.\"]\n    , [\"f_ovpos\", \"Where the bar appears\", \"Onde aparece a barra\"], [\"pos_bottom\", \"Bottom\", \"Em baixo\"], [\"pos_top\", \"Top\", \"Em cima\"], [\"f_ovmo\", \"Animate the bar\", \"Animar a barra\"], [\"f_ovdur\", \"Bar duration when the sender gives none (s)\", \"Dura\\u00E7\\u00E3o da barra quando o emissor n\\u00E3o a indica (s)\"]\n  ].forEach(function (w) { T.en[w[0]] = w[1]; T.pt[w[0]] = w[2]; });\n  [[\"al_title\", \"What this sender may decide\", \"O que este emissor pode decidir\"], [\"s_asound\", \"Choose the sound\", \"Escolher o som\"], [\"s_amode\", \"Choose how it appears\", \"Escolher como aparece\"],\n    [\"s_aurgent\", \"Send urgent ones (they pass quiet hours)\", \"Enviar urgentes (passam o sil\\u00EAncio)\"], [\"cat_title\", \"Categories\", \"Categorias\"], [\"no_cat\", \"No categories yet: they appear when the sender uses them.\", \"Ainda sem categorias: aparecem quando o emissor as usar.\"],\n    [\"use_src\", \"As the sender\", \"Como o emissor\"], [\"s_add\", \"Add a sender\", \"Acrescentar emissor\"], [\"ed_title\", \"Sender\", \"Emissor\"], [\"sn_title\", \"Senders\", \"Emissores\"], [\"t_new\", \"New\", \"Novo\"], [\"t_now\", \"now\", \"agora\"],\n    [\"src_title\", \"Senders\", \"Emissores\"], [\"no_src\", \"No Shard has sent anything yet.\", \"Ainda nenhum Shard enviou avisos.\"], [\"n_failed\", \"not delivered\", \"n\\u00E3o entregues\"], [\"f_all\", \"All\", \"Todos\"], [\"f_failed\", \"Failed\", \"Falhados\"],\n    [\"q_all\", \"They apply to every Shard. A sender allowed to send urgent ones passes them.\", \"Valem para todos os Shards. Um emissor autorizado a enviar urgentes passa-as.\"], [\"q_senders\", \"Senders and rules\", \"Emissores e regras\"],\n    [\"o_queued\", \"Queued\", \"Em fila\"], [\"o_shown\", \"Shown\", \"Mostrado\"], [\"o_merged\", \"Merged\", \"Juntado\"], [\"o_suppressed\", \"Silenced\", \"Silenciado\"], [\"o_replaced\", \"Replaced\", \"Substitu\\u00EDdo\"], [\"o_expired\", \"Expired\", \"Expirado\"], [\"o_failed\", \"Failed\", \"Falhou\"], [\"o_rejected\", \"Refused\", \"Recusado\"], [\"o_dropped\", \"Dropped\", \"Descartado\"]\n  ].forEach(function (w) { T.en[w[0]] = w[1]; T.pt[w[0]] = w[2]; });\n  [[\"why_sound\", \"Sound: what this sender asks for, volume included, is ignored. The TV plays: {x}.\", \"Som: o que este emissor pedir, volume inclu\\u00EDdo, \\u00E9 ignorado. A TV toca: {x}.\"], [\"why_nosound\", \"no sound\", \"nenhum som\"],\n    [\"why_mode\", \"Look: what this sender asks for is ignored. It appears as: {x}.\", \"Aspeto: o que este emissor pedir \\u00E9 ignorado. Aparece como: {x}.\"], [\"why_cats\", \"A category with its own choice keeps it.\", \"Uma categoria com escolha pr\\u00F3pria mant\\u00E9m-na.\"],\n    [\"why_urgent\", \"Urgency: its urgent notifications count as normal. They wait their turn and quiet hours hold them.\", \"Urg\\u00EAncia: os avisos urgentes deste emissor contam como normais. Esperam a vez e o sil\\u00EAncio ret\\u00E9m-nos.\"],\n    [\"why_high\", \"Urgency: what this sender asks for is ignored, but all its notifications are urgent because of the choice above.\", \"Urg\\u00EAncia: o que este emissor pedir \\u00E9 ignorado, mas todos os avisos dele s\\u00E3o urgentes pela escolha acima.\"],\n    [\"ex_civil\", \"Civil protection\", \"Prote\\u00E7\\u00E3o Civil\"], [\"ex_civil_d\", \"Urgent red warning on the full screen\", \"Aviso vermelho urgente em ecr\\u00E3 inteiro\"], [\"ex_civil_t\", \"Civil protection: red warning\", \"Prote\\u00E7\\u00E3o Civil: aviso vermelho\"], [\"ex_civil_m\", \"Heavy rain and wind until 18:00. Avoid travelling.\", \"Chuva e vento fortes at\\u00E9 \\u00E0s 18:00. Evite deslocar-se.\"],\n    [\"ex_weather\", \"Weather\", \"Tempo\"], [\"ex_weather_d\", \"Toast bar with a soft sound\", \"Barra em baixo com um som suave\"], [\"ex_weather_t\", \"Rain this afternoon\", \"Chuva \\u00E0 tarde\"], [\"ex_weather_m\", \"14 \\u00B0C, take an umbrella.\", \"14 \\u00B0C, leve guarda-chuva.\"],\n    [\"ex_reminder\", \"Reminder\", \"Lembrete\"], [\"ex_reminder_d\", \"The standard TV notification, with a chime\", \"A notifica\\u00E7\\u00E3o normal da TV, com um toque\"], [\"ex_reminder_t\", \"Starting soon\", \"Quase a come\\u00E7ar\"], [\"ex_reminder_m\", \"The evening news starts in 5 minutes.\", \"O telejornal come\\u00E7a daqui a 5 minutos.\"]\n  ].forEach(function (w) { T.en[w[0]] = w[1]; T.pt[w[0]] = w[2]; });\n  applyLang();\n  loadStatus(); loadApi();\n  api(\"lang\").then(function (d) { if (T[d.lang] && d.lang !== lang) { lang = d.lang; applyLang(); } }).catch(function () { /* keep English */ });\n})();\n</script>\n</body>\n</html>\n","wallpapers/news.svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1920 1080\" preserveAspectRatio=\"xMidYMid slice\">\n  <defs>\n    <linearGradient id=\"bg\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#08102c\"/><stop offset=\"1\" stop-color=\"#14306a\"/></linearGradient>\n    <pattern id=\"diag\" width=\"28\" height=\"28\" patternUnits=\"userSpaceOnUse\" patternTransform=\"rotate(45)\"><rect width=\"2\" height=\"28\" fill=\"#6f95e6\" fill-opacity=\"0.10\"/></pattern>\n    <radialGradient id=\"vig\" cx=\"35%\" cy=\"35%\" r=\"85%\"><stop offset=\"0.3\" stop-color=\"#000\" stop-opacity=\"0\"/><stop offset=\"1\" stop-color=\"#030818\" stop-opacity=\"0.85\"/></radialGradient>\n  </defs>\n  <rect width=\"1920\" height=\"1080\" fill=\"url(#bg)\"/><rect width=\"1920\" height=\"1080\" fill=\"url(#diag)\"/><rect width=\"1920\" height=\"1080\" fill=\"url(#vig)\"/>\n  <rect x=\"0\" y=\"864\" width=\"1190\" height=\"20\" fill=\"#dc323c\"/><rect x=\"0\" y=\"894\" width=\"1380\" height=\"8\" fill=\"#d2e1ff\" fill-opacity=\"0.65\"/>\n</svg>\n","wallpapers/sport.svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1920 1080\" preserveAspectRatio=\"xMidYMid slice\">\n  <defs>\n    <pattern id=\"stripes\" width=\"320\" height=\"1080\" patternUnits=\"userSpaceOnUse\">\n      <rect width=\"160\" height=\"1080\" fill=\"#0e4a2a\"/><rect x=\"160\" width=\"160\" height=\"1080\" fill=\"#0a3d22\"/>\n    </pattern>\n    <radialGradient id=\"vig\" cx=\"50%\" cy=\"45%\" r=\"75%\"><stop offset=\"0.35\" stop-color=\"#000\" stop-opacity=\"0\"/><stop offset=\"1\" stop-color=\"#02100a\" stop-opacity=\"0.92\"/></radialGradient>\n    <radialGradient id=\"light\" cx=\"50%\" cy=\"0%\" r=\"55%\"><stop offset=\"0\" stop-color=\"#e6fbe9\" stop-opacity=\"0.38\"/><stop offset=\"1\" stop-color=\"#e6fbe9\" stop-opacity=\"0\"/></radialGradient>\n  </defs>\n  <rect width=\"1920\" height=\"1080\" fill=\"url(#stripes)\"/>\n  <g fill=\"none\" stroke=\"#e8f5ec\" stroke-opacity=\"0.5\" stroke-width=\"5\">\n    <rect x=\"80\" y=\"80\" width=\"1760\" height=\"920\"/><line x1=\"960\" y1=\"80\" x2=\"960\" y2=\"1000\"/>\n    <circle cx=\"960\" cy=\"540\" r=\"180\"/><rect x=\"80\" y=\"320\" width=\"300\" height=\"440\"/><rect x=\"1540\" y=\"320\" width=\"300\" height=\"440\"/>\n  </g>\n  <rect width=\"1920\" height=\"1080\" fill=\"url(#light)\"/><rect width=\"1920\" height=\"1080\" fill=\"url(#vig)\"/>\n</svg>\n"}}
