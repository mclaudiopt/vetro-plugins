 < 60 ? m + \" min\" : m < 1440 ? Math.round(m / 60) + \" h\" : Math.round(m / 1440) + \" d\"; }\n    function opts(list, cur, none) { return '<option value=\"\">' + esc(none) + \"</option>\" + list.map(function (v) { return '<option value=\"' + esc(v) + '\"' + (v === cur ? \" selected\" : \"\") + \">\" + esc(v) + \"</option>\"; }).join(\"\"); }\n    // Defaults per category, one folded block each; empty = those of the sender.\n    function paintCats(names, saved) {\n      var sounds = Array.prototype.map.call($(\"s_sound\").options, function (o) { return o.value; }).filter(Boolean);\n      $(\"s_cats\").innerHTML = names.length ? names.map(function (c) {\n        var v = own.call(saved, c) ? saved[c] : {};\n        return '<details class=\"help\" data-cat=\"' + esc(c) + '\"><summary>' + esc(c) + '</summary><div class=\"rulesgrid\">' +\n          '<label class=\"lab\">' + esc(tr(\"f_mode\")) + '<select data-f=\"mode\">' + opts([\"banner\", \"full\", \"both\", \"overlay\", \"glass\", \"panel\"], v.mode, tr(\"use_src\")) + \"</select></label>\" +\n          '<label class=\"lab\">' + esc(tr(\"f_sound\")) + '<select data-f=\"sound\">' + opts(sounds, v.sound, tr(\"use_src\")) + \"</select></label>\" +\n          '<label class=\"lab\">' + esc(tr(\"f_vol\")) + '<input type=\"text\" inputmode=\"numeric\" data-f=\"volume\" maxlength=\"3\" value=\"' + esc(v.volume || \"\") + '\"></label>' +\n          '<label class=\"lab\">' + esc(tr(\"f_dur\")) + '<input type=\"text\" inputmode=\"numeric\" data-f=\"duration\" maxlength=\"2\" value=\"' + esc(v.duration || \"\") + '\"></label></div></details>';\n      }).join(\"\") : '<div class=\"msg\">' + esc(tr(\"no_cat\")) + \"</div>\";\n    }\n    function readCats() {\n      var out = {};\n      Array.prototype.forEach.call($(\"s_cats\").querySelectorAll(\"[data-cat]\"), function (box) {\n        var o = {};\n        Array.prototype.forEach.call(box.querySelectorAll(\"[data-f]\"), function (el) { var f = el.getAttribute(\"data-f\"); if (el.value) { o[f] = f === \"volume\" || f === \"duration\" ? parseInt(el.value, 10) || 0 : el.value; } });\n        out[box.getAttribute(\"data-cat\")] = o;\n      });\n      return out;\n    }\n    function edit(n) {\n      var p = own.call(SRC, n) ? SRC[n] : {}, cats = (own.call(SEEN, n) ? SEEN[n].categories : []).slice();\n      Object.keys(p.categories || {}).forEach(function (c) { if (cats.indexOf(c) < 0) { cats.push(c); } });\n      $(\"s_name\").value = n; $(\"s_icon\").value = p.icon || \"\"; $(\"s_level\").value = p.level || \"\"; $(\"s_mode\").value = p.mode || \"\"; $(\"s_theme\").value = p.theme || \"\"; $(\"s_priority\").value = p.priority || \"\";\n      $(\"s_dur\").value = p.duration || \"\"; $(\"s_rate\").value = p.rate || \"\"; $(\"s_sound\").value = p.sound || \"\"; $(\"s_vol\").value = p.volume || \"\"; $(\"s_on\").checked = p.enabled !== false; $(\"srckey\").hidden = true;\n      $(\"s_asound\").checked = p.allowSound !== false; $(\"s_amode\").checked = p.allowMode !== false; $(\"s_aurgent\").checked = p.allowUrgent !== false;\n      paintCats(cats, p.categories || {});\n      whyNot();\n    }\n    // A control that is not allowed stays visible: this says what the TV does instead.\n    function whyNot() {\n      var out = [], m = $(\"s_mode\").value, snd = $(\"s_sound\").value;\n      function cats(f) { return Array.prototype.some.call($(\"s_cats\").querySelectorAll('[data-f=\"' + f + '\"]'), function (el) { return !!el.value; }) ? \" \" + tr(\"why_cats\") : \"\"; }\n      if (!$(\"s_asound\").checked) { out.push(tr(\"why_sound\").replace(\"{x}\", snd || tr(\"why_nosound\")) + cats(\"sound\")); }\n      if (!$(\"s_amode\").checked) { out.push(tr(\"why_mode\").replace(\"{x}\", tr(\"m_\" + (m || \"banner\"))) + cats(\"mode\")); }\n      if (!$(\"s_aurgent\").checked) { out.push(tr($(\"s_priority\").value === \"high\" ? \"why_high\" : \"why_urgent\")); }\n      $(\"s_why\").textContent = out.join(\"\\n\");\n    }\n    [\"s_asound\", \"s_amode\", \"s_aurgent\", \"s_sound\", \"s_mode\", \"s_priority\", \"s_cats\"].forEach(function (id) { $(id).addEventListener(\"change\", whyNot); });\n    function loadSources() {\n      return api(\"profiles\").then(function (d) {\n        SRC = d.profiles; SEEN = d.seen || {};\n        var names = Object.keys(SRC).concat(Object.keys(SEEN).filter(function (n) { return !own.call(SRC, n); }));\n        $(\"srclist\").innerHTML = names.length ? names.map(function (n) {\n          var p = own.call(SRC, n) ? SRC[n] : null, q = own.call(SEEN, n) ? SEEN[n] : { categories: [], at: 0 };\n          var tag = !p ? (q.opened ? \"\" : '<span class=\"chip y\">' + esc(tr(\"t_new\")) + \"</span>\") : p.enabled ? \"\" : '<span class=\"chip r\">' + esc(tr(\"off\")) + \"</span>\";\n          return '<li><button type=\"button\" class=\"rl\" aria-pressed=\"false\" data-n=\"' + esc(n) + '\"><b>' + esc(n) + \"</b>\" + tag + \"<small>\" + esc([q.categories.join(\", \"), ago(q.at), p && p.hasKey ? tr(\"haskey\") : \"\"].filter(Boolean).join(\" \\u00B7 \")) + \"</small></button></li>\";\n        }).join(\"\") : '<li class=\"empty\">' + esc(tr(\"no_src\")) + \"</li>\";\n        $(\"seenlist\").innerHTML = Object.keys(SEEN).length ? Object.keys(SEEN).map(function (n) { return \"<li><b>\" + esc(n) + \"</b> <small>\" + esc(ago(SEEN[n].at)) + \"</small></li>\"; }).join(\"\") : '<li class=\"empty\">' + esc(tr(\"no_src\")) + \"</li>\";\n        Array.prototype.forEach.call($(\"srclist\").getElementsByClassName(\"rl\"), function (el) { el.addEventListener(\"click\", function () { var n = this.getAttribute(\"data-n\"); pick(this); edit(n); opened(this, n); }); });\n      }).catch(function (e) { note(\"srcmsg\", e.message, \"err\"); });\n    }\n    function opened(btn, n) {\n      var chip = btn.querySelector(\".chip.y\");\n      if (!chip) { return; }\n      btn.removeChild(chip);\n      if (own.call(SEEN, n)) { SEEN[n].opened = true; }\n      api(\"profiles\", { source: n, opened: true }).catch(function () { /*